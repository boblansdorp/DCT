{
 "cells": [
  {
   "kind": 1,
   "value": "# DCT Test Suite\nRun cells top-to-bottom. Each section loads and runs one test script.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Reload all packages fresh *)\r\nQuiet[Remove[\"DCTDataImport`*\", \"NNLSFit`*\", \"DCTKernel`*\", \"DCT`*\",\r\n             \"DCTPlots`*\", \"DCTPeakAnalysis`*\", \"DCTSensitivity`*\",\r\n             \"DCTAdmittanceStats`*\", \"DCTKKCheck`*\", \"DCTBiophysics`*\"]];\r\n$ContextPath = Select[$ContextPath, !StringMatchQ[#, \"DCT*\" | \"NNLSFit*\"] &];\r\ndctRoot = NotebookDirectory[];   (* repository root: the folder this notebook is in *)\r\nGet[FileNameJoin[{dctRoot, \"DCT.wl\"}]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"64\" data-latex-b64=\"XHRleHRjb2xvcnsjMDBmZjAwfXtcdGV4dHvinJQgRENUIHBhY2thZ2UgbG9hZGVkLn19\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\" style=\"color:#00ff00;\"><span class=\"mord\" style=\"color:#00ff00;\">✔ DCT package loaded.</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
