       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq9afc9l-snbqayo\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dHszLXN0YXRlIG1vZGVsfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">3-state model</span></span></span></span></span></span></div></div></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq9afc9q-7m9zmsq\" data-page-width-em=\"52\" data-latex-b64=\"XHRleHR7ICB9XHRleHR7S31fe1x0ZXh0e1N9fVx0ZXh0eyA9IH1cdGV4dHswLjIwN31cdGV4dHsgICAgIH1cdGV4dHtLfV97XHRleHR7RH19XHRleHR7ID0gfVx0ZXh0ezUyLjR9XHRleHR7ICRcbXUkTX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">S</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.207</span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">D</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">52.4</span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq9afc9s-eziimg6\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dHs0LXN0YXRlIG1vZGVsfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">4-state model</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq9afc9u-3puo9t9\" data-page-width-em=\"52\" data-latex-b64=\"XHRleHR7ICB9XHRleHR7S31fe1x0ZXh0e1N9fVx0ZXh0eyA9IH1cdGV4dHswLjE0N31cdGV4dHsgICAgIH1cdGV4dHtLfV97XHRleHR7RH19XHRleHR7ID0gfVx0ZXh0ezguM31cdGV4dHsgJFxtdSRNfVx0ZXh0eyAgICAgTkYgPSB9XHRleHR7MC4zMn0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">S</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.147</span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">D</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">8.3</span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M</span></span><span class=\"mord text\"><span class=\"mord\"> NF = </span></span><span class=\"mord text\"><span class=\"mord\">0.32</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula][formula][formula][formula]",
       "mime": "text/plain"
      }
     ],
     "id": "556b6592-0e07-4527-bd54-90eda635e1c8"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"821465\" data-output-id=\"117\" data-out-n=\"697\" data-sub-idx=\"12\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"69\" data-sub-start=\"26\" data-sub-end=\"69\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[697]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_6ids13r8e4ok.svg\" src=\"img/EAB_DCT_analysis/wl_6ids13r8e4ok.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Biophysical model fits using the mechanistic 3-state and 4-state kinetic models.\n   Data: {conc \\[Mu]M, ff} across all electrodes, positive concentrations only. *)\n\n(* --- model equations --- *)\nPrint[Style[\"3-state model  (U \\[LeftRightArrow] F \\[LeftRightArrow] B)\", Bold, 13]];\nPrint[Row[{\"  \", Subscript[\"f\",\"f\"], \" = \", DCTBiophysics`$FF3State}]];\nPrint[Style[\"4-state model  (U \\[LeftRightArrow] F \\[LeftRightArrow] B,  NF non-folding)\", Bold, 13]];\nPrint[Row[{\"  \", Subscript[\"f\",\"f\"], \" = \", DCTBiophysics`$FF4State}]];\nPrint[\"\"];\n\nallPts = Flatten[ffPos, 1];   (* all electrodes, conc > 0 *)\n\nfitResult = DCTBiophysics`FitFoldedFraction[allPts];\n\n(* --- fit parameters --- *)\nModule[{p3 = fitResult[\"Model3\"], p4 = fitResult[\"Model4\"]},\n  Print[Style[\"3-state model\", Bold, 13]];\n  Print[Row[{\"  \", Subscript[\"K\",\"S\"], \" = \", NumberForm[p3[\"KS\"], {4,3}],\n             \"     \", Subscript[\"K\",\"D\"], \" = \", NumberForm[p3[\"KD\"], {6,1}], \" \\[Mu]M\"}]];\n  Print[Style[\"4-state model\", Bold, 13]];\n  Print[Row[{\"  \", Subscript[\"K\",\"S\"], \" = \", NumberForm[p4[\"KS\"], {4,3}],\n             \"     \", Subscript[\"K\",\"D\"], \" = \", NumberForm[p4[\"KD\"], {6,1}], \" \\[Mu]M\",\n             \"     NF = \", NumberForm[p4[\"NF\"], {3,2}]}]]\n];\n\n(* --- plot --- *)\nModule[{ks3, kd3, ks4, kd4, nf4, m3, m4, tMin, tMax, c3pts, c4pts,\n        darkBg, fgStyle, eCols, modelStyles},\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  tMin = Log10[Min[allPts[[All,1]]] * 0.4];\n  tMax = Log10[Max[allPts[[All,1]]] * 3.];\n  c3pts = Table[{10^t, N[m3 /. DCTBiophysics`conc -> 10^t]}, {t, tMin, tMax, (tMax-tMin)/200}];\n  c4pts = Table[{10^t, N[m4 /. DCTBiophysics`conc -> 10^t]}, {t, tMin, tMax, (tMax-tMin)/200}];\n\n  darkBg     = GrayLevel[0.12];\n  fgStyle    = Directive[White, AbsoluteThickness[1.1]];\n  eCols      = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ Range[Length[concElectrodes]];\n  modelStyles = {Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]], Directive[White, AbsoluteThickness[2.]]};\n\n  ListLinePlot[\n    Join[ffPos, {c3pts, c4pts}],\n    ScalingFunctions -> {\"Log10\", None},\n    (* data series = points only; the two model curves stay joined as lines *)\n    Joined -> Join[ConstantArray[False, Length[concElectrodes]], {True, True}],\n    PlotMarkers -> Join[ConstantArray[{Automatic, 10}, Length[concElectrodes]], {None, None}],\n    PlotStyle -> Join[eCols, modelStyles],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., White], None}, {DCTPlots`ThemeLogTicks[0.8, cHi, White], None}},\n    FrameTicksStyle -> Directive[White, 12],\n    Frame -> True, Axes -> False, Background -> darkBg, FrameStyle -> fgStyle,\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, White], Style[\"Fraction folded\", 14, White]},\n    PlotRange -> {{0.8, cHi}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, concElectrodes,\n      LabelStyle -> Directive[White, 12], Background -> darkBg,\n      LegendFunction -> (Framed[#, Background->darkBg, FrameStyle->fgStyle]&)], Right],\n    Epilog -> {\n      {Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", GrayLevel[0.65], 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.91}]],\n      {Directive[White, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", White, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.83}]]\n    }\n  ]\n]",
       "mime": "text/plain"
      }
     ],
     "id": "e5a2e291-d700-40bf-9dad-5f5d92a190df"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5a.2 Linear-linear plot",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Linear-linear plot \\[Dash] includes 0 \\[Mu]M data the log-x plot can't show.\n   Defined as a function so Section 6 can re-render it white in the Publication\n   block (it reads DCTPlots`$DCTTheme at call time; dark on screen otherwise). *)\nbiophysLinearPlot[] := Module[\n  {pub, fg, bg, ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts, eCols, modelStyles},\n  pub = (DCTPlots`$DCTTheme === \"Publication\");\n  fg  = If[pub, Black, White];\n  bg  = If[pub, White, GrayLevel[0.12]];\n\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  eCols       = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ Range[Length[concElectrodes]];\n  modelStyles = {Directive[Gray, Dashed, AbsoluteThickness[2.]], Directive[fg, AbsoluteThickness[2.]]};\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    (* data series = points only; the two model curves stay joined as lines *)\n    Joined -> Join[ConstantArray[False, Length[concElectrodes]], {True, True}],\n    PlotMarkers -> Join[ConstantArray[{Automatic, 10}, Length[concElectrodes]], {None, None}],\n    PlotStyle -> Join[eCols, modelStyles],\n    PlotTheme -> \"Default\",\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., fg], None}, {DCTPlots`ThemeLinTicks[0., cMax * 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 12],\n    Frame -> True, Axes -> False, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Fraction folded\", 14, fg]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, concElectrodes,\n      LabelStyle -> Directive[fg, 12], Background -> bg,\n      LegendFunction -> (Framed[#, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]]] &)], Right],\n    Epilog -> {\n      {Directive[Gray, Dashed, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", Gray, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.91}]],\n      {Directive[fg, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", fg, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.83}]]\n    }\n  ]\n];\n\nbiophysLinearPlot[]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"821465\" data-output-id=\"118\" data-out-n=\"699\" data-sub-idx=\"2\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"71\" data-sub-start=\"50\" data-sub-end=\"50\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[699]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_14artotq3tv35.svg\" src=\"img/EAB_DCT_analysis/wl_14artotq3tv35.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Linear-linear plot \\[Dash] includes 0 \\[Mu]M data the log-x plot can't show.\n   Defined as a function so Section 6 can re-render it white in the Publication\n   block (it reads DCTPlots`$DCTTheme at call time; dark on screen otherwise). *)\nbiophysLinearPlot[] := Module[\n  {pub, fg, bg, ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts, eCols, modelStyles},\n  pub = (DCTPlots`$DCTTheme === \"Publication\");\n  fg  = If[pub, Black, White];\n  bg  = If[pub, White, GrayLevel[0.12]];\n\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  eCols       = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ Range[Length[concElectrodes]];\n  modelStyles = {Directive[Gray, Dashed, AbsoluteThickness[2.]], Directive[fg, AbsoluteThickness[2.]]};\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    (* data series = points only; the two model curves stay joined as lines *)\n    Joined -> Join[ConstantArray[False, Length[concElectrodes]], {True, True}],\n    PlotMarkers -> Join[ConstantArray[{Automatic, 10}, Length[concElectrodes]], {None, None}],\n    PlotStyle -> Join[eCols, modelStyles],\n    PlotTheme -> \"Default\",\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., fg], None}, {DCTPlots`ThemeLinTicks[0., cMax * 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 12],\n    Frame -> True, Axes -> False, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Fraction folded\", 14, fg]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, concElectrodes,\n      LabelStyle -> Directive[fg, 12], Background -> bg,\n      LegendFunction -> (Framed[#, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]]] &)], Right],\n    Epilog -> {\n      {Directive[Gray, Dashed, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", Gray, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.91}]],\n      {Directive[fg, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", fg, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.83}]]\n    }\n  ]\n];\n\nbiophysLinearPlot[]",
       "mime": "text/plain"
      }
     ],
     "id": "e689b8f3-0827-4114-b7d7-9a9652f82aec"
    }
   ],
   "metadata": {}
