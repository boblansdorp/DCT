       "data": "Print: spike:[formula] files  (electrodes +[formula])2026-02-25-titration:[formula] files  (electrodes +[formula])",
       "mime": "text/plain"
      }
     ],
     "id": "74fb4f52-5996-4b87-84c4-61aa59219e74"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqwpjwxc-9dncx5z\" data-page-width-em=\"35\" data-latex-b64=\"XG1hdGhiZntcdGV4dGNvbG9yeyMwMGZmMDB9e1x0ZXh0ezM5IC8gMzkgZml0cyBzdWNjZWVkZWQg4oCTIGVsZWN0cm9kZXMgRTEsIEUyLCBFMywgRTQsIEU1LCBFNi59fX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord text\" style=\"color:#00ff00;\"><span class=\"mord\" style=\"color:#00ff00;\">39 / 39 fits succeeded – electrodes E1, E2, E3, E4, E5, E6.</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
