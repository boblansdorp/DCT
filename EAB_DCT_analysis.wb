     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzrfym4-1f4izsm\" data-page-width-em=\"65\" data-latex-b64=\"XG1hdGhiZntcdGV4dHszLXN0YXRlIG1vZGVsfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">3-state model</span></span></span></span></span></span></div></div></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzrfymq-r4bohq5\" data-page-width-em=\"65\" data-latex-b64=\"XHRleHR7ICB9XHRleHR7S31fe1x0ZXh0e1N9fVx0ZXh0eyA9IH1cdGV4dHswLjE0NX1cdGV4dHsgICAgIH1cdGV4dHtLfV97XHRleHR7RH19XHRleHR7ID0gfVx0ZXh0ezMzLjJ9XHRleHR7ICRcbXUkTX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">S</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.145</span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">D</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">33.2</span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzrfyms-z2nfszt\" data-page-width-em=\"65\" data-latex-b64=\"XG1hdGhiZntcdGV4dHs0LXN0YXRlIG1vZGVsfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">4-state model</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzrfymu-pvfm03h\" data-page-width-em=\"65\" data-latex-b64=\"XHRleHR7ICB9XHRleHR7S31fe1x0ZXh0e1N9fVx0ZXh0eyA9IH1cdGV4dHswLjE1MH1cdGV4dHsgICAgIH1cdGV4dHtLfV97XHRleHR7RH19XHRleHR7ID0gfVx0ZXh0ezguNX1cdGV4dHsgJFxtdSRNfVx0ZXh0eyAgICAgTkYgPSB9XHRleHR7MC4zMn0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">S</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.150</span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">D</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">8.5</span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M</span></span><span class=\"mord text\"><span class=\"mord\"> NF = </span></span><span class=\"mord text\"><span class=\"mord\">0.32</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
