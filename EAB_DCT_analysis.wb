  {
   "kind": 1,
   "value": "## 6. Export\nExports key figures as PDFs to a `figures/` folder next to `dataDir`.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 6.1 Export figures",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "exportFigure = True; (* set to True to export all figures as PDF + PNG *)\n\nIf[exportFigure,\n  figDir = FileNameJoin[{DirectoryName[dataDir], \"figures\"}];\n  If[!DirectoryQ[figDir], CreateDirectory[figDir]];\n  Print[\"Saving to: \", figDir];\n\n  (* PDF = vector (for LaTeX / print); PNG = 300 dpi raster (paste into Google\n     Docs / Slides \\[Dash] those don't accept PDF or SVG natively). *)\n  exportFig[fig_, name_] := (\n    Export[FileNameJoin[{figDir, name <> \".pdf\"}], fig];\n    Export[FileNameJoin[{figDir, name <> \".png\"}], fig, ImageResolution -> 300];\n    Print[\"\\[Checkmark] \", name]\n  );\n\n  (* Figures in notebook order, Publication theme (white). *)\n  Block[{DCTPlots`$DCTTheme = \"Publication\"},\n\n    (* Method validation \\[Dash] synthetic recovery: figure + parameter table *)\n    If[ValueQ[simRec],\n      exportFig[DCTPlots`PlotCombValidation[simK, gSim, simRec], \"validation_comb\"]];\n    If[ValueQ[validationTable],\n      exportFig[validationTable, \"validation_table\"]];\n\n    (* Section 1 \\[Dash] Lin-KK residuals *)\n    exportFig[DCTPlots`PlotKKResiduals[kkRep], \"drift_kkResiduals\"];\n\n    (* Section 1 \\[Dash] admittance-variance power law (fMin determination, SI) *)\n    If[ValueQ[driftStats],\n      exportFig[DCTPlots`PlotVariancePowerLaw[driftStats, fMinHz, fMaxHz], \"drift_variancePowerLaw\"]];\n\n    (* 3a.1 - L-curve: roughness vs weighted misfit across lambda (choosing lambda) *)\n    If[ValueQ[lCurveData],\n      exportFig[DCTPlots`PlotLCurve[lCurveData, lSweepSpecs[[All, \"File\"]]], \"lambda_lcurve\"]];\n\n    (* 3a.3 - lambda sweep: effect on g(k) (left) and Bode residuals (right) *)\n    If[ValueQ[lSweepSpecs],\n      exportFig[Row[{DCTPlots`PlotGK[lSweepSpecs, ImageSize -> 460], Spacer[12], DCTPlots`PlotLambdaResiduals[lSweepSpecs]}, Alignment -> Center], \"lambda_sweep\"]];\n\n    (* 4a.1 \\[Dash] drift g(k): E1, 0h->24h drift arrow, nF/decade *)\n    exportFig[DCTPlots`PlotGK[e1Specs, \"GScale\" -> 1*^9, PlotLegends -> None,\n        Epilog -> With[{fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White], c0 = ColorData[\"Rainbow\"][0.05], c24 = ColorData[\"Rainbow\"][0.95]},\n          {Style[Text[\"0 h\", Scaled[{0.6, 0.92}]], c0, 16, Bold],\n           {Gray, Arrowheads[0.022], AbsoluteThickness[1.1], Arrow[{Scaled[{0.6, 0.84}], Scaled[{0.6, 0.62}]}]},\n           Style[Text[\"24 h\", Scaled[{0.6, 0.54}]], c24, 16, Bold]}]],\n      \"drift_gK\"];\n\n    (* 4a.4 \\[Dash] reconstruction residuals, all spectra overlaid (SI accuracy figure) *)\n    exportFig[DCTPlots`PlotResiduals[goodSpecs[[All, \"Spec\"]]], \"drift_residuals\"];\n\n    (* 4a.5 \\[Dash] Rs and C0 vs time, aligned time axes *)\n    exportFig[\n      Column[{\n        DCTPlots`PlotRsVsTime[goodSpecs, ImagePadding -> {{85, 20}, {38, 8}}],\n        DCTPlots`PlotC0VsTime[goodSpecs, ImagePadding -> {{85, 20}, {38, 8}}]\n      }, Alignment -> Left, Spacings -> 1],\n      \"drift_RsC0\"];\n\n    (* 4a.7 \\[Dash] k_peak vs time, per k-range *)\n    exportFig[DCTPlots`PlotKPeakVsTime[goodSpecs, kPeakRanges], \"drift_kPeak\"];\n\n    (* One g(k) heatmap per electrode, titled (rasterised \\[Dash] 100s of columns) *)\n    KeyValueMap[\n      (exportFig[\n         Rasterize[DCTPlots`PlotDCTHeatmap[#2, PlotLabel -> Style[#1, 18]],\n           ImageResolution -> 300],\n         \"drift_heatmap_\" <> #1] &),\n      GroupBy[goodSpecs, FileNameTake[#[\"File\"], {-2}] &]\n    ];\n\n    (* 5.2 \\[Dash] concentration g(k): E1, absolute (nF/decade) *)\n    If[ValueQ[concE1] && Length[concE1] > 0,\n      exportFig[DCTPlots`PlotGK[concE1, Automatic, \"GScale\" -> 1*^9], \"conc_gK_absolute\"]];\n\n    (* Section 5 \\[Dash] concentration g(k): E1, area-normalised, leader-line labels (matches 5.3) *)\n    If[ValueQ[concE1] && ValueQ[concEpilog] && Length[concE1] > 0,\n      exportFig[DCTPlots`PlotGK[concE1, Automatic, \"AreaNorm\" -> True, PlotLegends -> None,\n        PlotRange -> {{kLo, kHi}, {0, gHi}}, PlotRangePadding -> None, Epilog -> concEpilog, ImageSize -> 660], \"conc_gK\"]];\n\n    (* 5.3.b \\[Dash] method schematic panels (EIS Bode + DCT) for the slide figure *)\n    If[ValueQ[schemSpec],\n      Module[{p = schemPanels[]},\n        exportFig[p[\"eis\"], \"conc_schematic_eis\"];\n        exportFig[p[\"dct\"], \"conc_schematic_dct\"]]];\n\n    (* 5.3.2 \\[Dash] EIS Bode (|Z| + phase) + DCT g(k) panel, full E1 concentration series *)\n    If[ValueQ[bodeE1] && Length[bodeE1] > 0,\n      exportFig[bodeSeriesPlot[], \"conc_bode\"]];\n\n    (* 5.5 - mean electron-transfer rate per conformational state vs [vancomycin] *)\n    If[ValueQ[boldF],\n      exportFig[stateRatesPlot[Black, White], \"conc_stateRates\"]];\n\n    (* 5a.2 \\[Dash] fraction folded vs [vancomycin], linear, with 3/4-state model fits *)\n    If[ValueQ[fitResult] && ValueQ[ffPerElectrode],\n      exportFig[biophysLinearPlot[], \"biophys_linear\"]];\n\n    (* 5d \\[Dash] two-relaxation discrimination: k_et, Y0, fast-fraction vs conc *)\n    If[ValueQ[cpe2Good] && Length[cpe2Good] > 0,\n      exportFig[cpe2KetPlot[], \"cpe2_ket\"];\n      exportFig[cpe2Y0Plot[], \"cpe2_y0\"];\n      exportFig[cpe2RatioPlot[], \"cpe2_ratio\"]];\n  ];\n\n  Print[Style[\"Export done.\", Bold, Darker[Green]]],\n\n  Print[Style[\"exportFigure = False \\[Dash] set to True to export.\", Italic, GrayLevel[0.6]]]\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">Saving to: </span><span class=\"wl-ps\">C:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\data\\\\figures</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">validation_comb</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">validation_table</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_kkResiduals</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_variancePowerLaw</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">lambda_lcurve</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">lambda_sweep</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_gK</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_residuals</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_RsC0</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_kPeak</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_heatmap_E1</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_heatmap_E2</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_heatmap_E3</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">conc_gK_absolute</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">conc_gK</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">conc_schematic_eis</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">conc_schematic_dct</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">conc_bode</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">conc_stateRates</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">biophys_linear</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzpvd3m-omtmivm\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dGNvbG9yeyMwMGZmMDB9e1x0ZXh0e0V4cG9ydCBkb25lLn19fQ==\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\" style=\"color:#00ff00;\"><span class=\"mord\" style=\"color:#00ff00;\">Export done.</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
