  },
  {
   "kind": 2,
   "value": "(* Rs and C0 vs time — one trace per electrode *)\nRow[{DCTPlots`PlotRsVsTime[goodSpecs], DCTPlots`PlotC0VsTime[goodSpecs]}, Spacer[20]]",
