     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"71\" data-out-n=\"681\" data-sub-idx=\"15\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"133\" data-sub-start=\"74\" data-sub-end=\"74\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[681]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_owzhp1xrevg4.svg\" width=\"1355\" height=\"451\" src=\"img/EAB_DCT_analysis/wl_owzhp1xrevg4.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* 10  Publication figures for the fMaxHz sweep. Reads rateCasesFM (7.4), repFMax, fMaxVals and\n   fMaxEff (7.2 / 7.7); refits nothing. Only fmx* names are defined. *)\n\nfmxCases = SortBy[rateCasesFM, #X &];\nfmxN     = Length[fmxCases];\nfmxCol[i_] := ColorData[\"Rainbow\"][0.05 + 0.9 (i - 1)/Max[fmxN - 1, 1]];   (* low cutoff violet -> high red *)\nfmxIsBase[x_] := Abs[x - fMaxEff] < 1*^-6 fMaxEff;\nfmxLabel[x_] := ToString[Round[x]] <> \" Hz\" <> If[fmxIsBase[x], \" (baseline)\", \"\"];\n\n(* one panel: curves = list of {{conc, value}, ...}, one per cutoff *)\nfmxPanel[curves_, ttl_, yLab_, {yLo_, yHi_}] := Module[{fg, bg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  ListPlot[curves, Joined -> True,\n    PlotMarkers -> Table[{\"\\[FilledCircle]\", If[fmxIsBase[fmxCases[[i, \"X\"]]], 8, 6]}, {i, fmxN}],\n    PlotStyle -> Table[Directive[fmxCol[i], AbsoluteThickness[If[fmxIsBase[fmxCases[[i, \"X\"]]], 2.6, 1.3]]], {i, fmxN}],\n    PlotTheme -> \"Default\", Frame -> True, Axes -> False, Background -> bg,\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[yLo, yHi, fg], None}, {DCTPlots`ThemeLinTicks[0., 1000., fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[vancomycin] (\\[Mu]M)\", 12, fg], Style[yLab, 12, fg]},\n    PlotLabel -> Style[ttl, 12, Bold, fg],\n    PlotRange -> {{0, 1000}, {yLo, yHi}}, PlotRangePadding -> {{Scaled[0.04], Scaled[0.04]}, {Scaled[0.04], Scaled[0.06]}},\n    ImageSize -> 330, AspectRatio -> 0.85]];\n\nfmxRange[curves_] := Module[{v = Flatten[curves[[All, All, 2]]]}, {Min[0, Min[v]], Max[v]}];\n\nfmxLegend[] := Module[{fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White]},\n  LineLegend[Table[Directive[fmxCol[i], AbsoluteThickness[If[fmxIsBase[fmxCases[[i, \"X\"]]], 2.6, 1.3]]], {i, fmxN}],\n    Table[Row[{Subscript[\"f\", \"max\"], \" = \" <> fmxLabel[fmxCases[[i, \"X\"]]]}], {i, fmxN}],\n    LegendLayout -> {\"Row\", 1}, LabelStyle -> Directive[fg, 11, FontFamily -> \"Arial\"]]];\n\n(* Figure 1: fast-mode capacitive fraction, slow rate, fast rate vs [vancomycin] *)\nfmxRatesFigure[] := Module[{fg, bg, ff, sl, fa},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  ff = ffCurveOf /@ fmxCases; sl = slowCurve /@ fmxCases; fa = fastCurve /@ fmxCases;\n  Column[{\n    Grid[{{\n      fmxPanel[ff, \"(a) Fast-mode capacitive fraction\", \"Fraction\", {0., 1.08 Max[Flatten[ff[[All, All, 2]]]]}],\n      fmxPanel[sl, \"(b) Slow mode\", \"Mean rate \\[LeftAngleBracket]k\\[RightAngleBracket] (s\\!\\(\\*SuperscriptBox[\\(\\), \\(-1\\)]\\))\", {0., 1.1 Max[Flatten[sl[[All, All, 2]]]]}],\n      fmxPanel[fa, \"(c) Fast mode\", \"Mean rate \\[LeftAngleBracket]k\\[RightAngleBracket] (s\\!\\(\\*SuperscriptBox[\\(\\), \\(-1\\)]\\))\", {0., 1.1 Max[Flatten[fa[[All, All, 2]]]]}]}},\n      Spacings -> {1., 0}],\n    fmxLegend[]}, Alignment -> Center, Spacings -> 0.8, Background -> bg]];\n\n(* Figure 2: DCT spectrum of Electrode B1 at 562 uM at each cutoff *)\nfmxGKFigure[] := Module[{fg, bg, specs, order, kLo, kHi, gMax, split},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  order = Ordering[fMaxVals];\n  specs = repFMax[[order, \"Spec\"]];\n  {kLo, kHi} = MinMax[Flatten[1./#[\"Tau\"] & /@ specs]];\n  gMax  = 1.08 Max[Flatten[1*^9 #[\"g\"] & /@ specs]];\n  split = peakWindows[repFMax[[First @ FirstPosition[fMaxVals, fMaxEff], \"Spec\"]]][[1, 2]];   (* baseline slow/fast boundary *)\n  Column[{\n    ListLogLinearPlot[Append[Transpose[{1./#[\"Tau\"], 1*^9 #[\"g\"]}] & /@ specs, {{split, -0.04 gMax}, {split, gMax}}],\n      Joined -> True, PlotMarkers -> None,\n      PlotStyle -> Append[Table[Directive[fmxCol[i], AbsoluteThickness[If[fmxIsBase[fMaxVals[[order[[i]]]]], 2.6, 1.4]]], {i, Length[specs]}],\n        Directive[fg, Opacity[0.55], AbsoluteDashing[{5, 4}], AbsoluteThickness[1.1]]],\n      PlotTheme -> \"Default\", Frame -> True, Axes -> False, Background -> bg,\n      FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n      FrameTicks -> {{DCTPlots`ThemeLinTicks[0., gMax, fg], None}, {DCTPlots`ThemeLogTicks[kLo, kHi, fg], None}},\n      FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n      FrameLabel -> {Style[\"k (s\\!\\(\\*SuperscriptBox[\\(\\), \\(-1\\)]\\))\", 13, fg], Style[\"g(k) (nF/decade)\", 13, fg]},\n      PlotLabel -> Style[\"Electrode B1, 562 \\[Mu]M: DCT spectrum vs upper frequency cutoff\", 13, Bold, fg],\n      PlotRange -> {{kLo, kHi}, {-0.04 gMax, gMax}}, PlotRangePadding -> {Scaled[0.02], {0, 0}},\n      ImageSize -> 620, AspectRatio -> 0.55],\n    fmxLegend[]}, Alignment -> Center, Spacings -> 0.6, Background -> bg]];\n\nIf[TrueQ[exportFigure] && Length[DownValues[exportFig]] > 0,\n  Block[{DCTPlots`$DCTTheme = \"Publication\"},\n    exportFig[fmxRatesFigure[], \"fmax_sweep_ff_rates\"];\n    exportFig[fmxGKFigure[], \"fmax_sweep_gk\"]]];\n\nfmxRatesFigure[]\nfmxGKFigure[]",
       "mime": "text/plain"
      }
     ],
     "id": "1a061546-31fe-4a55-9c66-61e595d7fb1c"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"72\" data-out-n=\"682\" data-sub-idx=\"16\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"133\" data-sub-start=\"75\" data-sub-end=\"75\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[682]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_1bquqxda75eun.svg\" width=\"827\" height=\"547\" src=\"img/EAB_DCT_analysis/wl_1bquqxda75eun.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* 10  Publication figures for the fMaxHz sweep. Reads rateCasesFM (7.4), repFMax, fMaxVals and\n   fMaxEff (7.2 / 7.7); refits nothing. Only fmx* names are defined. *)\n\nfmxCases = SortBy[rateCasesFM, #X &];\nfmxN     = Length[fmxCases];\nfmxCol[i_] := ColorData[\"Rainbow\"][0.05 + 0.9 (i - 1)/Max[fmxN - 1, 1]];   (* low cutoff violet -> high red *)\nfmxIsBase[x_] := Abs[x - fMaxEff] < 1*^-6 fMaxEff;\nfmxLabel[x_] := ToString[Round[x]] <> \" Hz\" <> If[fmxIsBase[x], \" (baseline)\", \"\"];\n\n(* one panel: curves = list of {{conc, value}, ...}, one per cutoff *)\nfmxPanel[curves_, ttl_, yLab_, {yLo_, yHi_}] := Module[{fg, bg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  ListPlot[curves, Joined -> True,\n    PlotMarkers -> Table[{\"\\[FilledCircle]\", If[fmxIsBase[fmxCases[[i, \"X\"]]], 8, 6]}, {i, fmxN}],\n    PlotStyle -> Table[Directive[fmxCol[i], AbsoluteThickness[If[fmxIsBase[fmxCases[[i, \"X\"]]], 2.6, 1.3]]], {i, fmxN}],\n    PlotTheme -> \"Default\", Frame -> True, Axes -> False, Background -> bg,\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[yLo, yHi, fg], None}, {DCTPlots`ThemeLinTicks[0., 1000., fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[vancomycin] (\\[Mu]M)\", 12, fg], Style[yLab, 12, fg]},\n    PlotLabel -> Style[ttl, 12, Bold, fg],\n    PlotRange -> {{0, 1000}, {yLo, yHi}}, PlotRangePadding -> {{Scaled[0.04], Scaled[0.04]}, {Scaled[0.04], Scaled[0.06]}},\n    ImageSize -> 330, AspectRatio -> 0.85]];\n\nfmxRange[curves_] := Module[{v = Flatten[curves[[All, All, 2]]]}, {Min[0, Min[v]], Max[v]}];\n\nfmxLegend[] := Module[{fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White]},\n  LineLegend[Table[Directive[fmxCol[i], AbsoluteThickness[If[fmxIsBase[fmxCases[[i, \"X\"]]], 2.6, 1.3]]], {i, fmxN}],\n    Table[Row[{Subscript[\"f\", \"max\"], \" = \" <> fmxLabel[fmxCases[[i, \"X\"]]]}], {i, fmxN}],\n    LegendLayout -> {\"Row\", 1}, LabelStyle -> Directive[fg, 11, FontFamily -> \"Arial\"]]];\n\n(* Figure 1: fast-mode capacitive fraction, slow rate, fast rate vs [vancomycin] *)\nfmxRatesFigure[] := Module[{fg, bg, ff, sl, fa},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  ff = ffCurveOf /@ fmxCases; sl = slowCurve /@ fmxCases; fa = fastCurve /@ fmxCases;\n  Column[{\n    Grid[{{\n      fmxPanel[ff, \"(a) Fast-mode capacitive fraction\", \"Fraction\", {0., 1.08 Max[Flatten[ff[[All, All, 2]]]]}],\n      fmxPanel[sl, \"(b) Slow mode\", \"Mean rate \\[LeftAngleBracket]k\\[RightAngleBracket] (s\\!\\(\\*SuperscriptBox[\\(\\), \\(-1\\)]\\))\", {0., 1.1 Max[Flatten[sl[[All, All, 2]]]]}],\n      fmxPanel[fa, \"(c) Fast mode\", \"Mean rate \\[LeftAngleBracket]k\\[RightAngleBracket] (s\\!\\(\\*SuperscriptBox[\\(\\), \\(-1\\)]\\))\", {0., 1.1 Max[Flatten[fa[[All, All, 2]]]]}]}},\n      Spacings -> {1., 0}],\n    fmxLegend[]}, Alignment -> Center, Spacings -> 0.8, Background -> bg]];\n\n(* Figure 2: DCT spectrum of Electrode B1 at 562 uM at each cutoff *)\nfmxGKFigure[] := Module[{fg, bg, specs, order, kLo, kHi, gMax, split},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  order = Ordering[fMaxVals];\n  specs = repFMax[[order, \"Spec\"]];\n  {kLo, kHi} = MinMax[Flatten[1./#[\"Tau\"] & /@ specs]];\n  gMax  = 1.08 Max[Flatten[1*^9 #[\"g\"] & /@ specs]];\n  split = peakWindows[repFMax[[First @ FirstPosition[fMaxVals, fMaxEff], \"Spec\"]]][[1, 2]];   (* baseline slow/fast boundary *)\n  Column[{\n    ListLogLinearPlot[Append[Transpose[{1./#[\"Tau\"], 1*^9 #[\"g\"]}] & /@ specs, {{split, -0.04 gMax}, {split, gMax}}],\n      Joined -> True, PlotMarkers -> None,\n      PlotStyle -> Append[Table[Directive[fmxCol[i], AbsoluteThickness[If[fmxIsBase[fMaxVals[[order[[i]]]]], 2.6, 1.4]]], {i, Length[specs]}],\n        Directive[fg, Opacity[0.55], AbsoluteDashing[{5, 4}], AbsoluteThickness[1.1]]],\n      PlotTheme -> \"Default\", Frame -> True, Axes -> False, Background -> bg,\n      FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n      FrameTicks -> {{DCTPlots`ThemeLinTicks[0., gMax, fg], None}, {DCTPlots`ThemeLogTicks[kLo, kHi, fg], None}},\n      FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n      FrameLabel -> {Style[\"k (s\\!\\(\\*SuperscriptBox[\\(\\), \\(-1\\)]\\))\", 13, fg], Style[\"g(k) (nF/decade)\", 13, fg]},\n      PlotLabel -> Style[\"Electrode B1, 562 \\[Mu]M: DCT spectrum vs upper frequency cutoff\", 13, Bold, fg],\n      PlotRange -> {{kLo, kHi}, {-0.04 gMax, gMax}}, PlotRangePadding -> {Scaled[0.02], {0, 0}},\n      ImageSize -> 620, AspectRatio -> 0.55],\n    fmxLegend[]}, Alignment -> Center, Spacings -> 0.6, Background -> bg]];\n\nIf[TrueQ[exportFigure] && Length[DownValues[exportFig]] > 0,\n  Block[{DCTPlots`$DCTTheme = \"Publication\"},\n    exportFig[fmxRatesFigure[], \"fmax_sweep_ff_rates\"];\n    exportFig[fmxGKFigure[], \"fmax_sweep_gk\"]]];\n\nfmxRatesFigure[]\nfmxGKFigure[]",
       "mime": "text/plain"
