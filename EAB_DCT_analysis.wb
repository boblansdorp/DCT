  },
  {
   "kind": 2,
   "value": "(* Concentration g(k) — area-normalised (each curve divided by its integrated capacitance) *)\nconcE1 = Select[concGoodSpecs, StringStartsQ[#File, \"E1\"] &];\nDCTPlots`PlotGK[concE1, Automatic, \"AreaNorm\" -> True]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"821465\" data-output-id=\"83\" data-out-n=\"433\" data-sub-idx=\"2\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"61\" data-sub-start=\"2\" data-sub-end=\"2\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[433]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1dzfjypjafglm.svg\" src=\"img/EAB_DCT_analysis/wl_1dzfjypjafglm.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Concentration g(k) — area-normalised (each curve divided by its integrated capacitance) *)\nconcE1 = Select[concGoodSpecs, StringStartsQ[#File, \"E1\"] &];\nDCTPlots`PlotGK[concE1, Automatic, \"AreaNorm\" -> True]",
