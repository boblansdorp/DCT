  {
   "kind": 1,
   "value": "### 4a.7 k-peak vs time",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* k_peak vs time, one panel per k-range, one trace per electrode *)\nDCTPlots`PlotKPeakVsTime[goodSpecs, kPeakRanges]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"47\" data-out-n=\"346\" data-sub-idx=\"1\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"61\" data-sub-start=\"1\" data-sub-end=\"1\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[346]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_18r4n8pcz4wjx.svg\" width=\"679\" height=\"816\" src=\"img/EAB_DCT_analysis/wl_18r4n8pcz4wjx.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* k_peak vs time, one panel per k-range, one trace per electrode *)\nDCTPlots`PlotKPeakVsTime[goodSpecs, kPeakRanges]",
