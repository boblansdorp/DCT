  {
   "kind": 2,
   "value": "(* Concentration g(k) spectra — one electrode *)\nconcE1 = Select[concGoodSpecs, StringStartsQ[#File, \"E1\"] &];\nDCTPlots`PlotGK[concE1]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"821465\" data-output-id=\"114\" data-out-n=\"677\" data-sub-idx=\"2\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"62\" data-sub-start=\"2\" data-sub-end=\"2\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[677]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1grn5wv7h0y66.svg\" src=\"img/EAB_DCT_analysis/wl_1grn5wv7h0y66.svg\"/></div></div>",
