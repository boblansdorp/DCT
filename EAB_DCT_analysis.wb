  {
   "kind": 1,
   "value": "### 5.2 g(k) spectra",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Concentration g(k) spectra – one electrode *)\nconcE1 = Select[concGoodSpecs, StringStartsQ[#File, \"B1\"] &];\nDCTPlots`PlotGK[concE1]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"52\" data-out-n=\"394\" data-sub-idx=\"2\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"74\" data-sub-start=\"2\" data-sub-end=\"2\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[394]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_8fyihmmnhjic.svg\" width=\"1053\" height=\"513\" src=\"img/EAB_DCT_analysis/wl_8fyihmmnhjic.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Concentration g(k) spectra – one electrode *)\nconcE1 = Select[concGoodSpecs, StringStartsQ[#File, \"B1\"] &];\nDCTPlots`PlotGK[concE1]",
       "mime": "text/plain"
      }
     ],
     "id": "a1825496-fc58-40bd-a56a-cb39d15e6e9a"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5.3 Area-normalised g(k)",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Concentration g(k), area-normalised (each curve / its integrated capacitance),\n   with per-curve leader-line labels instead of a legend: each label sits to the\n   right of the fast peak and a thin colour-matched line points to that curve's\n   fast (folded) peak. The normalised fast peak grows monotonically with\n   concentration, so labels run 1000 -> 0 top-to-bottom and the leaders don't cross. *)\nconcE1   = Select[concGoodSpecs, StringStartsQ[#File, \"B1\"] &];\nnC       = Length[concE1];\nconcCols = Table[ColorData[\"Rainbow\"][u], {u, 0.05, 0.95, 0.9/Max[nC - 1, 1]}];\nconcLbls = StringTrim[StringDrop[#File, 2]] & /@ concE1;   (* \"0 \\[Mu]M\", ... (drop the \"B1\") *)\ngNorm[sp_] := sp[\"g\"]/Max[DCTPeakAnalysis`IntegrateSpectrum[sp], 1.*^-15];\n\n(* anchor each leader to that curve's fast peak (k in [100, 300] /s) *)\nfastAnchor[sp_] := Module[{k = 1./sp[\"Tau\"], gN = gNorm[sp], idx},\n  idx = Select[Range[Length[gN]], 100 <= k[[#]] <= 300 &];\n  If[idx === {}, idx = Range[Length[gN]]];\n  {k[[idx[[First@Ordering[gN[[idx]], -1]]]]], Max[gN[[idx]]]}];\nconcAnchors = fastAnchor[#Spec] & /@ concE1;\n\nallK = Flatten[1./#Spec[\"Tau\"] & /@ concE1];\n{kLo, kHi} = MinMax[allK];\ngHi  = Max[Flatten[gNorm[#Spec] & /@ concE1]] 1.08;\nfX[k_] := (Log10[k] - Log10[kLo])/(Log10[kHi] - Log10[kLo]);\nfY[g_] := (g + 0.04 gHi)/(1.04 gHi);   (* y range is {-0.04 gHi, gHi} so the zero baseline shows *)\nxLab  = 0.66;                                              (* label column, right of the fast peak *)\nlabFY = Table[0.96 - 0.86 (nC - i)/Max[nC - 1, 1], {i, nC}];   (* reverse conc: high at top *)\n\nconcEpilog = Flatten@Table[\n  With[{col = concCols[[i]], kp = concAnchors[[i, 1]], gp = concAnchors[[i, 2]],\n        ly = labFY[[i]], lbl = concLbls[[i]]},\n    {{col, AbsoluteThickness[0.7], Line[{Scaled[{xLab - 0.008, ly}], Scaled[{fX[kp], fY[gp]}]}]},\n     Style[Text[lbl, Scaled[{xLab, ly}], {-1, 0}], col, 14, Bold]}],\n  {i, nC}];\n\nDCTPlots`PlotGK[concE1, Automatic, \"AreaNorm\" -> True, PlotLegends -> None,\n  PlotRange -> {{kLo, kHi}, {-0.04 gHi, gHi}}, PlotRangePadding -> None,\n  Epilog -> concEpilog, ImageSize -> 660]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"53\" data-out-n=\"410\" data-sub-idx=\"17\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"76\" data-sub-start=\"33\" data-sub-end=\"35\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[410]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_1iltkx7q5yq27.svg\" width=\"880\" height=\"603\" src=\"img/EAB_DCT_analysis/wl_1iltkx7q5yq27.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Concentration g(k), area-normalised (each curve / its integrated capacitance),\n   with per-curve leader-line labels instead of a legend: each label sits to the\n   right of the fast peak and a thin colour-matched line points to that curve's\n   fast (folded) peak. The normalised fast peak grows monotonically with\n   concentration, so labels run 1000 -> 0 top-to-bottom and the leaders don't cross. *)\nconcE1   = Select[concGoodSpecs, StringStartsQ[#File, \"B1\"] &];\nnC       = Length[concE1];\nconcCols = Table[ColorData[\"Rainbow\"][u], {u, 0.05, 0.95, 0.9/Max[nC - 1, 1]}];\nconcLbls = StringTrim[StringDrop[#File, 2]] & /@ concE1;   (* \"0 \\[Mu]M\", ... (drop the \"B1\") *)\ngNorm[sp_] := sp[\"g\"]/Max[DCTPeakAnalysis`IntegrateSpectrum[sp], 1.*^-15];\n\n(* anchor each leader to that curve's fast peak (k in [100, 300] /s) *)\nfastAnchor[sp_] := Module[{k = 1./sp[\"Tau\"], gN = gNorm[sp], idx},\n  idx = Select[Range[Length[gN]], 100 <= k[[#]] <= 300 &];\n  If[idx === {}, idx = Range[Length[gN]]];\n  {k[[idx[[First@Ordering[gN[[idx]], -1]]]]], Max[gN[[idx]]]}];\nconcAnchors = fastAnchor[#Spec] & /@ concE1;\n\nallK = Flatten[1./#Spec[\"Tau\"] & /@ concE1];\n{kLo, kHi} = MinMax[allK];\ngHi  = Max[Flatten[gNorm[#Spec] & /@ concE1]] 1.08;\nfX[k_] := (Log10[k] - Log10[kLo])/(Log10[kHi] - Log10[kLo]);\nfY[g_] := (g + 0.04 gHi)/(1.04 gHi);   (* y range is {-0.04 gHi, gHi} so the zero baseline shows *)\nxLab  = 0.66;                                              (* label column, right of the fast peak *)\nlabFY = Table[0.96 - 0.86 (nC - i)/Max[nC - 1, 1], {i, nC}];   (* reverse conc: high at top *)\n\nconcEpilog = Flatten@Table[\n  With[{col = concCols[[i]], kp = concAnchors[[i, 1]], gp = concAnchors[[i, 2]],\n        ly = labFY[[i]], lbl = concLbls[[i]]},\n    {{col, AbsoluteThickness[0.7], Line[{Scaled[{xLab - 0.008, ly}], Scaled[{fX[kp], fY[gp]}]}]},\n     Style[Text[lbl, Scaled[{xLab, ly}], {-1, 0}], col, 14, Bold]}],\n  {i, nC}];\n\nDCTPlots`PlotGK[concE1, Automatic, \"AreaNorm\" -> True, PlotLegends -> None,\n  PlotRange -> {{kLo, kHi}, {-0.04 gHi, gHi}}, PlotRangePadding -> None,\n  Epilog -> concEpilog, ImageSize -> 660]",
       "mime": "text/plain"
      }
     ],
     "id": "21af5229-6ee5-4c1f-9f6a-c784f24b4ec7"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5.3.b Method schematic panels (one intermediate concentration)\nThe 'before' and 'after' of the inversion for a single representative spectrum (Electrode B1 at schemConc uM): (a) the raw EIS Bode magnitude + phase, and (c) the recovered DCT spectrum g(k). Drop the inversion cartoon (b) in the gap between them. Change schemConc to use a different concentration; theme-aware (dark + publication).",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 5.3.b  Method-schematic panels for one representative intermediate concentration:\n   (a) the raw EIS Bode magnitude + phase, and (c) the recovered DCT spectrum g(k)\n   -- the \"before\" and \"after\" of the inversion. schemPanels[] returns both panels\n   (keys \"eis\" and \"dct\") so this cell and the export share one definition; theme-aware.\n   Change schemConc to pick a different [vancomycin]. *)\nschemConc = 178;   (* intermediate [vancomycin], uM *)\nschemSpec = First[Select[concGoodSpecs, StringStartsQ[#File, \"B1 \" <> ToString[schemConc] <> \" \"] &]][\"Spec\"];\nschemCol  = RGBColor[0.05, 0.28, 0.72];   (* deep cobalt blue *)\n\nschemPanels[] := Module[\n  {fg, bg, f = schemSpec[\"FreqHz\"], z = schemSpec[\"ZData\"], magD, phD, magP, phP, kLab, dctBase},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  magD = Transpose[{f, Abs[z]/1000.}];\n  phD  = Transpose[{f, (180./Pi) Arg[z]}];\n  magP = ListLogLogPlot[magD, Joined -> True, PlotStyle -> Directive[schemCol, AbsoluteThickness[2.5]],\n    Frame -> True, Axes -> False, Background -> bg, PlotTheme -> \"Default\",\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLogTicks[Min[Abs[z]]/1000., Max[Abs[z]]/1000., fg], None},\n                   {DCTPlots`ThemeLogTicks[Min[f], Max[f], fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {None, Style[\"|Z| (k\\[CapitalOmega])\", 13, fg]}, ImageSize -> 300, AspectRatio -> 0.7];\n  phP = ListLogLinearPlot[phD, Joined -> True, PlotStyle -> Directive[schemCol, AbsoluteThickness[2.5]],\n    Frame -> True, Axes -> False, Background -> bg, PlotTheme -> \"Default\",\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[Min[phD[[All, 2]]], Max[phD[[All, 2]]], fg], None},\n                   {DCTPlots`ThemeLogTicks[Min[f], Max[f], fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"Frequency (Hz)\", 13, fg], Style[\"Phase (\\[Degree])\", 13, fg]},\n    ImageSize -> 300, AspectRatio -> 0.7];\n  (* DCT panel: nF/decade, with a HORIZONTAL y-label sat above the axis *)\n  kLab = Style[Row[{\"Electron-transfer rate, k (\", Superscript[\"s\", -1], \")\"}], 13, fg];\n  dctBase = DCTPlots`PlotGK[{<|\"File\" -> ToString[schemConc] <> \" \\[Mu]M\", \"Spec\" -> schemSpec|>},\n    \"GScale\" -> 1*^9, PlotStyle -> Directive[schemCol, AbsoluteThickness[2.5]], PlotLegends -> None,\n    FrameLabel -> {kLab, None}, ImagePadding -> {{58, 14}, {52, 8}}, ImageSize -> 430];\n  <|\"eis\" -> Column[{magP, phP}, Alignment -> Center, Spacings -> 0.4],\n    \"dct\" -> Column[{Style[\"g(k) (nF/decade)\", fg, 13], dctBase}, Alignment -> Left, Spacings -> 0.1]|>];\n\nWith[{p = schemPanels[]},\n  Grid[{{p[\"eis\"], p[\"dct\"]}}, Alignment -> {Center, Center}, Spacings -> {4, 0.5}]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"54\" data-out-n=\"415\" data-sub-idx=\"5\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"78\" data-sub-start=\"38\" data-sub-end=\"39\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[415]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_1ef5gyiw11q77.svg\" width=\"1043\" height=\"572\" src=\"img/EAB_DCT_analysis/wl_1ef5gyiw11q77.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* 5.3.b  Method-schematic panels for one representative intermediate concentration:\n   (a) the raw EIS Bode magnitude + phase, and (c) the recovered DCT spectrum g(k)\n   -- the \"before\" and \"after\" of the inversion. schemPanels[] returns both panels\n   (keys \"eis\" and \"dct\") so this cell and the export share one definition; theme-aware.\n   Change schemConc to pick a different [vancomycin]. *)\nschemConc = 178;   (* intermediate [vancomycin], uM *)\nschemSpec = First[Select[concGoodSpecs, StringStartsQ[#File, \"B1 \" <> ToString[schemConc] <> \" \"] &]][\"Spec\"];\nschemCol  = RGBColor[0.05, 0.28, 0.72];   (* deep cobalt blue *)\n\nschemPanels[] := Module[\n  {fg, bg, f = schemSpec[\"FreqHz\"], z = schemSpec[\"ZData\"], magD, phD, magP, phP, kLab, dctBase},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  magD = Transpose[{f, Abs[z]/1000.}];\n  phD  = Transpose[{f, (180./Pi) Arg[z]}];\n  magP = ListLogLogPlot[magD, Joined -> True, PlotStyle -> Directive[schemCol, AbsoluteThickness[2.5]],\n    Frame -> True, Axes -> False, Background -> bg, PlotTheme -> \"Default\",\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLogTicks[Min[Abs[z]]/1000., Max[Abs[z]]/1000., fg], None},\n                   {DCTPlots`ThemeLogTicks[Min[f], Max[f], fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {None, Style[\"|Z| (k\\[CapitalOmega])\", 13, fg]}, ImageSize -> 300, AspectRatio -> 0.7];\n  phP = ListLogLinearPlot[phD, Joined -> True, PlotStyle -> Directive[schemCol, AbsoluteThickness[2.5]],\n    Frame -> True, Axes -> False, Background -> bg, PlotTheme -> \"Default\",\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[Min[phD[[All, 2]]], Max[phD[[All, 2]]], fg], None},\n                   {DCTPlots`ThemeLogTicks[Min[f], Max[f], fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"Frequency (Hz)\", 13, fg], Style[\"Phase (\\[Degree])\", 13, fg]},\n    ImageSize -> 300, AspectRatio -> 0.7];\n  (* DCT panel: nF/decade, with a HORIZONTAL y-label sat above the axis *)\n  kLab = Style[Row[{\"Electron-transfer rate, k (\", Superscript[\"s\", -1], \")\"}], 13, fg];\n  dctBase = DCTPlots`PlotGK[{<|\"File\" -> ToString[schemConc] <> \" \\[Mu]M\", \"Spec\" -> schemSpec|>},\n    \"GScale\" -> 1*^9, PlotStyle -> Directive[schemCol, AbsoluteThickness[2.5]], PlotLegends -> None,\n    FrameLabel -> {kLab, None}, ImagePadding -> {{58, 14}, {52, 8}}, ImageSize -> 430];\n  <|\"eis\" -> Column[{magP, phP}, Alignment -> Center, Spacings -> 0.4],\n    \"dct\" -> Column[{Style[\"g(k) (nF/decade)\", fg, 13], dctBase}, Alignment -> Left, Spacings -> 0.1]|>];\n\nWith[{p = schemPanels[]},\n  Grid[{{p[\"eis\"], p[\"dct\"]}}, Alignment -> {Center, Center}, Spacings -> {4, 0.5}]]",
       "mime": "text/plain"
      }
     ],
     "id": "e647cae8-b0a4-4d8f-ac46-c263d8a32551"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5.3.2 Raw EIS Bode spectra, full Electrode B1 concentration series\nThe measured impedance behind the 5.3 g(k) curves: magnitude |Z| (k\\[CapitalOmega]) on top, phase (\\[Degree]) below, one rainbow-coloured curve per [vancomycin] (violet = 0 \\[Mu]M → red = 1000 \\[Mu]M, same colours as 5.3). The phase carries a low-frequency bump (the folded population) that marches to higher frequency and deepens with concentration; cascaded callout labels fan it out (0 \\[Mu]M near 5 Hz → 1000 \\[Mu]M near 100 Hz). Theme-aware (dark + publication).\n\n*Note: `ListLogLinearPlot` Epilog x-coordinates are **natural** log (`Log`), not `Log10`.*",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 5.3.2  Raw EIS Bode spectra for the full Electrode B1 [vancomycin] series.\n   Magnitude (k\\[CapitalOmega], linear) on top, phase (\\[Degree]) below, one rainbow curve\n   per concentration (violet 0 \\[Mu]M -> red 1000 \\[Mu]M, matching 5.3). The phase bump\n   near 10-30 Hz (folded population) shifts up in frequency with [vancomycin], so the\n   cascaded callout labels fan left-to-right (0 \\[Mu]M ~5 Hz -> 1000 \\[Mu]M ~100 Hz) and the\n   colour-matched arrows point each label to its curve's bump. Theme-aware.\n   NB: ListLogLinearPlot's Epilog x-coordinates are NATURAL log (Log), not Log10. *)\n\nbodeUM[lbl_] := ToExpression @ First[StringCases[lbl, n : NumberString ~~ \" \\[Mu]M\" :> n], \"0\"];\nbodeE1    = SortBy[Select[concGoodSpecs, StringStartsQ[#File, \"B1 \"] &], bodeUM[#File] &];\nbodeConcs = bodeUM /@ bodeE1[[All, \"File\"]];\nbodeCols  = Table[ColorData[\"Rainbow\"][u], {u, 0.05, 0.95, 0.9/Max[Length[bodeE1] - 1, 1]}];\n\nbodeSeriesPlot[] := Module[\n  {fg, bg, nC = Length[bodeE1], magCurves, phCurves, peaks, aEnd, magMax, magMin, yLo, fMin, fMax, ux, uy, topY, asp, arrowLen, labGap, angHi, angLo, thAng, heads, tails, labP, lab, magP, phP, gN, dctAnchor, dctAnchors, allK, kLo, kHi, gHi, fXk, fYg, xLab, labFY, dctEpilog, dctP},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  magCurves = Transpose[{#Spec[\"FreqHz\"], Abs[#Spec[\"ZData\"]]/1000.}] & /@ bodeE1;\n  phCurves  = Transpose[{#Spec[\"FreqHz\"], (180./Pi) Arg[#Spec[\"ZData\"]]}] & /@ bodeE1;\n  (* the phase bump (folded population) for each curve, restricted to 4-55 Hz *)\n  peaks = Table[Module[{c = Select[phCurves[[i]], 4 <= #[[1]] <= 55 &]},\n     c[[First @ Ordering[c[[All, 2]], -1]]]], {i, nC}];\n  (* most arrows point at the bump peak, but pull the 0 \\[Mu]M head to a lower\n     frequency (~6.5 Hz) so it clears the 1 \\[Mu]M head (the two lowest curves overlap) *)\n  aEnd = peaks;\n  aEnd[[1]] = phCurves[[1]][[First @ Ordering[Abs[Log10[phCurves[[1]][[All, 1]]] - Log10[6.5]], 1]]];\n  magMax = Max[Flatten[magCurves[[All, All, 2]]]];\n  magMin = Min[Flatten[magCurves[[All, All, 2]]]];\n  yLo    = Min[Flatten[phCurves[[All, All, 2]]]];\n  fMin   = Min[Flatten[phCurves[[All, All, 1]]]]; fMax = Max[Flatten[phCurves[[All, All, 1]]]];\n  (* callout arrows fan at a linearly varying SCREEN angle (0 \\[Mu]M -> angHi, highest [vanco] -> angLo);\n     heads pin to each curve's phase bump, the label sits at the arrow tail. ux/uy/asp convert the\n     screen angle into the mixed-unit (natural-log Hz x degrees) Epilog coords. Tune {angHi,angLo},\n     arrowLen (fraction of frame width), and topY (frame top -> less/more headroom). *)\n  {angHi, angLo} = {-60., -120.};  arrowLen = 0.11;  labGap = 0.03;  asp = 0.52;\n  ux = Log[fMax] - Log[fMin];  topY = -63.;  uy = topY - (yLo - 1.);\n  thAng = Table[(angHi + (angLo - angHi) (i - 1)/Max[nC - 1, 1]) Degree, {i, nC}];\n  heads = Table[{Log[aEnd[[i, 1]]], aEnd[[i, 2]] + 0.6}, {i, nC}];\n  tails = Table[heads[[i]] - arrowLen          {Cos[thAng[[i]]] ux, Sin[thAng[[i]]] uy/asp}, {i, nC}];\n  labP  = Table[heads[[i]] - (arrowLen + labGap) {Cos[thAng[[i]]] ux, Sin[thAng[[i]]] uy/asp}, {i, nC}];\n  lab[i_] := {{bodeCols[[i]], Opacity[0.9], Arrowheads[0.013], AbsoluteThickness[1.],\n      Arrow[{tails[[i]], heads[[i]]}]},\n     Text[Style[ToString[bodeConcs[[i]]] <> \" \\[Mu]M\", bodeCols[[i]], 10, Bold], labP[[i]], {Cos[thAng[[i]]], Sin[thAng[[i]]]}]};\n  magP = ListLogLogPlot[magCurves, Joined -> True,\n    PlotStyle -> (Directive[#, AbsoluteThickness[2.]] & /@ bodeCols),\n    Frame -> True, Axes -> False, Background -> bg, PlotTheme -> \"Default\",\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLogTicks[magMin, magMax, fg], None}, {DCTPlots`ThemeLogTicks[fMin, fMax, fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {None, Style[\"|Z| (k\\[CapitalOmega])\", 13, fg]},\n    ImageSize -> 600, AspectRatio -> 0.42, ImagePadding -> {{62, 12}, {6, 8}}, PlotLegends -> None,\n    Epilog -> {Text[Style[\"a\", 15, Bold, fg, Background -> bg], Scaled[{0.03, 0.86}], {-1, 1}]}];\n  phP = ListLogLinearPlot[phCurves, Joined -> True,\n    PlotStyle -> (Directive[#, AbsoluteThickness[2.]] & /@ bodeCols),\n    Frame -> True, Axes -> False, Background -> bg, PlotTheme -> \"Default\",\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[yLo, -70., fg], None}, {DCTPlots`ThemeLogTicks[fMin, fMax, fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"Frequency (Hz)\", 13, fg], Style[\"Phase (\\[Degree])\", 13, fg]},\n    PlotRange -> {Automatic, {yLo - 1, topY}}, \n    ImageSize -> 600, \n    AspectRatio -> 0.6,\n    ImagePadding -> {{62, 12}, {46, 6}}, PlotLegends -> None, Epilog -> Append[Flatten[lab /@ Range[nC]], Text[Style[\"b\", 15, Bold, fg, Background -> bg], Scaled[{0.03, 0.9}], {-1, 1}]]];\n  (* DCT g(k) panel for the same series: absolute g(k) (nF/decade), leader-line labels (cf. 5.3) *)\n  gN[sp_] := 1.*^9 sp[\"g\"];\n  dctAnchor[sp_] := Module[{k = 1./sp[\"Tau\"], g = gN[sp], idx},\n    idx = Select[Range[Length[g]], 100 <= k[[#]] <= 300 &];\n    If[idx === {}, idx = Range[Length[g]]];\n    {k[[idx[[First @ Ordering[g[[idx]], -1]]]]], Max[g[[idx]]]}];\n  dctAnchors = dctAnchor[#Spec] & /@ bodeE1;\n  allK = Flatten[1./#Spec[\"Tau\"] & /@ bodeE1];\n  {kLo, kHi} = MinMax[allK];\n  gHi = Max[Flatten[gN[#Spec] & /@ bodeE1]] 1.08;\n  fXk[k_] := (Log10[k] - Log10[kLo])/(Log10[kHi] - Log10[kLo]);\n  fYg[g_] := (g + 0.04 gHi)/(1.04 gHi);   (* y range is {-0.04 gHi, gHi} so the zero baseline shows *)\n  xLab = 0.66;\n  labFY = Table[0.96 - 0.86 (nC - i)/Max[nC - 1, 1], {i, nC}];\n  dctEpilog = Flatten @ Table[\n    With[{col = bodeCols[[i]], kp = dctAnchors[[i, 1]], gp = dctAnchors[[i, 2]],\n          ly = labFY[[i]], lbl = ToString[bodeConcs[[i]]] <> \" \\[Mu]M\"},\n      {{col, AbsoluteThickness[0.7], Line[{Scaled[{xLab - 0.008, ly}], Scaled[{fXk[kp], fYg[gp]}]}]},\n       Style[Text[lbl, Scaled[{xLab, ly}], {-1, 0}], col, 14, Bold]}],\n    {i, nC}];\n  dctP = DCTPlots`PlotGK[bodeE1, Automatic, \"GScale\" -> 1.*^9, PlotLegends -> None,\n    PlotRange -> {{kLo, kHi}, {-0.04 gHi, gHi}}, PlotRangePadding -> None, Epilog -> Append[dctEpilog, Text[Style[\"c\", 15, Bold, fg, Background -> bg], Scaled[{0.03, 0.92}], {-1, 1}]],\n    ImageSize -> 660, AspectRatio -> 0.6];\n  Grid[{{Column[{magP, phP}, Spacings -> 0, Alignment -> Left], dctP}},\n    Alignment -> {Center, Center}, Spacings -> {2, 0}]];\n\nbodeSeriesPlot[]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"55\" data-out-n=\"421\" data-sub-idx=\"6\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"80\" data-sub-start=\"89\" data-sub-end=\"89\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[421]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_azw6z7hmp04u.svg\" width=\"1715\" height=\"807\" src=\"img/EAB_DCT_analysis/wl_azw6z7hmp04u.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* 5.3.2  Raw EIS Bode spectra for the full Electrode B1 [vancomycin] series.\n   Magnitude (k\\[CapitalOmega], linear) on top, phase (\\[Degree]) below, one rainbow curve\n   per concentration (violet 0 \\[Mu]M -> red 1000 \\[Mu]M, matching 5.3). The phase bump\n   near 10-30 Hz (folded population) shifts up in frequency with [vancomycin], so the\n   cascaded callout labels fan left-to-right (0 \\[Mu]M ~5 Hz -> 1000 \\[Mu]M ~100 Hz) and the\n   colour-matched arrows point each label to its curve's bump. Theme-aware.\n   NB: ListLogLinearPlot's Epilog x-coordinates are NATURAL log (Log), not Log10. *)\n\nbodeUM[lbl_] := ToExpression @ First[StringCases[lbl, n : NumberString ~~ \" \\[Mu]M\" :> n], \"0\"];\nbodeE1    = SortBy[Select[concGoodSpecs, StringStartsQ[#File, \"B1 \"] &], bodeUM[#File] &];\nbodeConcs = bodeUM /@ bodeE1[[All, \"File\"]];\nbodeCols  = Table[ColorData[\"Rainbow\"][u], {u, 0.05, 0.95, 0.9/Max[Length[bodeE1] - 1, 1]}];\n\nbodeSeriesPlot[] := Module[\n  {fg, bg, nC = Length[bodeE1], magCurves, phCurves, peaks, aEnd, magMax, magMin, yLo, fMin, fMax, ux, uy, topY, asp, arrowLen, labGap, angHi, angLo, thAng, heads, tails, labP, lab, magP, phP, gN, dctAnchor, dctAnchors, allK, kLo, kHi, gHi, fXk, fYg, xLab, labFY, dctEpilog, dctP},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  magCurves = Transpose[{#Spec[\"FreqHz\"], Abs[#Spec[\"ZData\"]]/1000.}] & /@ bodeE1;\n  phCurves  = Transpose[{#Spec[\"FreqHz\"], (180./Pi) Arg[#Spec[\"ZData\"]]}] & /@ bodeE1;\n  (* the phase bump (folded population) for each curve, restricted to 4-55 Hz *)\n  peaks = Table[Module[{c = Select[phCurves[[i]], 4 <= #[[1]] <= 55 &]},\n     c[[First @ Ordering[c[[All, 2]], -1]]]], {i, nC}];\n  (* most arrows point at the bump peak, but pull the 0 \\[Mu]M head to a lower\n     frequency (~6.5 Hz) so it clears the 1 \\[Mu]M head (the two lowest curves overlap) *)\n  aEnd = peaks;\n  aEnd[[1]] = phCurves[[1]][[First @ Ordering[Abs[Log10[phCurves[[1]][[All, 1]]] - Log10[6.5]], 1]]];\n  magMax = Max[Flatten[magCurves[[All, All, 2]]]];\n  magMin = Min[Flatten[magCurves[[All, All, 2]]]];\n  yLo    = Min[Flatten[phCurves[[All, All, 2]]]];\n  fMin   = Min[Flatten[phCurves[[All, All, 1]]]]; fMax = Max[Flatten[phCurves[[All, All, 1]]]];\n  (* callout arrows fan at a linearly varying SCREEN angle (0 \\[Mu]M -> angHi, highest [vanco] -> angLo);\n     heads pin to each curve's phase bump, the label sits at the arrow tail. ux/uy/asp convert the\n     screen angle into the mixed-unit (natural-log Hz x degrees) Epilog coords. Tune {angHi,angLo},\n     arrowLen (fraction of frame width), and topY (frame top -> less/more headroom). *)\n  {angHi, angLo} = {-60., -120.};  arrowLen = 0.11;  labGap = 0.03;  asp = 0.52;\n  ux = Log[fMax] - Log[fMin];  topY = -63.;  uy = topY - (yLo - 1.);\n  thAng = Table[(angHi + (angLo - angHi) (i - 1)/Max[nC - 1, 1]) Degree, {i, nC}];\n  heads = Table[{Log[aEnd[[i, 1]]], aEnd[[i, 2]] + 0.6}, {i, nC}];\n  tails = Table[heads[[i]] - arrowLen          {Cos[thAng[[i]]] ux, Sin[thAng[[i]]] uy/asp}, {i, nC}];\n  labP  = Table[heads[[i]] - (arrowLen + labGap) {Cos[thAng[[i]]] ux, Sin[thAng[[i]]] uy/asp}, {i, nC}];\n  lab[i_] := {{bodeCols[[i]], Opacity[0.9], Arrowheads[0.013], AbsoluteThickness[1.],\n      Arrow[{tails[[i]], heads[[i]]}]},\n     Text[Style[ToString[bodeConcs[[i]]] <> \" \\[Mu]M\", bodeCols[[i]], 10, Bold], labP[[i]], {Cos[thAng[[i]]], Sin[thAng[[i]]]}]};\n  magP = ListLogLogPlot[magCurves, Joined -> True,\n    PlotStyle -> (Directive[#, AbsoluteThickness[2.]] & /@ bodeCols),\n    Frame -> True, Axes -> False, Background -> bg, PlotTheme -> \"Default\",\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLogTicks[magMin, magMax, fg], None}, {DCTPlots`ThemeLogTicks[fMin, fMax, fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {None, Style[\"|Z| (k\\[CapitalOmega])\", 13, fg]},\n    ImageSize -> 600, AspectRatio -> 0.42, ImagePadding -> {{62, 12}, {6, 8}}, PlotLegends -> None,\n    Epilog -> {Text[Style[\"a\", 15, Bold, fg, Background -> bg], Scaled[{0.03, 0.86}], {-1, 1}]}];\n  phP = ListLogLinearPlot[phCurves, Joined -> True,\n    PlotStyle -> (Directive[#, AbsoluteThickness[2.]] & /@ bodeCols),\n    Frame -> True, Axes -> False, Background -> bg, PlotTheme -> \"Default\",\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[yLo, -70., fg], None}, {DCTPlots`ThemeLogTicks[fMin, fMax, fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"Frequency (Hz)\", 13, fg], Style[\"Phase (\\[Degree])\", 13, fg]},\n    PlotRange -> {Automatic, {yLo - 1, topY}}, \n    ImageSize -> 600, \n    AspectRatio -> 0.6,\n    ImagePadding -> {{62, 12}, {46, 6}}, PlotLegends -> None, Epilog -> Append[Flatten[lab /@ Range[nC]], Text[Style[\"b\", 15, Bold, fg, Background -> bg], Scaled[{0.03, 0.9}], {-1, 1}]]];\n  (* DCT g(k) panel for the same series: absolute g(k) (nF/decade), leader-line labels (cf. 5.3) *)\n  gN[sp_] := 1.*^9 sp[\"g\"];\n  dctAnchor[sp_] := Module[{k = 1./sp[\"Tau\"], g = gN[sp], idx},\n    idx = Select[Range[Length[g]], 100 <= k[[#]] <= 300 &];\n    If[idx === {}, idx = Range[Length[g]]];\n    {k[[idx[[First @ Ordering[g[[idx]], -1]]]]], Max[g[[idx]]]}];\n  dctAnchors = dctAnchor[#Spec] & /@ bodeE1;\n  allK = Flatten[1./#Spec[\"Tau\"] & /@ bodeE1];\n  {kLo, kHi} = MinMax[allK];\n  gHi = Max[Flatten[gN[#Spec] & /@ bodeE1]] 1.08;\n  fXk[k_] := (Log10[k] - Log10[kLo])/(Log10[kHi] - Log10[kLo]);\n  fYg[g_] := (g + 0.04 gHi)/(1.04 gHi);   (* y range is {-0.04 gHi, gHi} so the zero baseline shows *)\n  xLab = 0.66;\n  labFY = Table[0.96 - 0.86 (nC - i)/Max[nC - 1, 1], {i, nC}];\n  dctEpilog = Flatten @ Table[\n    With[{col = bodeCols[[i]], kp = dctAnchors[[i, 1]], gp = dctAnchors[[i, 2]],\n          ly = labFY[[i]], lbl = ToString[bodeConcs[[i]]] <> \" \\[Mu]M\"},\n      {{col, AbsoluteThickness[0.7], Line[{Scaled[{xLab - 0.008, ly}], Scaled[{fXk[kp], fYg[gp]}]}]},\n       Style[Text[lbl, Scaled[{xLab, ly}], {-1, 0}], col, 14, Bold]}],\n    {i, nC}];\n  dctP = DCTPlots`PlotGK[bodeE1, Automatic, \"GScale\" -> 1.*^9, PlotLegends -> None,\n    PlotRange -> {{kLo, kHi}, {-0.04 gHi, gHi}}, PlotRangePadding -> None, Epilog -> Append[dctEpilog, Text[Style[\"c\", 15, Bold, fg, Background -> bg], Scaled[{0.03, 0.92}], {-1, 1}]],\n    ImageSize -> 660, AspectRatio -> 0.6];\n  Grid[{{Column[{magP, phP}, Spacings -> 0, Alignment -> Left], dctP}},\n    Alignment -> {Center, Center}, Spacings -> {2, 0}]];\n\nbodeSeriesPlot[]",
       "mime": "text/plain"
      }
     ],
     "id": "3ef1d4fc-7cee-49c4-8950-c23eecffc137"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5.3.2b Nyquist plots, every electrode and condition\nTwo figures, with every spectrum of each electrode and condition overlaid:\n\n1. **Titrations** (`nyquist_titration`): row 1 is series A (2026-02-25), row 2 is series B (2026-03-24), with one column per electrode. Colour gives the concentration on one fixed scale shared by both series, so a colour means the same [vancomycin] in both rows.\n2. **Drift** (`nyquist_drift`): the three B electrodes held for 24 h at 1000 µM vancomycin, coloured by time.\n\nBy default the analysis band is shown (fMinHz to fMaxHz, the data the DCT fits), because over the full measured range the capacitive branch runs to about −1.7 MΩ at 0.1 Hz and squeezes the region where the reporters appear into a corner. Set `nyqFullRange = True` to plot the full measurement instead. Axes are shared within each row but are **not** to equal scale, so the steep capacitive branch stays readable. Both figures are exported by the 6.1 hub.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 5.3.2b  Nyquist plots in two figures: (1) the titrations, rows = series A and B, columns =\n   electrode 1, 2, 3; (2) the drift run, one panel per B electrode. All spectra of each\n   electrode/condition overlaid, shared axes within each row. Both are exported by 6.1 as\n   nyquist_titration and nyquist_drift. *)\nnyqFullRange = False;       (* True: full measured range from the raw files instead of the fit band *)\n\n(* concentration -> colour on ONE scale for both series: 0 uM violet, then log10 from 1 to 1000 uM *)\nnyqConcCol[c_] := ColorData[\"Rainbow\"][0.05 + 0.9 (Log10[Max[c, 0.3]] - Log10[0.3])/(3. - Log10[0.3])];\nnyqTimeCol[h_] := ColorData[\"Rainbow\"][0.05 + 0.9 Clip[h/24., {0, 1}]];\n\n(* {Z', -Z''} in kOhm for a spectrum record; full range re-imports the raw file *)\nnyqConcFile[tag_, um_] := Module[{dir = If[StringTake[tag, 1] === seriesOfDir[concentrationDir2], concentrationDir2, concentrationDir]},\n  First @ Select[FileNames[\"*.txt\", dir], concElec[#] == StringDrop[tag, 1] && concUM[#] == um &]];\nnyqCurve[z_] := Transpose[{Re[z], -Im[z]}]/1000.;\nnyqConcTrace[r_] := Module[{tag = StringTake[r[\"File\"], 2], um = N @ getLabelUM[r[\"File\"]]},\n  {um, nyqCurve[If[nyqFullRange, DCTDataImport`ImportEIS[nyqConcFile[tag, um]][\"Z\"], r[\"Spec\"][\"ZData\"]]]}];\nnyqDriftTrace[r_] := {r[\"Spec\"][\"FinishTimeS\"]/3600.,\n  nyqCurve[If[nyqFullRange, DCTDataImport`ImportEIS[r[\"File\"]][\"Z\"], r[\"Spec\"][\"ZData\"]]]};\n\n(* traces per panel: {colour key, curve} *)\nnyqTitr[tag_] := SortBy[nyqConcTrace /@ Select[concGoodSpecs, StringStartsQ[#File, tag <> \" \"] &], First];\nnyqDrift[e_]  := SortBy[nyqDriftTrace /@ Select[goodSpecs, electrodeOf[#File] === e &], First];\n\n(* lineSty is ONE directive (a Sequence here would splice extra arguments and stop the\n   pattern matching, leaving a huge unevaluated expression) *)\nnyqPanel[ttl_, traces_, cols_, {xMax_, yMax_}, lineSty_] := Module[{fg, bg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  ListLinePlot[traces[[All, 2]], Joined -> True, PlotMarkers -> None,\n    PlotStyle -> (Directive[#, lineSty] & /@ cols),\n    PlotTheme -> \"Default\", Frame -> True, Axes -> False, Background -> bg,\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., yMax, fg], None}, {DCTPlots`ThemeLinTicks[0., xMax, fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"Z' (k\\[CapitalOmega])\", 12, fg], Style[\"\\[Minus]Z'' (k\\[CapitalOmega])\", 12, fg]},\n    PlotLabel -> Style[ttl, 12, Bold, fg],\n    PlotRange -> {{0, xMax}, {0, yMax}}, PlotRangePadding -> {Scaled[0.02], Scaled[0.02]},\n    ImageSize -> 330, AspectRatio -> 0.85]];\n\n(* one row of panels with shared axis limits; panels = {{electrode tag, traces}, ...} *)\nnyqRowPanels[panels_, suffix_, colF_, lineSty_] := Module[{lim},\n  lim = 1.04 {Max[Flatten[panels[[All, 2, All, 2, All, 1]]]], Max[Flatten[panels[[All, 2, All, 2, All, 2]]]]};\n  Table[nyqPanel[DCTPlots`ElectrodeName[p[[1]]] <> suffix, p[[2]], colF /@ p[[2, All, 1]], lim, lineSty], {p, panels}]];\n\n(* Figure 1: titrations. A row with no spectra (e.g. its data directory is missing) is skipped. *)\nnyquistTitrationFigure[] := Module[{fg, rows, concs, concLeg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  rows = Select[Table[Select[Table[{s <> ToString[i], nyqTitr[s <> ToString[i]]}, {i, 3}], #[[2]] =!= {} &], {s, {\"A\", \"B\"}}], # =!= {} &];\n  If[Length[rows] < 2, Print[Style[\"Nyquist: only \" <> ToString[Length[rows]] <>\n    \" titration series has data; check concentrationDir / concentrationDir2 in the config cell.\", Italic, Darker[Red]]]];\n  concs = Union @ Flatten[rows[[All, All, 2, All, 1]]];\n  concLeg = LineLegend[Directive[nyqConcCol[#], AbsoluteThickness[2]] & /@ concs,\n    (ToString[Round[#]] <> \" \\[Mu]M\") & /@ concs, LegendLayout -> {\"Row\", 1}, LabelStyle -> Directive[fg, 11]];\n  Legended[Grid[nyqRowPanels[#, \", titration\", nyqConcCol, AbsoluteThickness[1.6]] & /@ rows, Spacings -> {0.6, 0.8}],\n    Placed[concLeg, Bottom]]];\n\n(* Figure 2: the drift run, coloured by time *)\nnyquistDriftFigure[] := Module[{fg, panels, timeLeg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  panels = Table[{\"B\" <> ToString[i], nyqDrift[\"B\" <> ToString[i]]}, {i, 3}];\n  timeLeg = BarLegend[{Function[h, nyqTimeCol[h]], {0, 24}}, \"Ticks\" -> {0, 6, 12, 18, 24},   (* option, not a 2nd argument: that would make a banded contour legend *)\n    LegendLabel -> Style[\"time at 1000 \\[Mu]M vancomycin (h)\", 11, fg], LegendLayout -> \"Row\",\n    LabelStyle -> Directive[fg, 11], LegendMarkerSize -> 260];\n  Legended[Grid[{nyqRowPanels[panels, \", drift\", nyqTimeCol, Directive[AbsoluteThickness[0.8], Opacity[0.7]]]}, Spacings -> {0.6, 0}],\n    Placed[timeLeg, Bottom]]];\n\nColumn[{nyquistTitrationFigure[], nyquistDriftFigure[]}, Spacings -> 2]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"56\" data-out-n=\"435\" data-sub-idx=\"21\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"82\" data-sub-start=\"66\" data-sub-end=\"66\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[435]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_1lzpdmogywaen.svg\" width=\"1341\" height=\"1371\" src=\"img/EAB_DCT_analysis/wl_1lzpdmogywaen.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* 5.3.2b  Nyquist plots in two figures: (1) the titrations, rows = series A and B, columns =\n   electrode 1, 2, 3; (2) the drift run, one panel per B electrode. All spectra of each\n   electrode/condition overlaid, shared axes within each row. Both are exported by 6.1 as\n   nyquist_titration and nyquist_drift. *)\nnyqFullRange = False;       (* True: full measured range from the raw files instead of the fit band *)\n\n(* concentration -> colour on ONE scale for both series: 0 uM violet, then log10 from 1 to 1000 uM *)\nnyqConcCol[c_] := ColorData[\"Rainbow\"][0.05 + 0.9 (Log10[Max[c, 0.3]] - Log10[0.3])/(3. - Log10[0.3])];\nnyqTimeCol[h_] := ColorData[\"Rainbow\"][0.05 + 0.9 Clip[h/24., {0, 1}]];\n\n(* {Z', -Z''} in kOhm for a spectrum record; full range re-imports the raw file *)\nnyqConcFile[tag_, um_] := Module[{dir = If[StringTake[tag, 1] === seriesOfDir[concentrationDir2], concentrationDir2, concentrationDir]},\n  First @ Select[FileNames[\"*.txt\", dir], concElec[#] == StringDrop[tag, 1] && concUM[#] == um &]];\nnyqCurve[z_] := Transpose[{Re[z], -Im[z]}]/1000.;\nnyqConcTrace[r_] := Module[{tag = StringTake[r[\"File\"], 2], um = N @ getLabelUM[r[\"File\"]]},\n  {um, nyqCurve[If[nyqFullRange, DCTDataImport`ImportEIS[nyqConcFile[tag, um]][\"Z\"], r[\"Spec\"][\"ZData\"]]]}];\nnyqDriftTrace[r_] := {r[\"Spec\"][\"FinishTimeS\"]/3600.,\n  nyqCurve[If[nyqFullRange, DCTDataImport`ImportEIS[r[\"File\"]][\"Z\"], r[\"Spec\"][\"ZData\"]]]};\n\n(* traces per panel: {colour key, curve} *)\nnyqTitr[tag_] := SortBy[nyqConcTrace /@ Select[concGoodSpecs, StringStartsQ[#File, tag <> \" \"] &], First];\nnyqDrift[e_]  := SortBy[nyqDriftTrace /@ Select[goodSpecs, electrodeOf[#File] === e &], First];\n\n(* lineSty is ONE directive (a Sequence here would splice extra arguments and stop the\n   pattern matching, leaving a huge unevaluated expression) *)\nnyqPanel[ttl_, traces_, cols_, {xMax_, yMax_}, lineSty_] := Module[{fg, bg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  ListLinePlot[traces[[All, 2]], Joined -> True, PlotMarkers -> None,\n    PlotStyle -> (Directive[#, lineSty] & /@ cols),\n    PlotTheme -> \"Default\", Frame -> True, Axes -> False, Background -> bg,\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., yMax, fg], None}, {DCTPlots`ThemeLinTicks[0., xMax, fg], None}},\n    FrameTicksStyle -> Directive[fg, 11], LabelStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"Z' (k\\[CapitalOmega])\", 12, fg], Style[\"\\[Minus]Z'' (k\\[CapitalOmega])\", 12, fg]},\n    PlotLabel -> Style[ttl, 12, Bold, fg],\n    PlotRange -> {{0, xMax}, {0, yMax}}, PlotRangePadding -> {Scaled[0.02], Scaled[0.02]},\n    ImageSize -> 330, AspectRatio -> 0.85]];\n\n(* one row of panels with shared axis limits; panels = {{electrode tag, traces}, ...} *)\nnyqRowPanels[panels_, suffix_, colF_, lineSty_] := Module[{lim},\n  lim = 1.04 {Max[Flatten[panels[[All, 2, All, 2, All, 1]]]], Max[Flatten[panels[[All, 2, All, 2, All, 2]]]]};\n  Table[nyqPanel[DCTPlots`ElectrodeName[p[[1]]] <> suffix, p[[2]], colF /@ p[[2, All, 1]], lim, lineSty], {p, panels}]];\n\n(* Figure 1: titrations. A row with no spectra (e.g. its data directory is missing) is skipped. *)\nnyquistTitrationFigure[] := Module[{fg, rows, concs, concLeg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  rows = Select[Table[Select[Table[{s <> ToString[i], nyqTitr[s <> ToString[i]]}, {i, 3}], #[[2]] =!= {} &], {s, {\"A\", \"B\"}}], # =!= {} &];\n  If[Length[rows] < 2, Print[Style[\"Nyquist: only \" <> ToString[Length[rows]] <>\n    \" titration series has data; check concentrationDir / concentrationDir2 in the config cell.\", Italic, Darker[Red]]]];\n  concs = Union @ Flatten[rows[[All, All, 2, All, 1]]];\n  concLeg = LineLegend[Directive[nyqConcCol[#], AbsoluteThickness[2]] & /@ concs,\n    (ToString[Round[#]] <> \" \\[Mu]M\") & /@ concs, LegendLayout -> {\"Row\", 1}, LabelStyle -> Directive[fg, 11]];\n  Legended[Grid[nyqRowPanels[#, \", titration\", nyqConcCol, AbsoluteThickness[1.6]] & /@ rows, Spacings -> {0.6, 0.8}],\n    Placed[concLeg, Bottom]]];\n\n(* Figure 2: the drift run, coloured by time *)\nnyquistDriftFigure[] := Module[{fg, panels, timeLeg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  panels = Table[{\"B\" <> ToString[i], nyqDrift[\"B\" <> ToString[i]]}, {i, 3}];\n  timeLeg = BarLegend[{Function[h, nyqTimeCol[h]], {0, 24}}, \"Ticks\" -> {0, 6, 12, 18, 24},   (* option, not a 2nd argument: that would make a banded contour legend *)\n    LegendLabel -> Style[\"time at 1000 \\[Mu]M vancomycin (h)\", 11, fg], LegendLayout -> \"Row\",\n    LabelStyle -> Directive[fg, 11], LegendMarkerSize -> 260];\n  Legended[Grid[{nyqRowPanels[panels, \", drift\", nyqTimeCol, Directive[AbsoluteThickness[0.8], Opacity[0.7]]]}, Spacings -> {0.6, 0}],\n    Placed[timeLeg, Bottom]]];\n\nColumn[{nyquistTitrationFigure[], nyquistDriftFigure[]}, Spacings -> 2]",
       "mime": "text/plain"
      }
     ],
     "id": "40130592-6d27-457c-a448-c0cde2b3c81a"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5.3.2c Admittance with the DCT fits, titration data\nThe measured admittance Y = 1/Z (points) against the DCT best fit 1/Z_fit (solid line, same colour), for every concentration of every titration electrode, over the analysis band the DCT fits (fMinHz to fMaxHz). Columns are electrodes 1, 2, 3; the rows are series A |Y|, series A phase, series B |Y|, series B phase, so 12 panels in all. Colour gives [vancomycin] on the same fixed scale as the Nyquist plots in 5.3.2b. The |Y| and phase scales are shared within each row; the phase scale is set by the fits and the data that lie within 5° of them, so one glitch point (Electrode B3 at 100 µM, 199.5 Hz, phase about −5°) falls outside its frame. The A3 100 µM curve sitting well above the others in |Y| is the outlier spectrum also visible in 5.3.2b and 5.3.3. Exported by 6.1 as `admittance_fits`.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 5.3.2c  Measured admittance (points) and DCT fit (lines, same colour), titration data only:\n   4 rows (A |Y|, A phase, B |Y|, B phase) x 3 columns (electrode 1, 2, 3). Y includes Rs:\n   Y = 1/Z and Y_fit = 1/Z_fit, both over the fitted band. Colours from nyqConcCol (5.3.2b). *)\n\n(* {conc, {{f, |Y| uS}...}, {{f, |Y_fit| uS}...}, {{f, phase deg}...}, {{f, phase_fit deg}...}} per spectrum *)\nadmTrace[r_] := Module[{s = r[\"Spec\"], f, y, yf},\n  f = s[\"FreqHz\"]; y = 1./s[\"ZData\"]; yf = 1./s[\"ZFit\"];\n  {N @ getLabelUM[r[\"File\"]],\n   Transpose[{f, 1*^6 Abs[y]}], Transpose[{f, 1*^6 Abs[yf]}],\n   Transpose[{f, (180./Pi) Arg[y]}], Transpose[{f, (180./Pi) Arg[yf]}]}];\nadmTraces[tag_] := SortBy[admTrace /@ Select[concGoodSpecs, StringStartsQ[#File, tag <> \" \"] &], First];\n\n(* one panel: which = \"mag\" (log-log) or \"phase\" (log-linear); points = data, lines = fit *)\nadmPanel[tr_, which_, ttl_, {yLo_, yHi_}, {fLo_, fHi_}] := Module[{fg, bg, cols, dIdx, fIdx, plotF, yTicks, yLab, common},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  cols = nyqConcCol /@ tr[[All, 1]];\n  {dIdx, fIdx} = If[which === \"mag\", {2, 3}, {4, 5}];\n  plotF  = If[which === \"mag\", ListLogLogPlot, ListLogLinearPlot];\n  yTicks = If[which === \"mag\", DCTPlots`ThemeLogTicks[yLo, yHi, fg], DCTPlots`ThemeLinTicks[yLo, yHi, fg]];\n  yLab   = If[which === \"mag\", Row[{\"|Y| (\\[Mu]S)\"}], Row[{\"phase of Y (\\[Degree])\"}]];\n  common = Sequence[PlotTheme -> \"Default\", Frame -> True, Axes -> False, Background -> bg,\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{yTicks, None}, {DCTPlots`ThemeLogTicks[fLo, fHi, fg], None}},\n    FrameTicksStyle -> Directive[fg, 10], LabelStyle -> Directive[fg, 11, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"Frequency (Hz)\", 11, fg], Style[yLab, 11, fg]},\n    PlotLabel -> Style[ttl, 11, Bold, fg],\n    PlotRange -> {{fLo, fHi}, {yLo, yHi}}, PlotRangePadding -> {Scaled[0.03], Scaled[0.04]},\n    ImageSize -> 320, AspectRatio -> 0.7];\n  Show[\n    plotF[tr[[All, fIdx]], Joined -> True, PlotMarkers -> None,\n      PlotStyle -> (Directive[#, AbsoluteThickness[1.3]] & /@ cols), common],\n    plotF[tr[[All, dIdx]], Joined -> False,\n      PlotStyle -> (Directive[#, PointSize[0.014]] & /@ cols), PlotMarkers -> None, common]]];\n\nadmittanceFitFigure[] := Module[{fg, series, rows, fAll, fLo, fHi, concs, concLeg, styleLeg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  (* series with data; each = {letter, {{tag, traces} x 3}} *)\n  series = Select[Table[{s, Select[Table[{s <> ToString[i], admTraces[s <> ToString[i]]}, {i, 3}], #[[2]] =!= {} &]}, {s, {\"A\", \"B\"}}], #[[2]] =!= {} &];\n  If[Length[series] < 2, Print[Style[\"Admittance fits: only \" <> ToString[Length[series]] <>\n    \" titration series has data; check concentrationDir / concentrationDir2.\", Italic, Darker[Red]]]];\n  fAll = Flatten[series[[All, 2, All, 2, All, 2, All, 1]]];\n  {fLo, fHi} = MinMax[fAll];\n  rows = Flatten[Table[Module[{panels = ser[[2]], magR, phR},\n      magR = MinMax[Flatten[Join[panels[[All, 2, All, 2, All, 2]], panels[[All, 2, All, 3, All, 2]]]]];\n      (* phase scale from the fits plus data within 5 deg of their own fit, so a single\n         glitch point (e.g. B3 100 uM at 199.5 Hz, about -5 deg) cannot squash the row *)\n      phR  = MinMax[Flatten[Table[Module[{d = t[[4, All, 2]], ft = t[[5, All, 2]]},\n          Join[ft, Pick[d, Thread[Abs[d - ft] < 5.]]]], {p, panels}, {t, p[[2]]}]]];\n      phR  = {Floor[phR[[1]] - 1, 5], Ceiling[phR[[2]] + 1, 5]};\n      {Table[admPanel[p[[2]], \"mag\", DCTPlots`ElectrodeName[p[[1]]] <> \", |Y|\", {0.9, 1.1} magR, {fLo, fHi}], {p, panels}],\n       Table[admPanel[p[[2]], \"phase\", DCTPlots`ElectrodeName[p[[1]]] <> \", phase\", phR, {fLo, fHi}], {p, panels}]}],\n    {ser, series}], 1];\n  concs = Union @ Flatten[series[[All, 2, All, 2, All, 1]]];\n  concLeg = LineLegend[Directive[nyqConcCol[#], AbsoluteThickness[2]] & /@ concs,\n    (ToString[Round[#]] <> \" \\[Mu]M\") & /@ concs, LegendLayout -> {\"Row\", 1}, LabelStyle -> Directive[fg, 11]];\n  styleLeg = Row[{Graphics[{fg, PointSize[Large], Point[{0, 0}]}, ImageSize -> 10], \" measured   \",\n    Graphics[{fg, AbsoluteThickness[1.5], Line[{{0, 0}, {1, 0}}]}, ImageSize -> {22, 8}], \" DCT fit\"},\n    BaseStyle -> {fg, 11, FontFamily -> \"Arial\"}];\n  Legended[Grid[rows, Spacings -> {0.6, 0.6}], Placed[Column[{concLeg, styleLeg}, Alignment -> Center], Bottom]]];\n\nadmittanceFitFigure[]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"57\" data-out-n=\"440\" data-sub-idx=\"7\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"84\" data-sub-start=\"61\" data-sub-end=\"61\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[440]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_yc90nb5pkg3m.svg\" width=\"1301\" height=\"1419\" src=\"img/EAB_DCT_analysis/wl_yc90nb5pkg3m.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* 5.3.2c  Measured admittance (points) and DCT fit (lines, same colour), titration data only:\n   4 rows (A |Y|, A phase, B |Y|, B phase) x 3 columns (electrode 1, 2, 3). Y includes Rs:\n   Y = 1/Z and Y_fit = 1/Z_fit, both over the fitted band. Colours from nyqConcCol (5.3.2b). *)\n\n(* {conc, {{f, |Y| uS}...}, {{f, |Y_fit| uS}...}, {{f, phase deg}...}, {{f, phase_fit deg}...}} per spectrum *)\nadmTrace[r_] := Module[{s = r[\"Spec\"], f, y, yf},\n  f = s[\"FreqHz\"]; y = 1./s[\"ZData\"]; yf = 1./s[\"ZFit\"];\n  {N @ getLabelUM[r[\"File\"]],\n   Transpose[{f, 1*^6 Abs[y]}], Transpose[{f, 1*^6 Abs[yf]}],\n   Transpose[{f, (180./Pi) Arg[y]}], Transpose[{f, (180./Pi) Arg[yf]}]}];\nadmTraces[tag_] := SortBy[admTrace /@ Select[concGoodSpecs, StringStartsQ[#File, tag <> \" \"] &], First];\n\n(* one panel: which = \"mag\" (log-log) or \"phase\" (log-linear); points = data, lines = fit *)\nadmPanel[tr_, which_, ttl_, {yLo_, yHi_}, {fLo_, fHi_}] := Module[{fg, bg, cols, dIdx, fIdx, plotF, yTicks, yLab, common},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  cols = nyqConcCol /@ tr[[All, 1]];\n  {dIdx, fIdx} = If[which === \"mag\", {2, 3}, {4, 5}];\n  plotF  = If[which === \"mag\", ListLogLogPlot, ListLogLinearPlot];\n  yTicks = If[which === \"mag\", DCTPlots`ThemeLogTicks[yLo, yHi, fg], DCTPlots`ThemeLinTicks[yLo, yHi, fg]];\n  yLab   = If[which === \"mag\", Row[{\"|Y| (\\[Mu]S)\"}], Row[{\"phase of Y (\\[Degree])\"}]];\n  common = Sequence[PlotTheme -> \"Default\", Frame -> True, Axes -> False, Background -> bg,\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{yTicks, None}, {DCTPlots`ThemeLogTicks[fLo, fHi, fg], None}},\n    FrameTicksStyle -> Directive[fg, 10], LabelStyle -> Directive[fg, 11, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"Frequency (Hz)\", 11, fg], Style[yLab, 11, fg]},\n    PlotLabel -> Style[ttl, 11, Bold, fg],\n    PlotRange -> {{fLo, fHi}, {yLo, yHi}}, PlotRangePadding -> {Scaled[0.03], Scaled[0.04]},\n    ImageSize -> 320, AspectRatio -> 0.7];\n  Show[\n    plotF[tr[[All, fIdx]], Joined -> True, PlotMarkers -> None,\n      PlotStyle -> (Directive[#, AbsoluteThickness[1.3]] & /@ cols), common],\n    plotF[tr[[All, dIdx]], Joined -> False,\n      PlotStyle -> (Directive[#, PointSize[0.014]] & /@ cols), PlotMarkers -> None, common]]];\n\nadmittanceFitFigure[] := Module[{fg, series, rows, fAll, fLo, fHi, concs, concLeg, styleLeg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  (* series with data; each = {letter, {{tag, traces} x 3}} *)\n  series = Select[Table[{s, Select[Table[{s <> ToString[i], admTraces[s <> ToString[i]]}, {i, 3}], #[[2]] =!= {} &]}, {s, {\"A\", \"B\"}}], #[[2]] =!= {} &];\n  If[Length[series] < 2, Print[Style[\"Admittance fits: only \" <> ToString[Length[series]] <>\n    \" titration series has data; check concentrationDir / concentrationDir2.\", Italic, Darker[Red]]]];\n  fAll = Flatten[series[[All, 2, All, 2, All, 2, All, 1]]];\n  {fLo, fHi} = MinMax[fAll];\n  rows = Flatten[Table[Module[{panels = ser[[2]], magR, phR},\n      magR = MinMax[Flatten[Join[panels[[All, 2, All, 2, All, 2]], panels[[All, 2, All, 3, All, 2]]]]];\n      (* phase scale from the fits plus data within 5 deg of their own fit, so a single\n         glitch point (e.g. B3 100 uM at 199.5 Hz, about -5 deg) cannot squash the row *)\n      phR  = MinMax[Flatten[Table[Module[{d = t[[4, All, 2]], ft = t[[5, All, 2]]},\n          Join[ft, Pick[d, Thread[Abs[d - ft] < 5.]]]], {p, panels}, {t, p[[2]]}]]];\n      phR  = {Floor[phR[[1]] - 1, 5], Ceiling[phR[[2]] + 1, 5]};\n      {Table[admPanel[p[[2]], \"mag\", DCTPlots`ElectrodeName[p[[1]]] <> \", |Y|\", {0.9, 1.1} magR, {fLo, fHi}], {p, panels}],\n       Table[admPanel[p[[2]], \"phase\", DCTPlots`ElectrodeName[p[[1]]] <> \", phase\", phR, {fLo, fHi}], {p, panels}]}],\n    {ser, series}], 1];\n  concs = Union @ Flatten[series[[All, 2, All, 2, All, 1]]];\n  concLeg = LineLegend[Directive[nyqConcCol[#], AbsoluteThickness[2]] & /@ concs,\n    (ToString[Round[#]] <> \" \\[Mu]M\") & /@ concs, LegendLayout -> {\"Row\", 1}, LabelStyle -> Directive[fg, 11]];\n  styleLeg = Row[{Graphics[{fg, PointSize[Large], Point[{0, 0}]}, ImageSize -> 10], \" measured   \",\n    Graphics[{fg, AbsoluteThickness[1.5], Line[{{0, 0}, {1, 0}}]}, ImageSize -> {22, 8}], \" DCT fit\"},\n    BaseStyle -> {fg, 11, FontFamily -> \"Arial\"}];\n  Legended[Grid[rows, Spacings -> {0.6, 0.6}], Placed[Column[{concLeg, styleLeg}, Alignment -> Center], Bottom]]];\n\nadmittanceFitFigure[]",
       "mime": "text/plain"
      }
