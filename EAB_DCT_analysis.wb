  {
   "kind": 1,
   "value": "### 4a.6 k-range definitions",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* k ranges for peak tracking — each window captures a distinct electron-transfer population *)\nkPeakRanges = {{10., 100.}, {100., 500.}};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 4a.7 k-peak vs time",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* k_peak vs time — one panel per k-range, one trace per electrode *)\nDCTPlots`PlotKPeakVsTime[goodSpecs, kPeakRanges]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"319475\" data-output-id=\"94\" data-out-n=\"407\" data-sub-idx=\"1\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"54\" data-sub-start=\"1\" data-sub-end=\"1\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[407]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_9y7uaq87r4a4.svg\" src=\"img/EAB_DCT_analysis/wl_9y7uaq87r4a4.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
