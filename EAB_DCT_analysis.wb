       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"375116\" data-output-id=\"202\" data-out-n=\"1150\" data-sub-idx=\"1\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"47\" data-sub-start=\"1\" data-sub-end=\"1\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1150]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\bobla\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_m1b6f9cf3ytd.svg\" src=\"img/EAB_DCT_analysis/wl_m1b6f9cf3ytd.svg\"/></div></div>",
