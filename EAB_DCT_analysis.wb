     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"289054\" data-output-id=\"277\" data-out-n=\"1408\" data-sub-idx=\"1\" data-output-format=\"Auto\" data-output-is-graphics=\"1\" data-cell-idx=\"30\" data-sub-start=\"1\" data-sub-end=\"1\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1408]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1iu88foes3wlh.svg\" src=\"img/EAB_DCT_analysis/wl_1iu88foes3wlh.svg\"/></div></div>",
