    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzps6r9-0gfpts2\" data-page-width-em=\"52\" data-latex-b64=\"MTM5\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">139</span></span></span></span></span></div></div><span class=\"wl-ps\"> / </span><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzps6ra-0k45nme\" data-page-width-em=\"52\" data-latex-b64=\"NDU4\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">458</span></span></span></span></span></div></div><span class=\"wl-ps\"> files pass Lin-KK overall.</span></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula] /[formula] files pass Lin-KK overall.",
       "mime": "text/plain"
      }
     ],
     "id": "28069607-814f-4ab2-80b2-0c157e069058"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzps6rh-4vzofaa\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dGNvbG9yeyMwMGZmMDB9e1x0ZXh0e1JlcCBmaWxlIChFMVxfRUlTXF8oMCkudHh0KTogIFJNUyBSZSA9IDEuMjZcJSwgIEltID0gMC44MlwlICDinJMgT0t9fX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.06em;vertical-align:-0.31em;\"></span><span class=\"mord text\" style=\"color:#00ff00;\"><span class=\"mord\" style=\"color:#00ff00;\">Rep file (E1_EIS_(0).txt): RMS Re = 1.26%, Im = 0.82% ✓ OK</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "ea795f80-edb5-4307-b94b-04bccbb632fc"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"118457\" data-output-id=\"2\" data-out-n=\"43\" data-sub-idx=\"17\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"10\" data-sub-start=\"27\" data-sub-end=\"27\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[43]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1ix0xfgdhq8gr.svg\" src=\"img/EAB_DCT_analysis/wl_1ix0xfgdhq8gr.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Section 1 parameters *)\nkkResidualThreshold = 0.02;  (* point-by-point |residual|/|Y| threshold; try 0.05 if fMinHz is too high *)\nkkFMinPercentile    = 50;    (* percentile of fMin distribution across files; 50 = median *)\n\n(* Representative file index — residuals plot only; fMinHz comes from the full population *)\nrepFileIdx = 1;\n\n(* Load drift files (every debugDecimationFactor-th file, for fast debugging) *)\ndriftFiles = sortFiles[FileNames[\"*.txt\", dataDir, Infinity]][[;; ;; debugDecimationFactor]];\nPrint[\"Found \", Length[driftFiles], \" drift files (every \", debugDecimationFactor, \"th) in \", FileNameTake[dataDir]];\n\n(* Run linearized Kramers-Kronig on every file — basis for population-level fMinHz *)\nPrint[\"Running Lin-KK on all files...\"];\nkkAllResults = Map[DCTKKCheck`KKCheck[DCTDataImport`ImportEIS[#]] &, driftFiles];\nnPass = Count[kkAllResults, _?(#[\"OK\"] &)];\nPrint[nPass, \" / \", Length[kkAllResults], \" files pass Lin-KK overall.\"];\n\n(* Residuals plot for the representative file *)\nkkRep   = kkAllResults[[repFileIdx]];\nrepFile = driftFiles[[repFileIdx]];\nPrint[Style[\n  \"Rep file (\" <> FileNameTake[repFile] <> \"):  RMS Re = \" <>\n  ToString[NumberForm[100. kkRep[\"RMSRe\"], {4,2}]] <> \"%,  Im = \" <>\n  ToString[NumberForm[100. kkRep[\"RMSIm\"], {4,2}]] <> \"%  \" <>\n  If[kkRep[\"OK\"], \"\\[Checkmark] OK\", \"\\[Times] FAIL\"],\n  Bold, If[kkRep[\"OK\"], Darker[Green], Red], 13\n]];\nDCTPlots`PlotKKResiduals[kkRep]",
       "mime": "text/plain"
      }
     ],
     "id": "ba336627-2343-4340-a667-b389e0be463d"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 1.2 KK residuals",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Kramers-Kronig-valid lower bound for every file, using the threshold from params *)\nkkMins = Map[First[DCTKKCheck`KKValidFreqRange[#, kkResidualThreshold]] &, kkAllResults];\n\n(* Percentile table — inspect before accepting the automatic fMinHz *)\nPrint[Style[\"Lin-KK fMin distribution (threshold = \" <> ToString[100 kkResidualThreshold] <> \"%):\", Bold, 13]];\nPrint[Grid[\n  Prepend[\n    {ToString[#] <> \"th\", NumberForm[Quantile[kkMins, #/100.], {5,3}]} & /@ {0, 25, 50, 75, 90, 95, 100},\n    {Style[\"Percentile\", Bold], Style[\"fMin (Hz)\", Bold]}\n  ],\n  Frame -> All, Alignment -> {Right, Center}, Spacings -> {2, 0.8}\n]];\n\n(* Histogram of the per-file valid lower bound — outliers show up as a long right tail *)\nDCTPlots`PlotKKFMinHistogram[kkMins]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzps7gq-8rvd8ph\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dHtMaW4tS0sgZk1pbiBkaXN0cmlidXRpb24gKHRocmVzaG9sZCA9IDIuXCUpOn19\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord text\"><span class=\"mord\">Lin-KK fMin distribution (threshold = 2.%):</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
