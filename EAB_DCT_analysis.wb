  {
   "kind": 1,
   "value": "### 5a.2 Linear-linear plot",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Linear-linear plot \\[Dash] includes 0 \\[Mu]M data the log-x plot can't show.\n   Defined as a function so Section 6 can re-render it white in the Publication\n   block (it reads DCTPlots`$DCTTheme at call time; dark on screen otherwise).\n   No legend: data are one translucent cloud (overlapping points darken), and the\n   two model curves are labelled directly \\[Dash] 3-state above, 4-state below. *)\nbiophysLinearPlot[] := Module[\n  {pub, fg, bg, ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts,\n   ptStyle, gray3, heroRGB, heroCol, c3a, f3a, c4a, f4a},\n  pub = (DCTPlots`$DCTTheme === \"Publication\");\n  fg  = If[pub, Black, White];\n  bg  = If[pub, White, GrayLevel[0.12]];\n\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  ptStyle = Directive[RGBColor[0.2, 0.45, 0.85], Opacity[0.45]];                          (* translucent: overlaps darken *)\n  gray3   = Directive[Gray, Dashed, AbsoluteThickness[2.2]];        (* 3-state *)\n  heroRGB = RGBColor[0.95, 0.55, 0.15];\n  heroCol = Directive[heroRGB, AbsoluteThickness[2.8]];             (* 4-state = hero *)\n\n  (* label anchor points on each curve *)\n  c3a = cMax * 0.76; f3a = N[m3 /. DCTBiophysics`conc -> c3a];\n  c4a = cMax * 0.36; f4a = N[m4 /. DCTBiophysics`conc -> c4a];\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    Joined -> Join[ConstantArray[False, Length[concElectrodes]], {True, True}],\n    PlotMarkers -> Join[ConstantArray[{\"\\[FilledCircle]\", 9}, Length[concElectrodes]], {None, None}],\n    PlotStyle -> Join[ConstantArray[ptStyle, Length[concElectrodes]], {gray3, heroCol}],\n    PlotTheme -> \"Default\",\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., fg], None}, {DCTPlots`ThemeLinTicks[0., cMax * 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 12],\n    Frame -> True, Axes -> False, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Fraction folded\", 14, fg]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.03],\n    ImageSize -> 580, AspectRatio -> 0.72,\n    Epilog -> {\n      (* 3-state: text ABOVE, thin leader down to the dashed curve *)\n      Gray, AbsoluteThickness[1.], Line[{{c3a, Min[f3a + 0.13, 0.9]}, {c3a, f3a + 0.015}}],\n      Text[Style[\"3-state model\", Gray, 12, FontFamily -> \"Arial\"], {c3a, Min[f3a + 0.155, 0.93]}],\n      (* 4-state: text BELOW, arrow UP to the solid curve *)\n      heroRGB, Arrowheads[0.028], AbsoluteThickness[1.4], Arrow[{{c4a, Max[f4a - 0.17, 0.1]}, {c4a, f4a - 0.015}}],\n      Text[Style[\"4-state model\", heroRGB, 12, FontFamily -> \"Arial\"], {c4a, Max[f4a - 0.2, 0.06]}]\n    }\n  ]\n];\n\nbiophysLinearPlot[]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"63\" data-out-n=\"493\" data-sub-idx=\"2\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"98\" data-sub-start=\"57\" data-sub-end=\"57\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[493]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_6szhwc70t38h.svg\" width=\"773\" height=\"573\" src=\"img/EAB_DCT_analysis/wl_6szhwc70t38h.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Linear-linear plot \\[Dash] includes 0 \\[Mu]M data the log-x plot can't show.\n   Defined as a function so Section 6 can re-render it white in the Publication\n   block (it reads DCTPlots`$DCTTheme at call time; dark on screen otherwise).\n   No legend: data are one translucent cloud (overlapping points darken), and the\n   two model curves are labelled directly \\[Dash] 3-state above, 4-state below. *)\nbiophysLinearPlot[] := Module[\n  {pub, fg, bg, ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts,\n   ptStyle, gray3, heroRGB, heroCol, c3a, f3a, c4a, f4a},\n  pub = (DCTPlots`$DCTTheme === \"Publication\");\n  fg  = If[pub, Black, White];\n  bg  = If[pub, White, GrayLevel[0.12]];\n\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  ptStyle = Directive[RGBColor[0.2, 0.45, 0.85], Opacity[0.45]];                          (* translucent: overlaps darken *)\n  gray3   = Directive[Gray, Dashed, AbsoluteThickness[2.2]];        (* 3-state *)\n  heroRGB = RGBColor[0.95, 0.55, 0.15];\n  heroCol = Directive[heroRGB, AbsoluteThickness[2.8]];             (* 4-state = hero *)\n\n  (* label anchor points on each curve *)\n  c3a = cMax * 0.76; f3a = N[m3 /. DCTBiophysics`conc -> c3a];\n  c4a = cMax * 0.36; f4a = N[m4 /. DCTBiophysics`conc -> c4a];\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    Joined -> Join[ConstantArray[False, Length[concElectrodes]], {True, True}],\n    PlotMarkers -> Join[ConstantArray[{\"\\[FilledCircle]\", 9}, Length[concElectrodes]], {None, None}],\n    PlotStyle -> Join[ConstantArray[ptStyle, Length[concElectrodes]], {gray3, heroCol}],\n    PlotTheme -> \"Default\",\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., fg], None}, {DCTPlots`ThemeLinTicks[0., cMax * 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 12],\n    Frame -> True, Axes -> False, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Fraction folded\", 14, fg]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.03],\n    ImageSize -> 580, AspectRatio -> 0.72,\n    Epilog -> {\n      (* 3-state: text ABOVE, thin leader down to the dashed curve *)\n      Gray, AbsoluteThickness[1.], Line[{{c3a, Min[f3a + 0.13, 0.9]}, {c3a, f3a + 0.015}}],\n      Text[Style[\"3-state model\", Gray, 12, FontFamily -> \"Arial\"], {c3a, Min[f3a + 0.155, 0.93]}],\n      (* 4-state: text BELOW, arrow UP to the solid curve *)\n      heroRGB, Arrowheads[0.028], AbsoluteThickness[1.4], Arrow[{{c4a, Max[f4a - 0.17, 0.1]}, {c4a, f4a - 0.015}}],\n      Text[Style[\"4-state model\", heroRGB, 12, FontFamily -> \"Arial\"], {c4a, Max[f4a - 0.2, 0.06]}]\n    }\n  ]\n];\n\nbiophysLinearPlot[]",
       "mime": "text/plain"
      }
     ],
     "id": "ca5fa1a0-304a-4cf2-9f17-01045ed21979"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5a.3 Goodness of fit (R², RMSD)\nR², adjusted R², and RMSD for the 3-state and 4-state fraction-folded fits, with AIC / BIC for model selection. Metrics come straight from the `NonlinearModelFit` objects, computed on all pooled fraction-folded data (every electrode, including the 0 µM baseline). Adjusted R² and AIC / BIC penalise the 4-state model's extra parameter (NF).",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 5a.3  Goodness of fit for the two fraction-folded models.\n   R^2, adjusted R^2 and RMSD for the 3-state and 4-state fits, plus AIC / BIC for model\n   selection.  Metrics come straight from the NonlinearModelFit objects, computed on all\n   pooled fraction-folded data (every electrode, including the 0 \\[Mu]M baseline).  Higher\n   adjusted R^2 and lower AIC/BIC favour a model; adjusted R^2 and AIC/BIC penalise the\n   4-state model's extra parameter (NF).  Theme-aware. *)\n\ngofTable[] := Module[\n  {fg, bg, f3, f4, n, gof, hdr, rows, fmt},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  f3 = fitResult[\"Model3\", \"FitObject\"]; f4 = fitResult[\"Model4\", \"FitObject\"];\n  n  = Length[allPts];\n\n  fmt[x_, d_] := NumberForm[N[x], {7, d}];\n  gof[f_, k_] := {fmt[f[\"RSquared\"], 4], fmt[f[\"AdjustedRSquared\"], 4],\n     fmt[Sqrt[Mean[f[\"FitResiduals\"]^2]], 4], k, fmt[f[\"AIC\"], 1], fmt[f[\"BIC\"], 1]};\n\n  hdr  = Style[#, Bold, fg, 12] & /@ {\"Model\", Superscript[\"R\", 2], Row[{\"adj. \", Superscript[\"R\", 2]}], \"RMSD\", \"k\", \"AIC\", \"BIC\"};\n  rows = {Prepend[gof[f3, 2], Style[\"3-state\", fg, 12]],\n          Prepend[gof[f4, 3], Style[\"4-state\", fg, 12]]};\n\n  Column[{\n    Style[Row[{\"Pooled fraction-folded fit \\[Dash] n = \", n, \" points (all electrodes, incl. 0 \\[Mu]M)\"}], fg, 11],\n    Grid[Prepend[rows, hdr],\n      Frame -> All, FrameStyle -> Directive[fg, Opacity[0.25]],\n      Alignment -> {{Left, Right, Right, Right, Center, Right, Right}, Center},\n      Spacings -> {1.7, 1.}, BaseStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n      Background -> {None, {Directive[fg, Opacity[0.08]], None, None}}]\n  }, Spacings -> 0.9, Alignment -> Left]\n];\n\n(* favoured-model one-liner.  NonlinearModelFit emits FittedModel::constr for any\n   box-constrained fit; here KS, KD and NF all sit well inside their bounds, so the\n   AIC/BIC are valid \\[Dash] suppress the precautionary message for a clean readout. *)\nQuiet[\n  With[{f3 = fitResult[\"Model3\", \"FitObject\"], f4 = fitResult[\"Model4\", \"FitObject\"]},\n    Print[Style[Row[{\"\\[FilledSmallCircle] Lower AIC favours the \",\n      If[f4[\"AIC\"] < f3[\"AIC\"], \"4-state\", \"3-state\"], \" model (\\[CapitalDelta]AIC = \",\n      NumberForm[Abs[f4[\"AIC\"] - f3[\"AIC\"]], {5, 1}], \");  adj. \", Superscript[\"R\", 2], \" = \",\n      NumberForm[f3[\"AdjustedRSquared\"], {4, 3}], \" (3-state) vs \",\n      NumberForm[f4[\"AdjustedRSquared\"], {4, 3}], \" (4-state).\"}], 12]]],\n  FittedModel::constr];\n\nQuiet[gofTable[], FittedModel::constr]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"64\" data-latex-b64=\"XHRleHR7JFxidWxsZXQkIExvd2VyIEFJQyBmYXZvdXJzIHRoZSB9XHRleHR7NC1zdGF0ZX1cdGV4dHsgbW9kZWwgKCRcRGVsdGEkQUlDID0gfVx0ZXh0ezEwOC4xfVx0ZXh0eyk7ICBhZGouIH1cdGV4dHtSfV4yXHRleHR7ID0gfVx0ZXh0ezAuOTcyfVx0ZXh0eyAoMy1zdGF0ZSkgdnMgfVx0ZXh0ezAuOTk4fVx0ZXh0eyAoNC1zdGF0ZSkufQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.1373em;vertical-align:-0.25em;\"></span><span class=\"mord text\"><span class=\"mord\">∙</span><span class=\"mord\"> Lower AIC favours the </span></span><span class=\"mord text\"><span class=\"mord\">4-state</span></span><span class=\"mord text\"><span class=\"mord\"> model (ΔAIC = </span></span><span class=\"mord text\"><span class=\"mord\">108.1</span></span><span class=\"mord text\"><span class=\"mord\">); adj. </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">R</span></span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8873em;\"><span style=\"top:-3.1362em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.972</span></span><span class=\"mord text\"><span class=\"mord\"> (3-state) vs </span></span><span class=\"mord text\"><span class=\"mord\">0.998</span></span><span class=\"mord text\"><span class=\"mord\"> (4-state).</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "3c51b40e-1182-48d3-9ec4-84a9a5f89804"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"64\" data-out-n=\"496\" data-sub-idx=\"4\" data-output-format=\"SVGT\" data-output-is-graphics=\"0\" data-cell-idx=\"100\" data-sub-start=\"44\" data-sub-end=\"44\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[496]=</span></div><div class=\"wl-output-content\"><img class=\"vscode-wolfram-png-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_3y5gv4qa6t29.png\" width=\"752\" height=\"206\" src=\"img/EAB_DCT_analysis/wl_3y5gv4qa6t29.png\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      }
