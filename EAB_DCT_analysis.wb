      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq72namc-iqai4ir\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dHszLXN0YXRlIG1vZGVsfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">3-state model</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq72name-kxl602j\" data-page-width-em=\"52\" data-latex-b64=\"XHRleHR7ICB9XHRleHR7S31fe1x0ZXh0e1N9fVx0ZXh0eyA9IH1cdGV4dHswLjE5MX1cdGV4dHsgICAgIH1cdGV4dHtLfV97XHRleHR7RH19XHRleHR7ID0gfVx0ZXh0ezYzLjF9XHRleHR7ICRcbXUkTX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">S</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.191</span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">D</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">63.1</span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq72namg-3yhu27y\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dHs0LXN0YXRlIG1vZGVsfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">4-state model</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq72nami-fn1ge66\" data-page-width-em=\"52\" data-latex-b64=\"XHRleHR7ICB9XHRleHR7S31fe1x0ZXh0e1N9fVx0ZXh0eyA9IH1cdGV4dHswLjE0MH1cdGV4dHsgICAgIH1cdGV4dHtLfV97XHRleHR7RH19XHRleHR7ID0gfVx0ZXh0ezcuOX1cdGV4dHsgJFxtdSRNfVx0ZXh0eyAgICAgTkYgPSB9XHRleHR7MC4zNH0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">S</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.140</span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">D</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">7.9</span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M</span></span><span class=\"mord text\"><span class=\"mord\"> NF = </span></span><span class=\"mord text\"><span class=\"mord\">0.34</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula][formula][formula][formula]",
       "mime": "text/plain"
      }
     ],
     "id": "d40f368d-8e82-4fe4-a598-61a9dbf41998"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"319475\" data-output-id=\"46\" data-out-n=\"171\" data-sub-idx=\"12\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"37\" data-sub-start=\"26\" data-sub-end=\"81\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[171]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1xslvu78tgcbt.svg\" src=\"img/EAB_DCT_analysis/wl_1xslvu78tgcbt.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Biophysical model fits using the mechanistic 3-state and 4-state kinetic models.\n   Data: {conc µM, ff} across all electrodes, positive concentrations only. *)\n\n(* --- model equations --- *)\nPrint[Style[\"3-state model  (U \\[LeftRightArrow] F \\[LeftRightArrow] B)\", Bold, 13]];\nPrint[Row[{\"  \", Subscript[\"f\",\"f\"], \" = \", DCTBiophysics`$FF3State}]];\nPrint[Style[\"4-state model  (U \\[LeftRightArrow] F \\[LeftRightArrow] B,  NF non-folding)\", Bold, 13]];\nPrint[Row[{\"  \", Subscript[\"f\",\"f\"], \" = \", DCTBiophysics`$FF4State}]];\nPrint[\"\"];\n\nallPts = Flatten[ffPerElectrode[[All, posIdx]], 1];\n\nfitResult = DCTBiophysics`FitFoldedFraction[allPts];\n\n(* --- fit parameters --- *)\nModule[{p3 = fitResult[\"Model3\"], p4 = fitResult[\"Model4\"]},\n  Print[Style[\"3-state model\", Bold, 13]];\n  Print[Row[{\"  \", Subscript[\"K\",\"S\"], \" = \", NumberForm[p3[\"KS\"], {4,3}],\n             \"     \", Subscript[\"K\",\"D\"], \" = \", NumberForm[p3[\"KD\"], {6,1}], \" \\[Mu]M\"}]];\n  Print[Style[\"4-state model\", Bold, 13]];\n  Print[Row[{\"  \", Subscript[\"K\",\"S\"], \" = \", NumberForm[p4[\"KS\"], {4,3}],\n             \"     \", Subscript[\"K\",\"D\"], \" = \", NumberForm[p4[\"KD\"], {6,1}], \" \\[Mu]M\",\n             \"     NF = \", NumberForm[p4[\"NF\"], {3,2}]}]]\n];\n\n(* --- plot --- *)\nModule[{ks3, kd3, ks4, kd4, nf4, m3, m4,\n        tMin, tMax, c3pts, c4pts,\n        darkBg, fgStyle, eCols, modelStyles},\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n\n  (* substitute numeric params into public symbolic expressions *)\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4,\n                                    DCTBiophysics`NF -> nf4};\n\n  tMin = Log10[Min[allPts[[All,1]]] * 0.4];\n  tMax = Log10[Max[allPts[[All,1]]] * 3.];\n\n  (* sample at 200 log-spaced points as {µM, ff} — same coordinate space as data *)\n  c3pts = Table[{10^t, N[m3 /. DCTBiophysics`conc -> 10^t]}, {t, tMin, tMax, (tMax-tMin)/200}];\n  c4pts = Table[{10^t, N[m4 /. DCTBiophysics`conc -> 10^t]}, {t, tMin, tMax, (tMax-tMin)/200}];\n\n  darkBg     = GrayLevel[0.12];\n  fgStyle    = Directive[White, AbsoluteThickness[1.1]];\n  eCols      = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ {1,2,3};\n  modelStyles = {\n    Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]],\n    Directive[White, AbsoluteThickness[2.]]\n  };\n\n  ListLinePlot[\n    Join[ffPerElectrode[[All, posIdx]], {c3pts, c4pts}],\n    ScalingFunctions -> {\"Log10\", None},\n    Joined -> True,\n    PlotMarkers -> {{Automatic,8},{Automatic,8},{Automatic,8}, None, None},\n    PlotStyle -> Join[eCols, modelStyles],\n    Frame -> True, Axes -> False, Background -> darkBg, FrameStyle -> fgStyle,\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Ligand] (\\[Mu]M)\", 14, White],\n                   Style[\"Fraction folded\", 14, White]},\n    PlotRange -> {{0.8, 1200}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, {\"E1\",\"E2\",\"E3\"},\n      LabelStyle -> Directive[White, 12], Background -> darkBg,\n      LegendFunction -> (Framed[#, Background->darkBg,\n                           FrameStyle->fgStyle]&)], Right],\n    Epilog -> {\n      {Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]],\n       Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", GrayLevel[0.65], 11, FontFamily -> \"Arial\"],\n           Scaled[{0.79, 0.91}]],\n      {Directive[White, AbsoluteThickness[2.]],\n       Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", White, 11, FontFamily -> \"Arial\"],\n           Scaled[{0.79, 0.83}]]\n    }\n  ]\n]",
       "mime": "text/plain"
      }
     ],
     "id": "cbb9af7b-d87d-4b54-8648-b3868d4879ef"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5a.2 Linear-linear plot",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Linear-linear plot — includes 0 µM data that the log-x plot cannot show *)\nModule[{ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts,\n        darkBg, fgStyle, eCols, modelStyles},\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4,\n                                    DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  darkBg     = GrayLevel[0.12];\n  fgStyle    = Directive[White, AbsoluteThickness[1.1]];\n  eCols      = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ {1,2,3};\n  modelStyles = {\n    Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]],\n    Directive[White, AbsoluteThickness[2.]]\n  };\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    Joined -> True,\n    PlotMarkers -> {{Automatic,8},{Automatic,8},{Automatic,8}, None, None},\n    PlotStyle -> Join[eCols, modelStyles],\n    Frame -> True, Axes -> False, Background -> darkBg, FrameStyle -> fgStyle,\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Ligand] (\\[Mu]M)\", 14, White],\n                   Style[\"Fraction folded\", 14, White]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, {\"E1\",\"E2\",\"E3\"},\n      LabelStyle -> Directive[White, 12], Background -> darkBg,\n      LegendFunction -> (Framed[#, Background->darkBg,\n                           FrameStyle->fgStyle]&)], Right],\n    Epilog -> {\n      {Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]],\n       Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", GrayLevel[0.65], 11, FontFamily -> \"Arial\"],\n           Scaled[{0.79, 0.91}]],\n      {Directive[White, AbsoluteThickness[2.]],\n       Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", White, 11, FontFamily -> \"Arial\"],\n           Scaled[{0.79, 0.83}]]\n    }\n  ]\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"319475\" data-output-id=\"40\" data-out-n=\"150\" data-sub-idx=\"1\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"39\" data-sub-start=\"1\" data-sub-end=\"52\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[150]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_3bkgknowsrc2.svg\" src=\"img/EAB_DCT_analysis/wl_3bkgknowsrc2.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Linear-linear plot — includes 0 µM data that the log-x plot cannot show *)\nModule[{ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts,\n        darkBg, fgStyle, eCols, modelStyles},\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4,\n                                    DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  darkBg     = GrayLevel[0.12];\n  fgStyle    = Directive[White, AbsoluteThickness[1.1]];\n  eCols      = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ {1,2,3};\n  modelStyles = {\n    Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]],\n    Directive[White, AbsoluteThickness[2.]]\n  };\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    Joined -> True,\n    PlotMarkers -> {{Automatic,8},{Automatic,8},{Automatic,8}, None, None},\n    PlotStyle -> Join[eCols, modelStyles],\n    Frame -> True, Axes -> False, Background -> darkBg, FrameStyle -> fgStyle,\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Ligand] (\\[Mu]M)\", 14, White],\n                   Style[\"Fraction folded\", 14, White]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, {\"E1\",\"E2\",\"E3\"},\n      LabelStyle -> Directive[White, 12], Background -> darkBg,\n      LegendFunction -> (Framed[#, Background->darkBg,\n                           FrameStyle->fgStyle]&)], Right],\n    Epilog -> {\n      {Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]],\n       Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", GrayLevel[0.65], 11, FontFamily -> \"Arial\"],\n           Scaled[{0.79, 0.91}]],\n      {Directive[White, AbsoluteThickness[2.]],\n       Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", White, 11, FontFamily -> \"Arial\"],\n           Scaled[{0.79, 0.83}]]\n    }\n  ]\n]",
       "mime": "text/plain"
      }
     ],
     "id": "e9fc4c35-6368-492a-8af5-75686f43ef07"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## 6. Export\nExports key figures as PDFs to a `figures/` folder next to `dataDir`.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 6.1 Export figures",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "exportFigure = True; (* set to True to export all figures as PDFs *)\n\nIf[exportFigure,\n  figDir = FileNameJoin[{DirectoryName[dataDir], \"figures\"}];\n  If[!DirectoryQ[figDir], CreateDirectory[figDir]];\n  Print[\"Saving to: \", figDir];\n\n  exportFig[fig_, name_] := (\n    Export[FileNameJoin[{figDir, name <> \".pdf\"}], fig];\n    Print[\"✓ \", name]\n  );\n\n  (* Drift *)\n  exportFig[DCTPlots`PlotGK[goodSpecs],            \"drift_gK\"];\n  exportFig[DCTPlots`PlotTimeSeries[goodSpecs],    \"drift_timeSeries\"];\n  exportFig[DCTPlots`PlotDCTHeatmap[goodSpecs],    \"drift_heatmap\"];\n  exportFig[DCTPlots`PlotKKResiduals[kkRep],       \"drift_kkResiduals\"];\n\n  (* Concentration (skip if not fitted) *)\n  If[ValueQ[concGoodSpecs] && Length[concGoodSpecs] > 0,\n    exportFig[DCTPlots`PlotGK[concGoodSpecs], \"conc_gK\"]\n  ];\n\n  Print[Style[\"Export done.\", Bold, Darker[Green]]],\n\n  Print[Style[\"exportFigure = False — set to True to export.\", Italic, GrayLevel[0.6]]]\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">Saving to: </span><span class=\"wl-ps\">c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\data\\\\figures</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_gK</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_timeSeries</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_heatmap</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">drift_kkResiduals</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">✓ </span><span class=\"wl-ps\">conc_gK</span></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq6c9ur0-exnztc5\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dGNvbG9yeyMwMGZmMDB9e1x0ZXh0e0V4cG9ydCBkb25lLn19fQ==\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\" style=\"color:#00ff00;\"><span class=\"mord\" style=\"color:#00ff00;\">Export done.</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
