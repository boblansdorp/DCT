  {
   "kind": 1,
   "value": "### 4a.5 Rs and C0 vs time",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Rs and C0 vs time, one trace per electrode *)\nRow[{DCTPlots`PlotRsVsTime[goodSpecs], DCTPlots`PlotC0VsTime[goodSpecs]}, Spacer[20]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"45\" data-out-n=\"335\" data-sub-idx=\"1\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"57\" data-sub-start=\"1\" data-sub-end=\"1\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[335]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_5ilkfnxsrog1.svg\" width=\"679\" height=\"848\" src=\"img/EAB_DCT_analysis/wl_5ilkfnxsrog1.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
