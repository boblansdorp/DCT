     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"70\" data-out-n=\"669\" data-sub-idx=\"13\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"131\" data-sub-start=\"55\" data-sub-end=\"55\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[669]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_11iusrh7jdgve.svg\" width=\"1635\" height=\"1087\" src=\"img/EAB_DCT_analysis/wl_11iusrh7jdgve.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
