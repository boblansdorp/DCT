      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq929sou-h5dcsne\" data-page-width-em=\"51\" data-latex-b64=\"XG1hdGhiZntcdGV4dHszLXN0YXRlIG1vZGVsfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">3-state model</span></span></span></span></span></span></div></div></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq929sp0-kn2fbjv\" data-page-width-em=\"51\" data-latex-b64=\"XHRleHR7ICB9XHRleHR7S31fe1x0ZXh0e1N9fVx0ZXh0eyA9IH1cdGV4dHswLjE5Mn1cdGV4dHsgICAgIH1cdGV4dHtLfV97XHRleHR7RH19XHRleHR7ID0gfVx0ZXh0ezU2LjV9XHRleHR7ICRcbXUkTX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">S</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.192</span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">D</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">56.5</span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq929sp1-irs83zu\" data-page-width-em=\"51\" data-latex-b64=\"XG1hdGhiZntcdGV4dHs0LXN0YXRlIG1vZGVsfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">4-state model</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq929sp2-9a02yji\" data-page-width-em=\"51\" data-latex-b64=\"XHRleHR7ICB9XHRleHR7S31fe1x0ZXh0e1N9fVx0ZXh0eyA9IH1cdGV4dHswLjE0Mn1cdGV4dHsgICAgIH1cdGV4dHtLfV97XHRleHR7RH19XHRleHR7ID0gfVx0ZXh0ezcuNn1cdGV4dHsgJFxtdSRNfVx0ZXh0eyAgICAgTkYgPSB9XHRleHR7MC4zMn0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">S</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.142</span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">D</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">7.6</span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M</span></span><span class=\"mord text\"><span class=\"mord\"> NF = </span></span><span class=\"mord text\"><span class=\"mord\">0.32</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula][formula][formula][formula]",
       "mime": "text/plain"
      }
     ],
     "id": "4a02c6b7-1b1d-4510-a664-e5e05f4443f6"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"821465\" data-output-id=\"75\" data-out-n=\"414\" data-sub-idx=\"12\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"66\" data-sub-start=\"26\" data-sub-end=\"83\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[414]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_68yyvunzmcz9.svg\" src=\"img/EAB_DCT_analysis/wl_68yyvunzmcz9.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Biophysical model fits using the mechanistic 3-state and 4-state kinetic models.\n   Data: {conc µM, ff} across all electrodes, positive concentrations only. *)\n\n(* --- model equations --- *)\nPrint[Style[\"3-state model  (U \\[LeftRightArrow] F \\[LeftRightArrow] B)\", Bold, 13]];\nPrint[Row[{\"  \", Subscript[\"f\",\"f\"], \" = \", DCTBiophysics`$FF3State}]];\nPrint[Style[\"4-state model  (U \\[LeftRightArrow] F \\[LeftRightArrow] B,  NF non-folding)\", Bold, 13]];\nPrint[Row[{\"  \", Subscript[\"f\",\"f\"], \" = \", DCTBiophysics`$FF4State}]];\nPrint[\"\"];\n\nallPts = Flatten[ffPerElectrode[[All, posIdx]], 1];\n\nfitResult = DCTBiophysics`FitFoldedFraction[allPts];\n\n(* --- fit parameters --- *)\nModule[{p3 = fitResult[\"Model3\"], p4 = fitResult[\"Model4\"]},\n  Print[Style[\"3-state model\", Bold, 13]];\n  Print[Row[{\"  \", Subscript[\"K\",\"S\"], \" = \", NumberForm[p3[\"KS\"], {4,3}],\n             \"     \", Subscript[\"K\",\"D\"], \" = \", NumberForm[p3[\"KD\"], {6,1}], \" \\[Mu]M\"}]];\n  Print[Style[\"4-state model\", Bold, 13]];\n  Print[Row[{\"  \", Subscript[\"K\",\"S\"], \" = \", NumberForm[p4[\"KS\"], {4,3}],\n             \"     \", Subscript[\"K\",\"D\"], \" = \", NumberForm[p4[\"KD\"], {6,1}], \" \\[Mu]M\",\n             \"     NF = \", NumberForm[p4[\"NF\"], {3,2}]}]]\n];\n\n(* --- plot --- *)\nModule[{ks3, kd3, ks4, kd4, nf4, m3, m4,\n        tMin, tMax, c3pts, c4pts,\n        darkBg, fgStyle, eCols, modelStyles},\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n\n  (* substitute numeric params into public symbolic expressions *)\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4,\n                                    DCTBiophysics`NF -> nf4};\n\n  tMin = Log10[Min[allPts[[All,1]]] * 0.4];\n  tMax = Log10[Max[allPts[[All,1]]] * 3.];\n\n  (* sample at 200 log-spaced points as {µM, ff} — same coordinate space as data *)\n  c3pts = Table[{10^t, N[m3 /. DCTBiophysics`conc -> 10^t]}, {t, tMin, tMax, (tMax-tMin)/200}];\n  c4pts = Table[{10^t, N[m4 /. DCTBiophysics`conc -> 10^t]}, {t, tMin, tMax, (tMax-tMin)/200}];\n\n  darkBg     = GrayLevel[0.12];\n  fgStyle    = Directive[White, AbsoluteThickness[1.1]];\n  eCols      = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ {1,2,3};\n  modelStyles = {\n    Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]],\n    Directive[White, AbsoluteThickness[2.]]\n  };\n\n  ListLinePlot[\n    Join[ffPerElectrode[[All, posIdx]], {c3pts, c4pts}],\n    ScalingFunctions -> {\"Log10\", None},\n    Joined -> True,\n    PlotMarkers -> {{Automatic,8},{Automatic,8},{Automatic,8}, None, None},\n    PlotStyle -> Join[eCols, modelStyles],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., White], None}, {DCTPlots`ThemeLogTicks[0.8, 1200., White], None}},\n    FrameTicksStyle -> Directive[White, 12],\n    Frame -> True, Axes -> False, Background -> darkBg, FrameStyle -> fgStyle,\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Ligand] (\\[Mu]M)\", 14, White],\n                   Style[\"Fraction folded\", 14, White]},\n    PlotRange -> {{0.8, 1200}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, {\"E1\",\"E2\",\"E3\"},\n      LabelStyle -> Directive[White, 12], Background -> darkBg,\n      LegendFunction -> (Framed[#, Background->darkBg,\n                           FrameStyle->fgStyle]&)], Right],\n    Epilog -> {\n      {Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]],\n       Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", GrayLevel[0.65], 11, FontFamily -> \"Arial\"],\n           Scaled[{0.79, 0.91}]],\n      {Directive[White, AbsoluteThickness[2.]],\n       Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", White, 11, FontFamily -> \"Arial\"],\n           Scaled[{0.79, 0.83}]]\n    }\n  ]\n]",
       "mime": "text/plain"
      }
     ],
     "id": "87f0ce19-0cf9-4a35-b3f6-8f0bb0a9d0ad"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5a.2 Linear-linear plot",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Linear-linear plot \\[Dash] includes 0 \\[Mu]M data the log-x plot can't show.\n   Defined as a function so Section 6 can re-render it white in the Publication\n   block (it reads DCTPlots`$DCTTheme at call time; dark on screen otherwise). *)\nbiophysLinearPlot[] := Module[\n  {pub, fg, bg, ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts, eCols, modelStyles},\n  pub = (DCTPlots`$DCTTheme === \"Publication\");\n  fg  = If[pub, Black, White];\n  bg  = If[pub, White, GrayLevel[0.12]];\n\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  eCols       = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ {1, 2, 3};\n  modelStyles = {Directive[Gray, Dashed, AbsoluteThickness[2.]], Directive[fg, AbsoluteThickness[2.]]};\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    Joined -> True,\n    PlotMarkers -> {{Automatic, 8}, {Automatic, 8}, {Automatic, 8}, None, None},\n    PlotStyle -> Join[eCols, modelStyles],\n    PlotTheme -> \"Default\",\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., fg], None}, {DCTPlots`ThemeLinTicks[0., cMax * 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 12],\n    Frame -> True, Axes -> False, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Fraction folded\", 14, fg]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, {\"E1\", \"E2\", \"E3\"},\n      LabelStyle -> Directive[fg, 12], Background -> bg,\n      LegendFunction -> (Framed[#, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]]] &)], Right],\n    Epilog -> {\n      {Directive[Gray, Dashed, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", Gray, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.91}]],\n      {Directive[fg, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", fg, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.83}]]\n    }\n  ]\n];\n\nbiophysLinearPlot[]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"821465\" data-output-id=\"76\" data-out-n=\"415\" data-sub-idx=\"1\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"68\" data-sub-start=\"1\" data-sub-end=\"51\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[415]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1gi1nd2ibs86t.svg\" src=\"img/EAB_DCT_analysis/wl_1gi1nd2ibs86t.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Linear-linear plot — includes 0 µM data that the log-x plot cannot show *)\nModule[{ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts,\n        darkBg, fgStyle, eCols, modelStyles},\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4,\n                                    DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  darkBg     = GrayLevel[0.12];\n  fgStyle    = Directive[White, AbsoluteThickness[1.1]];\n  eCols      = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ {1,2,3};\n  modelStyles = {\n    Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]],\n    Directive[White, AbsoluteThickness[2.]]\n  };\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    Joined -> True,\n    PlotMarkers -> {{Automatic,8},{Automatic,8},{Automatic,8}, None, None},\n    PlotStyle -> Join[eCols, modelStyles],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., White], None}, {DCTPlots`ThemeLinTicks[0., cMax * 1.05, White], None}},\n    FrameTicksStyle -> Directive[White, 12],\n    Frame -> True, Axes -> False, Background -> darkBg, FrameStyle -> fgStyle,\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Ligand] (\\[Mu]M)\", 14, White],\n                   Style[\"Fraction folded\", 14, White]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, {\"E1\",\"E2\",\"E3\"},\n      LabelStyle -> Directive[White, 12], Background -> darkBg,\n      LegendFunction -> (Framed[#, Background->darkBg, FrameStyle->fgStyle]&)], Right],\n    Epilog -> {\n      {Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]],\n       Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", GrayLevel[0.65], 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.91}]],\n      {Directive[White, AbsoluteThickness[2.]],\n       Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", White, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.83}]]\n    }\n  ]\n]",
       "mime": "text/plain"
      }
     ],
     "id": "42c2b32a-a442-4e3f-a6c8-3991cab6f956"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## 6. Export\nExports key figures as PDFs to a `figures/` folder next to `dataDir`.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 6.1 Export figures",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "exportFigure = True; (* set to True to export all figures as PDF + PNG *)\n\nIf[exportFigure,\n  figDir = FileNameJoin[{DirectoryName[dataDir], \"figures\"}];\n  If[!DirectoryQ[figDir], CreateDirectory[figDir]];\n  Print[\"Saving to: \", figDir];\n\n  (* PDF = vector (for LaTeX / print); PNG = 300 dpi raster (paste into Google\n     Docs / Slides \\[Dash] those don't accept PDF or SVG natively). *)\n  exportFig[fig_, name_] := (\n    Export[FileNameJoin[{figDir, name <> \".pdf\"}], fig];\n    Export[FileNameJoin[{figDir, name <> \".png\"}], fig, ImageResolution -> 300];\n    Print[\"\\[Checkmark] \", name]\n  );\n\n  (* Figures in notebook order, Publication theme (white). *)\n  Block[{DCTPlots`$DCTTheme = \"Publication\"},\n\n    (* Method validation \\[Dash] synthetic recovery: figure + parameter table *)\n    If[ValueQ[simRec],\n      exportFig[DCTPlots`PlotCombValidation[simK, gSim, simRec], \"validation_comb\"]];\n    If[ValueQ[validationTable],\n      exportFig[validationTable, \"validation_table\"]];\n\n    (* Section 1 \\[Dash] Lin-KK residuals *)\n    exportFig[DCTPlots`PlotKKResiduals[kkRep], \"drift_kkResiduals\"];\n\n    (* 4a.1 \\[Dash] drift g(k): E1, hour-mark legend, nF/decade *)\n    exportFig[DCTPlots`PlotGK[e1Specs, DCTPlots`HourMarkLabels[e1Specs], \"GScale\" -> 1*^9],\n      \"drift_gK\"];\n\n    (* 4a.5 \\[Dash] Rs and C0 vs time, aligned time axes *)\n    exportFig[\n      Column[{\n        DCTPlots`PlotRsVsTime[goodSpecs, ImagePadding -> {{85, 20}, {38, 8}}],\n        DCTPlots`PlotC0VsTime[goodSpecs, ImagePadding -> {{85, 20}, {38, 8}}]\n      }, Alignment -> Left, Spacings -> 1],\n      \"drift_RsC0\"];\n\n    (* 4a.7 \\[Dash] k_peak vs time, per k-range *)\n    exportFig[DCTPlots`PlotKPeakVsTime[goodSpecs, kPeakRanges], \"drift_kPeak\"];\n\n    (* One g(k) heatmap per electrode, titled (rasterised \\[Dash] 100s of columns) *)\n    KeyValueMap[\n      (exportFig[\n         Rasterize[DCTPlots`PlotDCTHeatmap[#2, PlotLabel -> Style[#1, 18]],\n           ImageResolution -> 300],\n         \"drift_heatmap_\" <> #1] &),\n      GroupBy[goodSpecs, FileNameTake[#[\"File\"], {-2}] &]\n    ];\n\n    (* Section 5 \\[Dash] concentration g(k): E1, area-normalised *)\n    If[ValueQ[concE1] && Length[concE1] > 0,\n      exportFig[DCTPlots`PlotGK[concE1, Automatic, \"AreaNorm\" -> True], \"conc_gK\"]];\n\n    (* 5a.2 \\[Dash] fraction folded vs [ligand], linear, with 3/4-state model fits *)\n    If[ValueQ[fitResult] && ValueQ[ffPerElectrode],\n      exportFig[biophysLinearPlot[], \"biophys_linear\"]];\n  ];\n\n  Print[Style[\"Export done.\", Bold, Darker[Green]]],\n\n  Print[Style[\"exportFigure = False \\[Dash] set to True to export.\", Italic, GrayLevel[0.6]]]\n]",
   "languageId": "wolfram",
   "outputs": [
