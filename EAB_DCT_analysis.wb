       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"65\" data-latex-b64=\"XG1hdGhpdHtcdGV4dHtTID0gKFwlIGNoYW5nZSBpbiBvYnNlcnZhYmxlKSAvIChcJSBjaGFuZ2UgaW4gcGFyYW1ldGVyKSwgYXZlcmFnZWQgb3ZlciBhbGwgY29uY2VudHJhdGlvbnMsIHVzaW5nIG9ubHkgdGhlIHR3byBzd2VlcCBjYXNlcyBhZGphY2VudCB0byB0aGUgYmFzZWxpbmUgKG9uZSBiZWxvdywgb25lIGFib3ZlKTsgc2lnbmVkOyByb3dzIHNvcnRlZCBieSB8U3wgb2YgZmYufX0=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord text\"><span class=\"mord\">S = (% change in observable) / (% change in parameter), averaged over all concentrations, using only the two sweep cases adjacent to the baseline (one below, one above); signed; rows sorted by |S| of ff.</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
