    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"49\" data-out-n=\"364\" data-sub-idx=\"12\" data-output-format=\"SVGT\" data-output-is-graphics=\"0\" data-cell-idx=\"65\" data-sub-start=\"51\" data-sub-end=\"59\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[364]=</span></div><div class=\"wl-output-content\"><img class=\"vscode-wolfram-png-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_ryi9ky5ajs06.png\" width=\"742\" height=\"133\" src=\"img/EAB_DCT_analysis/wl_ryi9ky5ajs06.png\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
