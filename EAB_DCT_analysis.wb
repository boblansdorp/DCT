       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq928ome-x65z6e6\" data-page-width-em=\"52\" data-latex-b64=\"MTM5\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">139</span></span></span></span></span></div></div><span class=\"wl-ps\"> / </span><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq928ome-ycw3pd3\" data-page-width-em=\"52\" data-latex-b64=\"NDU4\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">458</span></span></span></span></span></div></div><span class=\"wl-ps\"> files pass Lin-KK overall.</span></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula] /[formula] files pass Lin-KK overall.",
       "mime": "text/plain"
      }
