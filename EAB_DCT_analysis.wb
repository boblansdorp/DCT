{
 "cells": [
  {
   "kind": 2,
   "value": "Quiet[Remove[\"DCTDataImport`*\", \"NNLSFit`*\", \"DCTKernel`*\", \"DCT`*\",\r\n             \"DCTPlots`*\", \"DCTPeakAnalysis`*\", \"DCTSensitivity`*\", \"DCTDashboard`*\",\r\n             \"DCTAdmittanceStats`*\", \"DCTKKCheck`*\"]];\r\n$ContextPath = Select[$ContextPath, !StringMatchQ[#, \"DCT*\" | \"NNLSFit*\"] &];\r\nGet[\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\DCT.wl\"]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq699yvu-uu3e5xd\" data-page-width-em=\"52\" data-latex-b64=\"XHRleHRjb2xvcnsjMDBmZjAwfXtcdGV4dHvinJQgRENUIHBhY2thZ2UgbG9hZGVkLn19\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\" style=\"color:#00ff00;\"><span class=\"mord\" style=\"color:#00ff00;\">✔ DCT package loaded.</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "5578ead4-1c86-4119-882d-5129d3528ac3"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ── PARAMETERS ── edit these, then re-run this cell ── *)\r\n\r\n(* Data directories *)\r\ndataDir          = \"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\data\\\\drift_03252026\";  (* drift data — E1/E2/E3 subdirs *)\r\nconcentrationDir = \"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\data\\\\spike\";           (* spike titration in PBS *)\r\n\r\n(* Representative file index (1-based) — used for KK check and sweep plots *)\r\nrepFileIdx = 1;\r\n\r\n(* Fit parameters — tuned on drift data in Sections 1–3, locked here for all fits *)\r\nlambdaND      = 1*^-3;  (* Tikhonov regularisation — from L-curve analysis *)\r\nfMinHz        = 0.5;    (* lower frequency cutoff [Hz] *)\r\nfMaxHz        = 1000.;  (* upper frequency cutoff [Hz] *)\r\nweightPower   = -0.75;  (* admittance weight exponent *)\r\nbinsPerDecade = 15;     (* tau grid density *)\r\ntauMinFactor  = 0.1;    (* tau grid lower extension factor *)\r\ntauMaxFactor  = 10.;    (* tau grid upper extension factor *)\r\n\r\n(* Drift batch decimation: 1 = all files, N = every Nth (faster while tuning) *)\r\nfileDecimation = 1;\r\n\r\n(* Natural sort: group by electrode subdir, then by numeric file number.\r\n   Plain Sort gives lexicographic order (118 before 15) which breaks time ordering. *)\r\nsortFiles[files_List] := SortBy[files,\r\n  {FileNameTake[#, {-2}],\r\n   Last[ToExpression /@ StringCases[FileNameTake[#], NumberString], 0]} &\r\n]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## 1. KK Data Validation\nRun once on the representative file (`repFileIdx`). Residuals guide initial `fMinHz`/`fMaxHz` selection.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Load all drift files from all electrode subdirs — numeric sort so E1/E2/E3 stay grouped\n   and files within each electrode run in time order (not lexicographic) *)\ndriftFiles = sortFiles[FileNames[\"*.txt\", dataDir, Infinity]];\nPrint[\"Found \", Length[driftFiles], \" drift files in \", FileNameTake[dataDir]];\n\n(* KK check on representative file *)\nrepFile   = driftFiles[[repFileIdx]];\nkkRepData = DCTDataImport`ImportEIS[repFile];\nkkRep     = DCTKKCheck`KKCheck[kkRepData];\nPrint[Style[\n  \"KK check: \" <> FileNameTake[repFile] <>\n  \"  RMS Re = \" <> ToString[NumberForm[100. kkRep[\"RMSRe\"], {4,2}]] <> \"%, \" <>\n  \"Im = \"  <> ToString[NumberForm[100. kkRep[\"RMSIm\"], {4,2}]] <> \"%  \" <>\n  If[kkRep[\"OK\"], \"\\[Checkmark] OK\", \"\\[Times] FAIL\"],\n  Bold, If[kkRep[\"OK\"], Darker[Green], Red], 13\n]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">Found </span><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq699yx5-3ffaudi\" data-page-width-em=\"52\" data-latex-b64=\"NDU4\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">458</span></span></span></span></span></div></div><span class=\"wl-ps\"> drift files in </span><span class=\"wl-ps\">drift_03252026</span></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: Found[formula] drift files indrift_03252026",
       "mime": "text/plain"
      }
     ],
     "id": "9da2bc29-1230-4858-9c2d-485faaae4cae"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq699yy2-4i6bhb5\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dGNvbG9yeyMwMGZmMDB9e1x0ZXh0e0tLIGNoZWNrOiBFMVxfRUlTXF8oMCkudHh0ICBSTVMgUmUgPSAxLjI2XCUsIEltID0gMC44MlwlICDinJMgT0t9fX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.06em;vertical-align:-0.31em;\"></span><span class=\"mord text\" style=\"color:#00ff00;\"><span class=\"mord\" style=\"color:#00ff00;\">KK check: E1_EIS_(0).txt RMS Re = 1.26%, Im = 0.82% ✓ OK</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "4e8ade0a-410f-46bd-8345-aaca73dcccf3"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "DCTPlots`PlotKKResiduals[kkRep]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"289054\" data-output-id=\"265\" data-out-n=\"1365\" data-sub-idx=\"0\" data-output-format=\"Auto\" data-output-is-graphics=\"1\" data-cell-idx=\"4\" data-sub-start=\"0\" data-sub-end=\"0\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1365]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_4zez984x47uq.svg\" src=\"img/EAB_DCT_analysis/wl_4zez984x47uq.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\nDCTPlots`PlotKKResiduals[kkRep]",
       "mime": "text/plain"
      }
     ],
     "id": "f3aea749-759a-4557-89b9-7502a2d1f1b7"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Largest contiguous window where both residuals stay below threshold *)\n{kkFMin, kkFMax} = DCTKKCheck`KKValidFreqRange[kkRep];\nPrint[Style[\n  \"KK-valid range: \" <> ToString[NumberForm[kkFMin, {5,2}]] <>\n  \" \\[LongDash] \" <> ToString[NumberForm[kkFMax, {5,2}]] <> \" Hz\",\n  Bold, 13\n]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq699zhq-ublaqxc\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dHtLSy12YWxpZCByYW5nZTogMC43OSAtLS0gMTAwMDAgSHp9fQ==\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">KK-valid range: 0.79 — 10000 Hz</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "dca104b1-d56a-4186-9d23-3655290e2843"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Use the KK-valid lower bound directly — below kkFMin the Lin-KK residuals\n   exceed threshold, indicating measurement artefacts or inductive contributions. *)\nfMinHz = kkFMin;\nPrint[\"fMinHz \\[LeftArrow] \", fMinHz, \" Hz\"]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">fMinHz ← </span><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq699zjj-aquukq7\" data-page-width-em=\"52\" data-latex-b64=\"MC43OTQzMw==\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.79433</span></span></span></span></span></div></div><span class=\"wl-ps\"> Hz</span></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: fMinHz ←[formula] Hz",
       "mime": "text/plain"
      }
     ],
     "id": "e6c0cad9-9469-4569-8280-14156b8e8228"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## 2. Admittance Statistics\nCompute per-frequency mean and variance of |Y(f)| across all drift files (undecimated). CV plot flags unreliable frequencies; power-law scatter derives `weightPower`. Update the params cell with the suggested values before proceeding.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Group files by electrode subdirectory, compute within-electrode variance stats,\n   then pool across electrodes for the power-law fit. Each electrode may have a\n   different absolute admittance level — pooling the (YMean, YVar) points across\n   all electrodes gives a better estimate of the noise scaling exponent alpha. *)\nelectrodeGroups = GroupBy[\n  sortFiles[FileNames[\"*.txt\", dataDir, Infinity]],\n  FileNameTake[#, {-2}] &   (* second-to-last path component = electrode name *)\n];\nPrint[\"Electrodes: \", Row[Keys[electrodeGroups], \", \"],\n  \"   files: \", Row[Length /@ Values[electrodeGroups], \" / \"]];\n\nelectrodeStats = Association @ KeyValueMap[\n  #1 -> DCTAdmittanceStats`ComputeAdmittanceStats[#2] &,\n  electrodeGroups\n];\n\ndriftStats = DCTAdmittanceStats`MergeAdmittanceStats[Values[electrodeStats]];\nIf[FailureQ[driftStats],\n  Print[Style[\"Failed: \" <> driftStats[\"Message\"], Red, Bold]],\n  Print[Style[\n    \"Done: \" <> ToString[driftStats[\"FilesOK\"]] <> \" / \" <>\n    ToString[driftStats[\"FilesTotal\"]] <> \" files across \" <>\n    ToString[Length[electrodeGroups]] <> \" electrodes, \" <>\n    ToString[Length[driftStats[\"FreqHz\"]]] <> \" pooled (freq, electrode) points.\",\n    Bold, Darker[Green]\n  ]]\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">Electrodes: </span><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq699zkl-6ap5xfk\" data-page-width-em=\"52\" data-latex-b64=\"XHRleHR7RTF9XHRleHR7LCB9XHRleHR7RTJ9XHRleHR7LCB9XHRleHR7RTN9\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">E1</span></span><span class=\"mord text\"><span class=\"mord\">, </span></span><span class=\"mord text\"><span class=\"mord\">E2</span></span><span class=\"mord text\"><span class=\"mord\">, </span></span><span class=\"mord text\"><span class=\"mord\">E3</span></span></span></span></span></span></div></div><span class=\"wl-ps\">   files: </span><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq699zkm-udzh45v\" data-page-width-em=\"52\" data-latex-b64=\"MTU0XHRleHR7IC8gfTE1Mlx0ZXh0eyAvIH0xNTI=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">154</span><span class=\"mord text\"><span class=\"mord\"> / </span></span><span class=\"mord\">152</span><span class=\"mord text\"><span class=\"mord\"> / </span></span><span class=\"mord\">152</span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: Electrodes:[formula]   files:[formula]",
       "mime": "text/plain"
      }
     ],
     "id": "f56e18b0-59fd-4986-8b7a-4f793fdf93d8"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq69a8gn-kyvv0lp\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dGNvbG9yeyMwMGZmMDB9e1x0ZXh0e0RvbmU6IDQ1OCAvIDQ1OCBmaWxlcyBhY3Jvc3MgMyBlbGVjdHJvZGVzLCAxNTMgcG9vbGVkIChmcmVxLCBlbGVjdHJvZGUpIHBvaW50cy59fX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord text\" style=\"color:#00ff00;\"><span class=\"mord\" style=\"color:#00ff00;\">Done: 458 / 458 files across 3 electrodes, 153 pooled (freq, electrode) points.</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "cd0970d9-3f31-48ba-a63c-1fb015d7afd8"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Var vs |Y_mean| scatter — power-law fit gives weightPower *)\nDCTPlots`PlotVariancePowerLaw[driftStats]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"289054\" data-output-id=\"266\" data-out-n=\"1375\" data-sub-idx=\"1\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"9\" data-sub-start=\"1\" data-sub-end=\"1\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1375]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_5bpp9w4dgcr5.svg\" src=\"img/EAB_DCT_analysis/wl_5bpp9w4dgcr5.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Var vs |Y_mean| scatter — power-law fit gives weightPower *)\nDCTPlots`PlotVariancePowerLaw[driftStats]",
       "mime": "text/plain"
      }
     ],
     "id": "08b52b4b-57fc-416c-8796-48018141c2d1"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Above ~500 Hz the variance-vs-mean curve inflects away from the power law:\n   admittance is dominated by Rs / parasitic capacitance, not charge transfer.\n   DCT resolves nothing useful there — tighten the upper cutoff. *)\nfMaxHz = 500.;\nPrint[\"fMaxHz \\[LeftArrow] \", fMaxHz, \" Hz\"]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><span class=\"wl-ps\">fMaxHz ← </span><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq69a8y0-hli0ute\" data-page-width-em=\"51\" data-latex-b64=\"NTAwLlws\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">500.</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span></span></span></span></span></div></div><span class=\"wl-ps\"> Hz</span></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: fMaxHz ←[formula] Hz",
       "mime": "text/plain"
      }
     ],
     "id": "90759f64-51ad-4757-8fc8-a6025ab88e94"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* All data shown; power-law fit and annotation use only [fMinHz, fMaxHz].\n   Dashed vertical lines mark the fit boundaries. *)\nDCTPlots`PlotVariancePowerLaw[driftStats, fMinHz, fMaxHz]",
   "languageId": "wolfram",
   "outputs": [
