  {
   "kind": 2,
   "value": "(* Concentration g(k) spectra — one electrode *)\nconcE1 = Select[concGoodSpecs, StringStartsQ[#File, \"E1\"] &];\nDCTPlots`PlotGK[concE1]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"289054\" data-output-id=\"280\" data-out-n=\"1413\" data-sub-idx=\"2\" data-output-format=\"Auto\" data-output-is-graphics=\"1\" data-cell-idx=\"35\" data-sub-start=\"2\" data-sub-end=\"2\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1413]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_15l74qyrco0lq.svg\" src=\"img/EAB_DCT_analysis/wl_15l74qyrco0lq.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Concentration g(k) spectra — one electrode *)\nconcE1 = Select[concGoodSpecs, StringStartsQ[#File, \"E1\"] &];\nDCTPlots`PlotGK[concE1]",
       "mime": "text/plain"
      }
     ],
     "id": "7e2210c0-b285-49b2-9608-17626207da2c"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Concentration g(k) — area-normalised (each curve divided by its total capacitance) *)\nconcE1Norm = Table[\n  Module[{s, spec, area},\n    s    = concE1[[i]];\n    spec = s[\"Spec\"];\n    area = DCTPeakAnalysis`IntegrateSpectrum[spec];\n    <|s, \"Spec\" -> <|spec, \"g\" -> spec[\"g\"] / Max[area, 1*^-15]|>|>\n  ],\n  {i, Length[concE1]}\n];\nDCTPlots`PlotGK[concE1Norm, Automatic,\n  FrameLabel -> {\n    Style[Row[{\"Electron-transfer rate, k (\", Superscript[\"s\", -1], \")\"}], 16, White],\n    Style[Row[{\"g(k) / C\", Subscript[\"dist\", \"\"], \"  (\", Superscript[\"decade\", -1], \")\"}], 16, White]\n  }\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"289054\" data-output-id=\"281\" data-out-n=\"1415\" data-sub-idx=\"2\" data-output-format=\"Auto\" data-output-is-graphics=\"1\" data-cell-idx=\"36\" data-sub-start=\"10\" data-sub-end=\"15\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1415]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1hv1v1dxy5j46.svg\" src=\"img/EAB_DCT_analysis/wl_1hv1v1dxy5j46.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Concentration g(k) — area-normalised (each curve divided by its total capacitance) *)\nconcE1Norm = Table[\n  Module[{s, spec, area},\n    s    = concE1[[i]];\n    spec = s[\"Spec\"];\n    area = DCTPeakAnalysis`IntegrateSpectrum[spec];\n    <|s, \"Spec\" -> <|spec, \"g\" -> spec[\"g\"] / Max[area, 1*^-15]|>|>\n  ],\n  {i, Length[concE1]}\n];\nDCTPlots`PlotGK[concE1Norm, Automatic,\n  FrameLabel -> {\n    Style[Row[{\"Electron-transfer rate, k (\", Superscript[\"s\", -1], \")\"}], 16, White],\n    Style[Row[{\"g(k) / C\", Subscript[\"dist\", \"\"], \"  (\", Superscript[\"decade\", -1], \")\"}], 16, White]\n  }\n]",
       "mime": "text/plain"
      }
     ],
     "id": "5816e6ed-3438-4566-8429-f555e2f0f8e9"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Fraction folded vs [ligand]\n   k_peak shifts from range 1 (~46 s-1, unbound) to range 2 (~184 s-1, bound).\n   ff = area(range 2) / (area(range 1) + area(range 2)) — naturally 0 to 1. *)\n\nareaWindow[spec_, kLo_, kHi_] := Module[{tau, g, k, logK, n},\n  tau = spec[\"Tau\"]; g = spec[\"g\"]; k = 1./tau; logK = Log10[k]; n = Length[g];\n  If[n < 2, Return[0.]];\n  Total @ Table[If[0.5(k[[j]]+k[[j+1]]) >= kLo && 0.5(k[[j]]+k[[j+1]]) <= kHi,\n    0.5(g[[j]]+g[[j+1]]) Abs[logK[[j+1]]-logK[[j]]], 0.], {j, n-1}]\n];\n\ngetLabelUM[lbl_] := ToExpression @ First[\n  StringCases[lbl, n:NumberString ~~ \" \\[Mu]M\" :> n], \"0\"];\n\nffPerElectrode = Table[\n  Module[{subs, concs, a1, a2, ff},\n    subs  = Select[concGoodSpecs, StringStartsQ[#File, e] &];\n    concs = N @ (getLabelUM /@ subs[[All, \"File\"]]);\n    a1    = areaWindow[#Spec, kPeakRanges[[1,1]], kPeakRanges[[1,2]]] & /@ subs;\n    a2    = areaWindow[#Spec, kPeakRanges[[2,1]], kPeakRanges[[2,2]]] & /@ subs;\n    ff    = MapThread[If[#1+#2 > 0., #2/(#1+#2), 0.] &, {a1, a2}];\n    Transpose[{concs, ff}]\n  ],\n  {e, {\"E1\", \"E2\", \"E3\"}}\n];\n\n(* exclude 0 µM from log-axis plot *)\nconcGrid = ffPerElectrode[[1, All, 1]];\nposIdx   = Select[Range[Length[concGrid]], concGrid[[#]] > 0 &];\n\ndarkBg  = GrayLevel[0.12];\nfgStyle = Directive[White, AbsoluteThickness[1.1]];\neCols   = Directive[ColorData[97][#], AbsoluteThickness[1.8]] & /@ {1,2,3};\n\nListLinePlot[ffPerElectrode[[All, posIdx]],\n  ScalingFunctions -> {\"Log10\", None},\n  Joined -> True, PlotMarkers -> {Automatic, 8}, PlotStyle -> eCols,\n  Frame -> True, Axes -> False, Background -> darkBg, FrameStyle -> fgStyle,\n  LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n  FrameLabel -> {\n    Style[\"[Ligand] (\\[Mu]M)\", 14, White],\n    Style[\"Fraction folded\", 14, White]},\n  PlotRange -> {{0.8, 1200}, {0, 1}},\n  PlotRangePadding -> Scaled[0.04],\n  ImageSize -> 500, AspectRatio -> 0.75,\n  PlotLegends -> Placed[LineLegend[eCols, {\"E1\",\"E2\",\"E3\"},\n    LabelStyle -> Directive[White, 12], Background -> darkBg,\n    LegendFunction -> (Framed[#, Background->darkBg,\n                         FrameStyle->fgStyle]&)], Right]\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"289054\" data-output-id=\"282\" data-out-n=\"1424\" data-sub-idx=\"10\" data-output-format=\"Auto\" data-output-is-graphics=\"1\" data-cell-idx=\"37\" data-sub-start=\"34\" data-sub-end=\"49\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1424]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_zuzf1ogzpm61.svg\" src=\"img/EAB_DCT_analysis/wl_zuzf1ogzpm61.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Fraction folded vs [ligand]\n   k_peak shifts from range 1 (~46 s-1, unbound) to range 2 (~184 s-1, bound).\n   ff = area(range 2) / (area(range 1) + area(range 2)) — naturally 0 to 1. *)\n\nareaWindow[spec_, kLo_, kHi_] := Module[{tau, g, k, logK, n},\n  tau = spec[\"Tau\"]; g = spec[\"g\"]; k = 1./tau; logK = Log10[k]; n = Length[g];\n  If[n < 2, Return[0.]];\n  Total @ Table[If[0.5(k[[j]]+k[[j+1]]) >= kLo && 0.5(k[[j]]+k[[j+1]]) <= kHi,\n    0.5(g[[j]]+g[[j+1]]) Abs[logK[[j+1]]-logK[[j]]], 0.], {j, n-1}]\n];\n\ngetLabelUM[lbl_] := ToExpression @ First[\n  StringCases[lbl, n:NumberString ~~ \" \\[Mu]M\" :> n], \"0\"];\n\nffPerElectrode = Table[\n  Module[{subs, concs, a1, a2, ff},\n    subs  = Select[concGoodSpecs, StringStartsQ[#File, e] &];\n    concs = N @ (getLabelUM /@ subs[[All, \"File\"]]);\n    a1    = areaWindow[#Spec, kPeakRanges[[1,1]], kPeakRanges[[1,2]]] & /@ subs;\n    a2    = areaWindow[#Spec, kPeakRanges[[2,1]], kPeakRanges[[2,2]]] & /@ subs;\n    ff    = MapThread[If[#1+#2 > 0., #2/(#1+#2), 0.] &, {a1, a2}];\n    Transpose[{concs, ff}]\n  ],\n  {e, {\"E1\", \"E2\", \"E3\"}}\n];\n\n(* exclude 0 µM from log-axis plot *)\nconcGrid = ffPerElectrode[[1, All, 1]];\nposIdx   = Select[Range[Length[concGrid]], concGrid[[#]] > 0 &];\n\ndarkBg  = GrayLevel[0.12];\nfgStyle = Directive[White, AbsoluteThickness[1.1]];\neCols   = Directive[ColorData[97][#], AbsoluteThickness[1.8]] & /@ {1,2,3};\n\nListLinePlot[ffPerElectrode[[All, posIdx]],\n  ScalingFunctions -> {\"Log10\", None},\n  Joined -> True, PlotMarkers -> {Automatic, 8}, PlotStyle -> eCols,\n  Frame -> True, Axes -> False, Background -> darkBg, FrameStyle -> fgStyle,\n  LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n  FrameLabel -> {\n    Style[\"[Ligand] (\\[Mu]M)\", 14, White],\n    Style[\"Fraction folded\", 14, White]},\n  PlotRange -> {{0.8, 1200}, {0, 1}},\n  PlotRangePadding -> Scaled[0.04],\n  ImageSize -> 500, AspectRatio -> 0.75,\n  PlotLegends -> Placed[LineLegend[eCols, {\"E1\",\"E2\",\"E3\"},\n    LabelStyle -> Directive[White, 12], Background -> darkBg,\n    LegendFunction -> (Framed[#, Background->darkBg,\n                         FrameStyle->fgStyle]&)], Right]\n]",
       "mime": "text/plain"
      }
