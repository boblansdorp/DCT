       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"44\" data-out-n=\"334\" data-sub-idx=\"1\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"55\" data-sub-start=\"3\" data-sub-end=\"3\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[334]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_1hs5q27pri36l.svg\" width=\"1200\" height=\"441\" src=\"img/EAB_DCT_analysis/wl_1hs5q27pri36l.svg\"/></div></div>",
