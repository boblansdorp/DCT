     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq9dbdqb-ojtlvfq\" data-page-width-em=\"106\" data-latex-b64=\"XG1hdGhiZntcdGV4dHszLXN0YXRlIG1vZGVsfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">3-state model</span></span></span></span></span></span></div></div></div></div><div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq9dbdqg-qxtcvj2\" data-page-width-em=\"106\" data-latex-b64=\"XHRleHR7ICB9XHRleHR7S31fe1x0ZXh0e1N9fVx0ZXh0eyA9IH1cdGV4dHswLjIwN31cdGV4dHsgICAgIH1cdGV4dHtLfV97XHRleHR7RH19XHRleHR7ID0gfVx0ZXh0ezUyLjR9XHRleHR7ICRcbXUkTX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">S</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.207</span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">D</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">52.4</span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq9dbdqj-dntg52q\" data-page-width-em=\"106\" data-latex-b64=\"XG1hdGhiZntcdGV4dHs0LXN0YXRlIG1vZGVsfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">4-state model</span></span></span></span></span></span></div></div></div><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq9dbdql-azy2oe9\" data-page-width-em=\"106\" data-latex-b64=\"XHRleHR7ICB9XHRleHR7S31fe1x0ZXh0e1N9fVx0ZXh0eyA9IH1cdGV4dHswLjE0N31cdGV4dHsgICAgIH1cdGV4dHtLfV97XHRleHR7RH19XHRleHR7ID0gfVx0ZXh0ezguM31cdGV4dHsgJFxtdSRNfVx0ZXh0eyAgICAgTkYgPSB9XHRleHR7MC4zMn0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">S</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.147</span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K</span></span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">D</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">8.3</span></span><span class=\"mord text\"><span class=\"mord\"> </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M</span></span><span class=\"mord text\"><span class=\"mord\"> NF = </span></span><span class=\"mord text\"><span class=\"mord\">0.32</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula][formula][formula][formula]",
       "mime": "text/plain"
      }
     ],
     "id": "d9ee6791-a693-4715-a51c-c10375f65a6a"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"932633\" data-output-id=\"20\" data-out-n=\"142\" data-sub-idx=\"12\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"69\" data-sub-start=\"26\" data-sub-end=\"69\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[142]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_qau0q0peveu1.svg\" src=\"img/EAB_DCT_analysis/wl_qau0q0peveu1.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Biophysical model fits using the mechanistic 3-state and 4-state kinetic models.\n   Data: {conc \\[Mu]M, ff} across all electrodes, positive concentrations only. *)\n\n(* --- model equations --- *)\nPrint[Style[\"3-state model  (U \\[LeftRightArrow] F \\[LeftRightArrow] B)\", Bold, 13]];\nPrint[Row[{\"  \", Subscript[\"f\",\"f\"], \" = \", DCTBiophysics`$FF3State}]];\nPrint[Style[\"4-state model  (U \\[LeftRightArrow] F \\[LeftRightArrow] B,  NF non-folding)\", Bold, 13]];\nPrint[Row[{\"  \", Subscript[\"f\",\"f\"], \" = \", DCTBiophysics`$FF4State}]];\nPrint[\"\"];\n\nallPts = Flatten[ffPos, 1];   (* all electrodes, conc > 0 *)\n\nfitResult = DCTBiophysics`FitFoldedFraction[allPts];\n\n(* --- fit parameters --- *)\nModule[{p3 = fitResult[\"Model3\"], p4 = fitResult[\"Model4\"]},\n  Print[Style[\"3-state model\", Bold, 13]];\n  Print[Row[{\"  \", Subscript[\"K\",\"S\"], \" = \", NumberForm[p3[\"KS\"], {4,3}],\n             \"     \", Subscript[\"K\",\"D\"], \" = \", NumberForm[p3[\"KD\"], {6,1}], \" \\[Mu]M\"}]];\n  Print[Style[\"4-state model\", Bold, 13]];\n  Print[Row[{\"  \", Subscript[\"K\",\"S\"], \" = \", NumberForm[p4[\"KS\"], {4,3}],\n             \"     \", Subscript[\"K\",\"D\"], \" = \", NumberForm[p4[\"KD\"], {6,1}], \" \\[Mu]M\",\n             \"     NF = \", NumberForm[p4[\"NF\"], {3,2}]}]]\n];\n\n(* --- plot --- *)\nModule[{ks3, kd3, ks4, kd4, nf4, m3, m4, tMin, tMax, c3pts, c4pts,\n        darkBg, fgStyle, eCols, modelStyles},\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  tMin = Log10[Min[allPts[[All,1]]] * 0.4];\n  tMax = Log10[Max[allPts[[All,1]]] * 3.];\n  c3pts = Table[{10^t, N[m3 /. DCTBiophysics`conc -> 10^t]}, {t, tMin, tMax, (tMax-tMin)/200}];\n  c4pts = Table[{10^t, N[m4 /. DCTBiophysics`conc -> 10^t]}, {t, tMin, tMax, (tMax-tMin)/200}];\n\n  darkBg     = GrayLevel[0.12];\n  fgStyle    = Directive[White, AbsoluteThickness[1.1]];\n  eCols      = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ Range[Length[concElectrodes]];\n  modelStyles = {Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]], Directive[White, AbsoluteThickness[2.]]};\n\n  ListLinePlot[\n    Join[ffPos, {c3pts, c4pts}],\n    ScalingFunctions -> {\"Log10\", None},\n    (* data series = points only; the two model curves stay joined as lines *)\n    Joined -> Join[ConstantArray[False, Length[concElectrodes]], {True, True}],\n    PlotMarkers -> Join[ConstantArray[{Automatic, 10}, Length[concElectrodes]], {None, None}],\n    PlotStyle -> Join[eCols, modelStyles],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., White], None}, {DCTPlots`ThemeLogTicks[0.8, cHi, White], None}},\n    FrameTicksStyle -> Directive[White, 12],\n    Frame -> True, Axes -> False, Background -> darkBg, FrameStyle -> fgStyle,\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, White], Style[\"Fraction folded\", 14, White]},\n    PlotRange -> {{0.8, cHi}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, concElectrodes,\n      LabelStyle -> Directive[White, 12], Background -> darkBg,\n      LegendFunction -> (Framed[#, Background->darkBg, FrameStyle->fgStyle]&)], Right],\n    Epilog -> {\n      {Directive[GrayLevel[0.65], Dashed, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", GrayLevel[0.65], 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.91}]],\n      {Directive[White, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", White, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.83}]]\n    }\n  ]\n]",
       "mime": "text/plain"
      }
     ],
     "id": "ac9a393c-ab47-47a8-8da3-a483103071ea"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5a.2 Linear-linear plot",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Linear-linear plot \\[Dash] includes 0 \\[Mu]M data the log-x plot can't show.\n   Defined as a function so Section 6 can re-render it white in the Publication\n   block (it reads DCTPlots`$DCTTheme at call time; dark on screen otherwise). *)\nbiophysLinearPlot[] := Module[\n  {pub, fg, bg, ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts, eCols, modelStyles},\n  pub = (DCTPlots`$DCTTheme === \"Publication\");\n  fg  = If[pub, Black, White];\n  bg  = If[pub, White, GrayLevel[0.12]];\n\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  eCols       = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ Range[Length[concElectrodes]];\n  modelStyles = {Directive[Gray, Dashed, AbsoluteThickness[2.]], Directive[fg, AbsoluteThickness[2.]]};\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    (* data series = points only; the two model curves stay joined as lines *)\n    Joined -> Join[ConstantArray[False, Length[concElectrodes]], {True, True}],\n    PlotMarkers -> Join[ConstantArray[{Automatic, 10}, Length[concElectrodes]], {None, None}],\n    PlotStyle -> Join[eCols, modelStyles],\n    PlotTheme -> \"Default\",\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., fg], None}, {DCTPlots`ThemeLinTicks[0., cMax * 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 12],\n    Frame -> True, Axes -> False, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Fraction folded\", 14, fg]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, concElectrodes,\n      LabelStyle -> Directive[fg, 12], Background -> bg,\n      LegendFunction -> (Framed[#, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]]] &)], Right],\n    Epilog -> {\n      {Directive[Gray, Dashed, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", Gray, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.91}]],\n      {Directive[fg, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", fg, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.83}]]\n    }\n  ]\n];\n\nbiophysLinearPlot[]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"932633\" data-output-id=\"21\" data-out-n=\"144\" data-sub-idx=\"2\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"71\" data-sub-start=\"50\" data-sub-end=\"50\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[144]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1ewl97571nyck.svg\" src=\"img/EAB_DCT_analysis/wl_1ewl97571nyck.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Linear-linear plot \\[Dash] includes 0 \\[Mu]M data the log-x plot can't show.\n   Defined as a function so Section 6 can re-render it white in the Publication\n   block (it reads DCTPlots`$DCTTheme at call time; dark on screen otherwise). *)\nbiophysLinearPlot[] := Module[\n  {pub, fg, bg, ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts, eCols, modelStyles},\n  pub = (DCTPlots`$DCTTheme === \"Publication\");\n  fg  = If[pub, Black, White];\n  bg  = If[pub, White, GrayLevel[0.12]];\n\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  eCols       = Directive[ColorData[97][#], AbsoluteThickness[1.8], Opacity[0.65]] & /@ Range[Length[concElectrodes]];\n  modelStyles = {Directive[Gray, Dashed, AbsoluteThickness[2.]], Directive[fg, AbsoluteThickness[2.]]};\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    (* data series = points only; the two model curves stay joined as lines *)\n    Joined -> Join[ConstantArray[False, Length[concElectrodes]], {True, True}],\n    PlotMarkers -> Join[ConstantArray[{Automatic, 10}, Length[concElectrodes]], {None, None}],\n    PlotStyle -> Join[eCols, modelStyles],\n    PlotTheme -> \"Default\",\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., fg], None}, {DCTPlots`ThemeLinTicks[0., cMax * 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 12],\n    Frame -> True, Axes -> False, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Fraction folded\", 14, fg]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.04],\n    ImageSize -> 540, AspectRatio -> 0.75,\n    PlotLegends -> Placed[LineLegend[eCols, concElectrodes,\n      LabelStyle -> Directive[fg, 12], Background -> bg,\n      LegendFunction -> (Framed[#, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]]] &)], Right],\n    Epilog -> {\n      {Directive[Gray, Dashed, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.91}], Scaled[{0.67, 0.91}]}]},\n      Text[Style[\"3-state model\", Gray, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.91}]],\n      {Directive[fg, AbsoluteThickness[2.]], Line[{Scaled[{0.58, 0.83}], Scaled[{0.67, 0.83}]}]},\n      Text[Style[\"4-state model\", fg, 11, FontFamily -> \"Arial\"], Scaled[{0.79, 0.83}]]\n    }\n  ]\n];\n\nbiophysLinearPlot[]",
       "mime": "text/plain"
      }
     ],
     "id": "fbc5c0e9-ef6b-4cfa-a94f-5656c05f910e"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5b. Equivalent-circuit (CPE) fits\n\nClassical equivalent-circuit comparison to the DCT inversion. Each concentration spectrum is fit to **Rs + [C_DL || (Rct + CPE)]** via `CPEFit`FitCPE`. The faradaic branch gives an apparent electron-transfer rate **k_et = 1/(Q·Rct)** (Q is the CPE coefficient, i.e. Y_CPE; an exact RC rate for n=1, a proxy otherwise). The plot shows k_et vs [vancomycin] per electrode.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Fit every concentration spectrum to  Rs + [Cdl || (Rct + CPE)] *)\ncpeResults = <|\"File\" -> #File,\n   \"Fit\" -> CPEFit`FitCPE[#Spec[\"FreqHz\"], #Spec[\"ZData\"]]|> & /@ concGoodSpecs;\n\n(* electron-transfer rate proxy  k_et = 1/(Q Rct)  per spectrum, by electrode\n   (drop 0 uM so it can go on a log concentration axis) *)\ncpeConcUM[lbl_] := ToExpression @ First[StringCases[lbl, d : NumberString ~~ \" \\[Mu]M\" :> d], \"0\"];\nketByElectrode = Table[\n  Module[{subs},\n    subs = Select[cpeResults, StringStartsQ[#File, e] &];\n    Select[Transpose[{cpeConcUM /@ subs[[All, \"File\"]],\n                      1./(#Fit[\"Q\"] #Fit[\"Rct\"]) & /@ subs}], First[#] > 0 &]],\n  {e, concElectrodes}];\n\nModule[{eCols, allC, allK, cR, kR},\n  eCols = Directive[ColorData[97][#], AbsoluteThickness[1.8]] & /@ Range[Length[concElectrodes]];\n  allC  = Flatten[ketByElectrode[[All, All, 1]]];\n  allK  = Flatten[ketByElectrode[[All, All, 2]]];\n  cR = MinMax[allC]; kR = MinMax[allK];\n  ListLinePlot[ketByElectrode,\n    ScalingFunctions -> {\"Log10\", \"Log10\"}, Joined -> False,\n    PlotMarkers -> {Automatic, 10}, PlotStyle -> eCols,\n    Frame -> True, Axes -> False, Background -> GrayLevel[0.12],\n    FrameStyle -> Directive[White, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLogTicks[kR[[1]], kR[[2]], White], None},\n                   {DCTPlots`ThemeLogTicks[cR[[1]], cR[[2]], White], None}},\n    FrameTicksStyle -> Directive[White, 12],\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, White],\n                   Style[\"k_et = 1/(Q R_ct)  (1/s)\", 14, White]},\n    ImageSize -> 540, AspectRatio -> 0.72, PlotRangePadding -> Scaled[0.06],\n    PlotLegends -> Placed[LineLegend[eCols, concElectrodes,\n      LabelStyle -> Directive[White, 12], Background -> GrayLevel[0.12],\n      LegendFunction -> (Framed[#, Background -> GrayLevel[0.12], FrameStyle -> Directive[White, AbsoluteThickness[1.1]]] &)], Right]]\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"932633\" data-output-id=\"22\" data-out-n=\"148\" data-sub-idx=\"5\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"73\" data-sub-start=\"14\" data-sub-end=\"34\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[148]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_vw0qw78k283q.svg\" src=\"img/EAB_DCT_analysis/wl_vw0qw78k283q.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Fit every concentration spectrum to  Rs + [Cdl || (Rct + CPE)] *)\ncpeResults = <|\"File\" -> #File,\n   \"Fit\" -> CPEFit`FitCPE[#Spec[\"FreqHz\"], #Spec[\"ZData\"]]|> & /@ concGoodSpecs;\n\n(* electron-transfer rate proxy  k_et = 1/(Q Rct)  per spectrum, by electrode\n   (drop 0 uM so it can go on a log concentration axis) *)\ncpeConcUM[lbl_] := ToExpression @ First[StringCases[lbl, d : NumberString ~~ \" \\[Mu]M\" :> d], \"0\"];\nketByElectrode = Table[\n  Module[{subs},\n    subs = Select[cpeResults, StringStartsQ[#File, e] &];\n    Select[Transpose[{cpeConcUM /@ subs[[All, \"File\"]],\n                      1./(#Fit[\"Q\"] #Fit[\"Rct\"]) & /@ subs}], First[#] > 0 &]],\n  {e, concElectrodes}];\n\nModule[{eCols, allC, allK, cR, kR},\n  eCols = Directive[ColorData[97][#], AbsoluteThickness[1.8]] & /@ Range[Length[concElectrodes]];\n  allC  = Flatten[ketByElectrode[[All, All, 1]]];\n  allK  = Flatten[ketByElectrode[[All, All, 2]]];\n  cR = MinMax[allC]; kR = MinMax[allK];\n  ListLinePlot[ketByElectrode,\n    ScalingFunctions -> {\"Log10\", \"Log10\"}, Joined -> False,\n    PlotMarkers -> {Automatic, 10}, PlotStyle -> eCols,\n    Frame -> True, Axes -> False, Background -> GrayLevel[0.12],\n    FrameStyle -> Directive[White, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLogTicks[kR[[1]], kR[[2]], White], None},\n                   {DCTPlots`ThemeLogTicks[cR[[1]], cR[[2]], White], None}},\n    FrameTicksStyle -> Directive[White, 12],\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, White],\n                   Style[\"k_et = 1/(Q R_ct)  (1/s)\", 14, White]},\n    ImageSize -> 540, AspectRatio -> 0.72, PlotRangePadding -> Scaled[0.06],\n    PlotLegends -> Placed[LineLegend[eCols, concElectrodes,\n      LabelStyle -> Directive[White, 12], Background -> GrayLevel[0.12],\n      LegendFunction -> (Framed[#, Background -> GrayLevel[0.12], FrameStyle -> Directive[White, AbsoluteThickness[1.1]]] &)], Right]]\n]",
       "mime": "text/plain"
      }
     ],
     "id": "5bc6db58-e5c2-46e9-9073-3cc72e18c813"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* CPE-model reconstruction residuals, all concentration spectra overlaid\n   (directly comparable to the DCT residuals in 4a.4) *)\nDCTPlots`PlotResiduals[cpeResults[[All, \"Fit\"]]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"932633\" data-output-id=\"23\" data-out-n=\"149\" data-sub-idx=\"1\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"74\" data-sub-start=\"2\" data-sub-end=\"2\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[149]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1udmsk76owc7n.svg\" src=\"img/EAB_DCT_analysis/wl_1udmsk76owc7n.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* CPE-model reconstruction residuals, all concentration spectra overlaid\n   (directly comparable to the DCT residuals in 4a.4) *)\nDCTPlots`PlotResiduals[cpeResults[[All, \"Fit\"]]]",
       "mime": "text/plain"
      }
     ],
     "id": "439855eb-4ee2-495e-b07e-2f5c3e3c321e"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5c. DCT vs CPE comparison\n\nDCT (regularised g(k) inversion, resolving two k-peaks) vs the CPE circuit (unregularised, 5 free parameters, a single faradaic relaxation) on the **same** concentration spectra. Below: per-spectrum R_s, C_dl, and reconstruction error from each method. The DCT minimises *misfit + λ·roughness* — it trades fit quality for a smooth physical distribution — so a slightly lower CPE residual is expected and is not by itself evidence the CPE is the better model.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* DCT (regularised g(k) inversion) vs CPE (5-param circuit), same spectra *)\ndctRelResid[s_] := Sqrt[Mean[Abs[(s[\"ZFit\"] - s[\"ZData\"]) / s[\"ZData\"]]^2]];\ndctR = dctRelResid[#[\"Spec\"]] & /@ concGoodSpecs;\ncpeR = #[\"Fit\"][\"RelResid\"] & /@ cpeResults;\n\nPrint[Style[Row[{\"Median reconstruction error:   DCT = \",\n   NumberForm[100 Median[dctR], {4, 2}], \" %      CPE = \",\n   NumberForm[100 Median[cpeR], {4, 2}], \" %\"}], 14, Bold]];\nPrint[Row[{\"CPE lower-error on \",\n   Count[Transpose[{dctR, cpeR}], {a_, b_} /; b < a], \" of \", Length[dctR], \" spectra.\"}]];\n\nGrid[Prepend[\n  MapThread[\n    {#1[\"File\"], #1[\"Spec\"][\"Rs\"], #2[\"Fit\"][\"Rs\"],\n     #1[\"Spec\"][\"C0\"] 1.*^9, #2[\"Fit\"][\"Cdl\"] 1.*^9,\n     100. dctRelResid[#1[\"Spec\"]], 100. #2[\"Fit\"][\"RelResid\"]} &,\n    {concGoodSpecs, cpeResults}] /. x_?NumericQ :> NumberForm[N[x], 4],\n  Style[#, Bold] & /@ {\"Spectrum\", \"Rs DCT\", \"Rs CPE\", \"Cdl DCT (nF)\", \"Cdl CPE (nF)\", \"resid DCT %\", \"resid CPE %\"}],\n  Frame -> All, Alignment -> {{Left, Right, Right, Right, Right, Right, Right}},\n  Spacings -> {1.2, 0.35}, BaseStyle -> 10]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq9dbuqp-q1plmb9\" data-page-width-em=\"106\" data-latex-b64=\"XG1hdGhiZntcdGV4dHtNZWRpYW4gcmVjb25zdHJ1Y3Rpb24gZXJyb3I6ICAgRENUID0gfVx0ZXh0ezIuMTB9XHRleHR7IFwlICAgICAgQ1BFID0gfVx0ZXh0ezEuMjJ9XHRleHR7IFwlfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8056em;vertical-align:-0.0556em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">Median reconstruction error: DCT = </span></span><span class=\"mord text\"><span class=\"mord\">2.10</span></span><span class=\"mord text\"><span class=\"mord\"> % CPE = </span></span><span class=\"mord text\"><span class=\"mord\">1.22</span></span><span class=\"mord text\"><span class=\"mord\"> %</span></span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "21985ed6-9928-4d8f-b243-8699918dc918"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mq9dbuqu-0m14pu4\" data-page-width-em=\"106\" data-latex-b64=\"XHRleHR7Q1BFIGxvd2VyLWVycm9yIG9uIH0zOVx0ZXh0eyBvZiB9MzlcdGV4dHsgc3BlY3RyYS59\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">CPE lower-error on </span></span><span class=\"mord\">39</span><span class=\"mord text\"><span class=\"mord\"> of </span></span><span class=\"mord\">39</span><span class=\"mord text\"><span class=\"mord\"> spectra.</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "2bc77cb9-776a-4047-8a5c-2b5477fafe6c"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"932633\" data-output-id=\"24\" data-out-n=\"155\" data-sub-idx=\"6\" data-output-format=\"SVGT\" data-output-is-graphics=\"0\" data-cell-idx=\"76\" data-sub-start=\"11\" data-sub-end=\"19\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[155]=</span></div><div class=\"wl-output-content\"><img class=\"vscode-wolfram-png-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_634mgygzbroo.png\" src=\"img/EAB_DCT_analysis/wl_634mgygzbroo.png\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "f14f6466-b3f5-4509-874e-815431c2f0c2"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5d. Two-relaxation model discrimination\n\nDoes the impedance actually require **two** faradaic relaxations? Each spectrum is refit to **Rs + [C_DL || (Rct1+CPE1) || (Rct2+CPE2)]** (`CPEFit`FitCPE2`) and compared to the single branch by a nested-model **F-test** (5 vs 8 parameters). If the second branch is real, the residual drops far beyond chance and two stable, distinct rates k_et = 1/(Q·Rct) emerge — one slow, one fast — whose amplitudes Y0 = Q redistribute with [vancomycin]. Spectra where a branch runs past the measurement band (k_et outside 5–3000 /s) are dropped as unresolved.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Refit each concentration spectrum with TWO faradaic branches and compare to\n   the single branch by an F-test (nested models, 5 vs 8 parameters). *)\ncpe2Conc[lbl_] := ToExpression @ First[StringCases[lbl, d : NumberString ~~ \" \\[Mu]M\" :> d], \"0\"];\ncpe2Results = <|\"Elec\" -> StringTake[#File, 2], \"Conc\" -> cpe2Conc[#File],\n   \"Fit1\" -> CPEFit`FitCPE[#Spec[\"FreqHz\"], #Spec[\"ZData\"]],\n   \"Fit2\" -> CPEFit`FitCPE2[#Spec[\"FreqHz\"], #Spec[\"ZData\"]]|> & /@ concGoodSpecs;\n(* keep spectra where both rates are resolvable within the band (5..3000 /s) *)\ncpe2Good = Select[cpe2Results, 5. < #Fit2[\"ket1\"] < 3000. && 5. < #Fit2[\"ket2\"] < 3000. &];\n\nModule[{fOf, fVals, df2},\n  fOf[r_] := Module[{n}, n = 2 Length[r[\"Fit1\"][\"FreqHz\"]];\n    ((r[\"Fit1\"][\"ChiSq\"] - r[\"Fit2\"][\"ChiSq\"]) / 3) / (r[\"Fit2\"][\"ChiSq\"] / (n - 8))];\n  fVals = fOf /@ cpe2Good;\n  df2 = 2 Length[concGoodSpecs[[1, \"Spec\"]][\"FreqHz\"]] - 8;\n  Print[Style[Row[{\"Median residual:   single-branch = \",\n     NumberForm[100 Median[#Fit1[\"RelResid\"] & /@ cpe2Good], {3, 2}], \" %       two-branch = \",\n     NumberForm[100 Median[#Fit2[\"RelResid\"] & /@ cpe2Good], {3, 2}], \" %\"}], Bold, 13]];\n  Print[Row[{\"Median F(3, \", df2, \") = \", NumberForm[Median[fVals], {6, 1}],\n     \"   vs  F_crit(p=0.001) \\[TildeEqual] \", NumberForm[Quantile[FRatioDistribution[3, df2], 0.999], {4, 1}],\n     \"   \\[Rule]  second relaxation justified in \", Length[cpe2Good], \"/\", Length[cpe2Results], \" spectra\"}]]\n];\n\n(* theme-aware diagnostic plots: dark on screen, white in the export block *)\ncpe2Cols = {RGBColor[0.30, 0.45, 0.95], RGBColor[0.95, 0.55, 0.15]};\ncpe2Sty[fg_, bg_] := Sequence[Frame -> True, Axes -> False, Background -> bg, PlotTheme -> \"Default\",\n   FrameStyle -> Directive[fg, AbsoluteThickness[1.1]], FrameTicksStyle -> Directive[fg, 12],\n   LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"], ImageSize -> 520, AspectRatio -> 0.7,\n   PlotRangePadding -> Scaled[0.05]];\n\ncpe2KetPlot[] := Module[{pub, fg, bg, slow, fast},\n  pub = (DCTPlots`$DCTTheme === \"Publication\"); fg = If[pub, Black, White]; bg = If[pub, White, GrayLevel[0.12]];\n  slow = {#Conc, #Fit2[\"ket1\"]} & /@ cpe2Good;  fast = {#Conc, #Fit2[\"ket2\"]} & /@ cpe2Good;\n  ListPlot[{slow, fast}, ScalingFunctions -> {None, \"Log10\"},\n    PlotStyle -> (Directive[#, PointSize[0.02]] & /@ cpe2Cols), cpe2Sty[fg, bg],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"k_et = 1/(Q R_ct)  (1/s)\", 14, fg]},\n    PlotLegends -> Placed[PointLegend[cpe2Cols, {\"slow\", \"fast\"}, LabelStyle -> Directive[fg, 12]], {0.82, 0.5}]]];\n\ncpe2Y0Plot[] := Module[{pub, fg, bg, slow, fast},\n  pub = (DCTPlots`$DCTTheme === \"Publication\"); fg = If[pub, Black, White]; bg = If[pub, White, GrayLevel[0.12]];\n  slow = {#Conc, #Fit2[\"Q1\"]} & /@ cpe2Good;  fast = {#Conc, #Fit2[\"Q2\"]} & /@ cpe2Good;\n  ListPlot[{slow, fast}, ScalingFunctions -> {None, \"Log10\"},\n    PlotStyle -> (Directive[#, PointSize[0.02]] & /@ cpe2Cols), cpe2Sty[fg, bg],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Y0 = Q  (S s^n)\", 14, fg]},\n    PlotLegends -> Placed[PointLegend[cpe2Cols, {\"slow\", \"fast\"}, LabelStyle -> Directive[fg, 12]], {0.82, 0.5}]]];\n\ncpe2RatioPlot[] := Module[{pub, fg, bg, elecs, eCols, byE},\n  pub = (DCTPlots`$DCTTheme === \"Publication\"); fg = If[pub, Black, White]; bg = If[pub, White, GrayLevel[0.12]];\n  elecs = concElectrodes; eCols = ColorData[97] /@ Range[Length[elecs]];\n  byE = Table[SortBy[{#Conc, #Fit2[\"Q2\"]/(#Fit2[\"Q1\"] + #Fit2[\"Q2\"])} & /@ Select[cpe2Good, #Elec === e &], First], {e, elecs}];\n  ListLinePlot[byE, Joined -> False, PlotMarkers -> {Automatic, 12},\n    PlotStyle -> (Directive[#, AbsoluteThickness[1.5]] & /@ eCols), cpe2Sty[fg, bg],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Y0_fast / (Y0_fast + Y0_slow)\", 14, fg]},\n    PlotRange -> {Automatic, {0, 1}},\n    PlotLegends -> Placed[PointLegend[eCols, elecs, LabelStyle -> Directive[fg, 12]], Right]]];\n\n\"5d two-branch fits + plot functions defined\"",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 5d.1  electron-transfer rates: two stable, distinct bands vs [vancomycin] *)\ncpe2KetPlot[]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 5d.2  CPE amplitudes Y0 = Q: slow shrinks, fast grows with [vancomycin] *)\ncpe2Y0Plot[]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 5d.3  fast-population fraction Y0_fast/(Y0_fast+Y0_slow) — the binding isotherm *)\ncpe2RatioPlot[]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## 6. Export\nExports key figures as PDFs to a `figures/` folder next to `dataDir`.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 6.1 Export figures",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "exportFigure = True; (* set to True to export all figures as PDF + PNG *)\n\nIf[exportFigure,\n  figDir = FileNameJoin[{DirectoryName[dataDir], \"figures\"}];\n  If[!DirectoryQ[figDir], CreateDirectory[figDir]];\n  Print[\"Saving to: \", figDir];\n\n  (* PDF = vector (for LaTeX / print); PNG = 300 dpi raster (paste into Google\n     Docs / Slides \\[Dash] those don't accept PDF or SVG natively). *)\n  exportFig[fig_, name_] := (\n    Export[FileNameJoin[{figDir, name <> \".pdf\"}], fig];\n    Export[FileNameJoin[{figDir, name <> \".png\"}], fig, ImageResolution -> 300];\n    Print[\"\\[Checkmark] \", name]\n  );\n\n  (* Figures in notebook order, Publication theme (white). *)\n  Block[{DCTPlots`$DCTTheme = \"Publication\"},\n\n    (* Method validation \\[Dash] synthetic recovery: figure + parameter table *)\n    If[ValueQ[simRec],\n      exportFig[DCTPlots`PlotCombValidation[simK, gSim, simRec], \"validation_comb\"]];\n    If[ValueQ[validationTable],\n      exportFig[validationTable, \"validation_table\"]];\n\n    (* Section 1 \\[Dash] Lin-KK residuals *)\n    exportFig[DCTPlots`PlotKKResiduals[kkRep], \"drift_kkResiduals\"];\n\n    (* Section 1 \\[Dash] admittance-variance power law (fMin determination, SI) *)\n    If[ValueQ[driftStats],\n      exportFig[DCTPlots`PlotVariancePowerLaw[driftStats, fMinHz, fMaxHz], \"drift_variancePowerLaw\"]];\n\n    (* 4a.1 \\[Dash] drift g(k): E1, hour-mark legend, nF/decade *)\n    exportFig[DCTPlots`PlotGK[e1Specs, DCTPlots`HourMarkLabels[e1Specs], \"GScale\" -> 1*^9],\n      \"drift_gK\"];\n\n    (* 4a.4 \\[Dash] reconstruction residuals, all spectra overlaid (SI accuracy figure) *)\n    exportFig[DCTPlots`PlotResiduals[goodSpecs[[All, \"Spec\"]]], \"drift_residuals\"];\n\n    (* 4a.5 \\[Dash] Rs and C0 vs time, aligned time axes *)\n    exportFig[\n      Column[{\n        DCTPlots`PlotRsVsTime[goodSpecs, ImagePadding -> {{85, 20}, {38, 8}}],\n        DCTPlots`PlotC0VsTime[goodSpecs, ImagePadding -> {{85, 20}, {38, 8}}]\n      }, Alignment -> Left, Spacings -> 1],\n      \"drift_RsC0\"];\n\n    (* 4a.7 \\[Dash] k_peak vs time, per k-range *)\n    exportFig[DCTPlots`PlotKPeakVsTime[goodSpecs, kPeakRanges], \"drift_kPeak\"];\n\n    (* One g(k) heatmap per electrode, titled (rasterised \\[Dash] 100s of columns) *)\n    KeyValueMap[\n      (exportFig[\n         Rasterize[DCTPlots`PlotDCTHeatmap[#2, PlotLabel -> Style[#1, 18]],\n           ImageResolution -> 300],\n         \"drift_heatmap_\" <> #1] &),\n      GroupBy[goodSpecs, FileNameTake[#[\"File\"], {-2}] &]\n    ];\n\n    (* Section 5 \\[Dash] concentration g(k): E1, area-normalised *)\n    If[ValueQ[concE1] && Length[concE1] > 0,\n      exportFig[DCTPlots`PlotGK[concE1, Automatic, \"AreaNorm\" -> True], \"conc_gK\"]];\n\n    (* 5a.2 \\[Dash] fraction folded vs [vancomycin], linear, with 3/4-state model fits *)\n    If[ValueQ[fitResult] && ValueQ[ffPerElectrode],\n      exportFig[biophysLinearPlot[], \"biophys_linear\"]];\n\n    (* 5d \\[Dash] two-relaxation discrimination: k_et, Y0, fast-fraction vs conc *)\n    If[ValueQ[cpe2Good] && Length[cpe2Good] > 0,\n      exportFig[cpe2KetPlot[], \"cpe2_ket\"];\n      exportFig[cpe2Y0Plot[], \"cpe2_y0\"];\n      exportFig[cpe2RatioPlot[], \"cpe2_ratio\"]];\n  ];\n\n  Print[Style[\"Export done.\", Bold, Darker[Green]]],\n\n  Print[Style[\"exportFigure = False \\[Dash] set to True to export.\", Italic, GrayLevel[0.6]]]\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
