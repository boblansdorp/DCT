     "id": "33d784ad-7306-49a6-8771-f6578155a26c"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"65\" data-latex-b64=\"XG1hdGhiZntcdGV4dGNvbG9yeyMwMGZmMDB9e1x0ZXh0ezM5IC8gMzkgZml0cyBzdWNjZWVkZWQg4oCTIGVsZWN0cm9kZXMgQTEsIEEyLCBBMywgQjEsIEIyLCBCMy59fX0=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord text\" style=\"color:#00ff00;\"><span class=\"mord\" style=\"color:#00ff00;\">39 / 39 fits succeeded – electrodes A1, A2, A3, B1, B2, B3.</span></span></span></span></span></span></div></div></div>",
