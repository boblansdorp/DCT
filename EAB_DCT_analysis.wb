  {
   "kind": 2,
   "value": "(* Nyquist + Bode for a single file — change index as needed *)\ni = 40; (* <── change this to pick a different file *)\nDCTPlots`PlotBode[goodSpecs[[i, \"Spec\"]]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
