  {
   "kind": 1,
   "value": "### 5a.2 Linear-linear plot",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Linear-linear plot \\[Dash] includes 0 \\[Mu]M data the log-x plot can't show.\n   Defined as a function so Section 6 can re-render it white in the Publication\n   block (it reads DCTPlots`$DCTTheme at call time; dark on screen otherwise).\n   No legend: data are one translucent cloud (overlapping points darken), and the\n   two model curves are labelled directly \\[Dash] 3-state above, 4-state below. *)\nbiophysLinearPlot[] := Module[\n  {pub, fg, bg, ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts,\n   ptStyle, gray3, heroRGB, heroCol, c3a, f3a, c4a, f4a},\n  pub = (DCTPlots`$DCTTheme === \"Publication\");\n  fg  = If[pub, Black, White];\n  bg  = If[pub, White, GrayLevel[0.12]];\n\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  ptStyle = Directive[RGBColor[0.2, 0.45, 0.85], Opacity[0.45]];                          (* translucent: overlaps darken *)\n  gray3   = Directive[Gray, Dashed, AbsoluteThickness[2.2]];        (* 3-state *)\n  heroRGB = RGBColor[0.95, 0.55, 0.15];\n  heroCol = Directive[heroRGB, AbsoluteThickness[2.8]];             (* 4-state = hero *)\n\n  (* label anchor points on each curve *)\n  c3a = cMax * 0.76; f3a = N[m3 /. DCTBiophysics`conc -> c3a];\n  c4a = cMax * 0.36; f4a = N[m4 /. DCTBiophysics`conc -> c4a];\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    Joined -> Join[ConstantArray[False, Length[concElectrodes]], {True, True}],\n    PlotMarkers -> Join[ConstantArray[{\"\\[FilledCircle]\", 9}, Length[concElectrodes]], {None, None}],\n    PlotStyle -> Join[ConstantArray[ptStyle, Length[concElectrodes]], {gray3, heroCol}],\n    PlotTheme -> \"Default\",\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., fg], None}, {DCTPlots`ThemeLinTicks[0., cMax * 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 12],\n    Frame -> True, Axes -> False, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Fraction folded\", 14, fg]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.03],\n    ImageSize -> 580, AspectRatio -> 0.72,\n    Epilog -> {\n      (* 3-state: text ABOVE, thin leader down to the dashed curve *)\n      Gray, AbsoluteThickness[1.], Line[{{c3a, Min[f3a + 0.13, 0.9]}, {c3a, f3a + 0.015}}],\n      Text[Style[\"3-state model\", Gray, 12, FontFamily -> \"Arial\"], {c3a, Min[f3a + 0.155, 0.93]}],\n      (* 4-state: text BELOW, arrow UP to the solid curve *)\n      heroRGB, Arrowheads[0.028], AbsoluteThickness[1.4], Arrow[{{c4a, Max[f4a - 0.17, 0.1]}, {c4a, f4a - 0.015}}],\n      Text[Style[\"4-state model\", heroRGB, 12, FontFamily -> \"Arial\"], {c4a, Max[f4a - 0.2, 0.06]}]\n    }\n  ]\n];\n\nbiophysLinearPlot[]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"118457\" data-output-id=\"33\" data-out-n=\"208\" data-sub-idx=\"2\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"77\" data-sub-start=\"57\" data-sub-end=\"57\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[208]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_tl537rxzx3st.svg\" src=\"img/EAB_DCT_analysis/wl_tl537rxzx3st.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Linear-linear plot \\[Dash] includes 0 \\[Mu]M data the log-x plot can't show.\n   Defined as a function so Section 6 can re-render it white in the Publication\n   block (it reads DCTPlots`$DCTTheme at call time; dark on screen otherwise).\n   No legend: data are one translucent cloud (overlapping points darken), and the\n   two model curves are labelled directly \\[Dash] 3-state above, 4-state below. *)\nbiophysLinearPlot[] := Module[\n  {pub, fg, bg, ks3, kd3, ks4, kd4, nf4, m3, m4, cMax, cPts, c3pts, c4pts,\n   ptStyle, gray3, heroRGB, heroCol, c3a, f3a, c4a, f4a},\n  pub = (DCTPlots`$DCTTheme === \"Publication\");\n  fg  = If[pub, Black, White];\n  bg  = If[pub, White, GrayLevel[0.12]];\n\n  ks3 = fitResult[\"Model3\", \"KS\"];  kd3 = fitResult[\"Model3\", \"KD\"];\n  ks4 = fitResult[\"Model4\", \"KS\"];  kd4 = fitResult[\"Model4\", \"KD\"];\n  nf4 = fitResult[\"Model4\", \"NF\"];\n  m3 = DCTBiophysics`$FF3State /. {DCTBiophysics`KS -> ks3, DCTBiophysics`KD -> kd3};\n  m4 = DCTBiophysics`$FF4State /. {DCTBiophysics`KS -> ks4, DCTBiophysics`KD -> kd4, DCTBiophysics`NF -> nf4};\n\n  cMax = Max[ffPerElectrode[[All, All, 1]]];\n  cPts = Range[0., cMax * 1.05, cMax / 300.];\n  c3pts = {#, N[m3 /. DCTBiophysics`conc -> #]} & /@ cPts;\n  c4pts = {#, N[m4 /. DCTBiophysics`conc -> #]} & /@ cPts;\n\n  ptStyle = Directive[RGBColor[0.2, 0.45, 0.85], Opacity[0.45]];                          (* translucent: overlaps darken *)\n  gray3   = Directive[Gray, Dashed, AbsoluteThickness[2.2]];        (* 3-state *)\n  heroRGB = RGBColor[0.95, 0.55, 0.15];\n  heroCol = Directive[heroRGB, AbsoluteThickness[2.8]];             (* 4-state = hero *)\n\n  (* label anchor points on each curve *)\n  c3a = cMax * 0.76; f3a = N[m3 /. DCTBiophysics`conc -> c3a];\n  c4a = cMax * 0.36; f4a = N[m4 /. DCTBiophysics`conc -> c4a];\n\n  ListLinePlot[\n    Join[ffPerElectrode, {c3pts, c4pts}],\n    Joined -> Join[ConstantArray[False, Length[concElectrodes]], {True, True}],\n    PlotMarkers -> Join[ConstantArray[{\"\\[FilledCircle]\", 9}, Length[concElectrodes]], {None, None}],\n    PlotStyle -> Join[ConstantArray[ptStyle, Length[concElectrodes]], {gray3, heroCol}],\n    PlotTheme -> \"Default\",\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[0., 1., fg], None}, {DCTPlots`ThemeLinTicks[0., cMax * 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 12],\n    Frame -> True, Axes -> False, Background -> bg, FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Fraction folded\", 14, fg]},\n    PlotRange -> {{0, cMax * 1.05}, {0, 1}},\n    PlotRangePadding -> Scaled[0.03],\n    ImageSize -> 580, AspectRatio -> 0.72,\n    Epilog -> {\n      (* 3-state: text ABOVE, thin leader down to the dashed curve *)\n      Gray, AbsoluteThickness[1.], Line[{{c3a, Min[f3a + 0.13, 0.9]}, {c3a, f3a + 0.015}}],\n      Text[Style[\"3-state model\", Gray, 12, FontFamily -> \"Arial\"], {c3a, Min[f3a + 0.155, 0.93]}],\n      (* 4-state: text BELOW, arrow UP to the solid curve *)\n      heroRGB, Arrowheads[0.028], AbsoluteThickness[1.4], Arrow[{{c4a, Max[f4a - 0.17, 0.1]}, {c4a, f4a - 0.015}}],\n      Text[Style[\"4-state model\", heroRGB, 12, FontFamily -> \"Arial\"], {c4a, Max[f4a - 0.2, 0.06]}]\n    }\n  ]\n];\n\nbiophysLinearPlot[]",
       "mime": "text/plain"
      }
     ],
     "id": "90cfc562-b19f-46f4-b0cb-819d4a09daef"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5a.3 Goodness of fit (R², RMSD)\nR², adjusted R², and RMSD for the 3-state and 4-state fraction-folded fits, with AIC / BIC for model selection. Metrics come straight from the `NonlinearModelFit` objects, computed on all pooled fraction-folded data (every electrode, including the 0 µM baseline). Adjusted R² and AIC / BIC penalise the 4-state model's extra parameter (NF).",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 5a.3  Goodness of fit for the two fraction-folded models.\n   R^2, adjusted R^2 and RMSD for the 3-state and 4-state fits, plus AIC / BIC for model\n   selection.  Metrics come straight from the NonlinearModelFit objects, computed on all\n   pooled fraction-folded data (every electrode, including the 0 \\[Mu]M baseline).  Higher\n   adjusted R^2 and lower AIC/BIC favour a model; adjusted R^2 and AIC/BIC penalise the\n   4-state model's extra parameter (NF).  Theme-aware. *)\n\ngofTable[] := Module[\n  {fg, bg, f3, f4, n, gof, hdr, rows, fmt},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  f3 = fitResult[\"Model3\", \"FitObject\"]; f4 = fitResult[\"Model4\", \"FitObject\"];\n  n  = Length[allPts];\n\n  fmt[x_, d_] := NumberForm[N[x], {7, d}];\n  gof[f_, k_] := {fmt[f[\"RSquared\"], 4], fmt[f[\"AdjustedRSquared\"], 4],\n     fmt[Sqrt[Mean[f[\"FitResiduals\"]^2]], 4], k, fmt[f[\"AIC\"], 1], fmt[f[\"BIC\"], 1]};\n\n  hdr  = Style[#, Bold, fg, 12] & /@ {\"Model\", Superscript[\"R\", 2], Row[{\"adj. \", Superscript[\"R\", 2]}], \"RMSD\", \"k\", \"AIC\", \"BIC\"};\n  rows = {Prepend[gof[f3, 2], Style[\"3-state\", fg, 12]],\n          Prepend[gof[f4, 3], Style[\"4-state\", fg, 12]]};\n\n  Column[{\n    Style[Row[{\"Pooled fraction-folded fit \\[Dash] n = \", n, \" points (all electrodes, incl. 0 \\[Mu]M)\"}], fg, 11],\n    Grid[Prepend[rows, hdr],\n      Frame -> All, FrameStyle -> Directive[fg, Opacity[0.25]],\n      Alignment -> {{Left, Right, Right, Right, Center, Right, Right}, Center},\n      Spacings -> {1.7, 1.}, BaseStyle -> Directive[fg, 12, FontFamily -> \"Arial\"],\n      Background -> {None, {Directive[fg, Opacity[0.08]], None, None}}]\n  }, Spacings -> 0.9, Alignment -> Left]\n];\n\n(* favoured-model one-liner.  NonlinearModelFit emits FittedModel::constr for any\n   box-constrained fit; here KS, KD and NF all sit well inside their bounds, so the\n   AIC/BIC are valid \\[Dash] suppress the precautionary message for a clean readout. *)\nQuiet[\n  With[{f3 = fitResult[\"Model3\", \"FitObject\"], f4 = fitResult[\"Model4\", \"FitObject\"]},\n    Print[Style[Row[{\"\\[FilledSmallCircle] Lower AIC favours the \",\n      If[f4[\"AIC\"] < f3[\"AIC\"], \"4-state\", \"3-state\"], \" model (\\[CapitalDelta]AIC = \",\n      NumberForm[Abs[f4[\"AIC\"] - f3[\"AIC\"]], {5, 1}], \");  adj. \", Superscript[\"R\", 2], \" = \",\n      NumberForm[f3[\"AdjustedRSquared\"], {4, 3}], \" (3-state) vs \",\n      NumberForm[f4[\"AdjustedRSquared\"], {4, 3}], \" (4-state).\"}], 12]]],\n  FittedModel::constr];\n\nQuiet[gofTable[], FittedModel::constr]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzrhomv-kuximlj\" data-page-width-em=\"65\" data-latex-b64=\"XHRleHR7JFxidWxsZXQkIExvd2VyIEFJQyBmYXZvdXJzIHRoZSB9XHRleHR7NC1zdGF0ZX1cdGV4dHsgbW9kZWwgKCRcRGVsdGEkQUlDID0gfVx0ZXh0ezEwNy43fVx0ZXh0eyk7ICBhZGouIH1cdGV4dHtSfV4yXHRleHR7ID0gfVx0ZXh0ezAuOTczfVx0ZXh0eyAoMy1zdGF0ZSkgdnMgfVx0ZXh0ezAuOTk4fVx0ZXh0eyAoNC1zdGF0ZSkufQ==\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.1373em;vertical-align:-0.25em;\"></span><span class=\"mord text\"><span class=\"mord\">∙</span><span class=\"mord\"> Lower AIC favours the </span></span><span class=\"mord text\"><span class=\"mord\">4-state</span></span><span class=\"mord text\"><span class=\"mord\"> model (ΔAIC = </span></span><span class=\"mord text\"><span class=\"mord\">107.7</span></span><span class=\"mord text\"><span class=\"mord\">); adj. </span></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">R</span></span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8873em;\"><span style=\"top:-3.1362em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span><span class=\"mord text\"><span class=\"mord\"> = </span></span><span class=\"mord text\"><span class=\"mord\">0.973</span></span><span class=\"mord text\"><span class=\"mord\"> (3-state) vs </span></span><span class=\"mord text\"><span class=\"mord\">0.998</span></span><span class=\"mord text\"><span class=\"mord\"> (4-state).</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "a7d16efb-4370-4282-907d-4b078d158734"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"118457\" data-output-id=\"34\" data-out-n=\"211\" data-sub-idx=\"4\" data-output-format=\"SVGT\" data-output-is-graphics=\"0\" data-cell-idx=\"79\" data-sub-start=\"44\" data-sub-end=\"44\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[211]=</span></div><div class=\"wl-output-content\"><img class=\"vscode-wolfram-png-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_cmdupd8ujjxc.png\" src=\"img/EAB_DCT_analysis/wl_cmdupd8ujjxc.png\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "a8041dd4-2260-46fa-8351-2cb3558e7020"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5b. Equivalent-circuit (CPE) fits\n\nClassical equivalent-circuit comparison to the DCT inversion. Each concentration spectrum is fit to **Rs + [C_DL || (Rct + CPE)]** via `CPEFit`FitCPE`. The faradaic branch gives an apparent electron-transfer rate **k_et = 1/(Q·Rct)** (Q is the CPE coefficient, i.e. Y_CPE; an exact RC rate for n=1, a proxy otherwise). The plot shows k_et vs [vancomycin] per electrode.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Fit every concentration spectrum to  Rs + [Cdl || (Rct + CPE)] *)\ncpeResults = <|\"File\" -> #File,\n   \"Fit\" -> CPEFit`FitCPE[#Spec[\"FreqHz\"], #Spec[\"ZData\"]]|> & /@ concGoodSpecs;\n\n(* electron-transfer rate proxy  k_et = 1/(Q Rct)  per spectrum, by electrode\n   (drop 0 uM so it can go on a log concentration axis) *)\ncpeConcUM[lbl_] := ToExpression @ First[StringCases[lbl, d : NumberString ~~ \" \\[Mu]M\" :> d], \"0\"];\nketByElectrode = Table[\n  Module[{subs},\n    subs = Select[cpeResults, StringStartsQ[#File, e] &];\n    Select[Transpose[{cpeConcUM /@ subs[[All, \"File\"]],\n                      1./(#Fit[\"Q\"] #Fit[\"Rct\"]) & /@ subs}], First[#] > 0 &]],\n  {e, concElectrodes}];\n\nModule[{eCols, allC, allK, cR, kR},\n  eCols = Directive[ColorData[97][#], AbsoluteThickness[1.8]] & /@ Range[Length[concElectrodes]];\n  allC  = Flatten[ketByElectrode[[All, All, 1]]];\n  allK  = Flatten[ketByElectrode[[All, All, 2]]];\n  cR = MinMax[allC]; kR = MinMax[allK];\n  ListLinePlot[ketByElectrode,\n    ScalingFunctions -> {\"Log10\", \"Log10\"}, Joined -> False,\n    PlotMarkers -> {Automatic, 10}, PlotStyle -> eCols,\n    Frame -> True, Axes -> False, Background -> GrayLevel[0.12],\n    FrameStyle -> Directive[White, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLogTicks[kR[[1]], kR[[2]], White], None},\n                   {DCTPlots`ThemeLogTicks[cR[[1]], cR[[2]], White], None}},\n    FrameTicksStyle -> Directive[White, 12],\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, White],\n                   Style[\"k_et = 1/(Q R_ct)  (1/s)\", 14, White]},\n    ImageSize -> 540, AspectRatio -> 0.72, PlotRangePadding -> Scaled[0.06],\n    PlotLegends -> Placed[LineLegend[eCols, concElectrodes,\n      LabelStyle -> Directive[White, 12], Background -> GrayLevel[0.12],\n      LegendFunction -> (Framed[#, Background -> GrayLevel[0.12], FrameStyle -> Directive[White, AbsoluteThickness[1.1]]] &)], Right]]\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"118457\" data-output-id=\"25\" data-out-n=\"166\" data-sub-idx=\"5\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"81\" data-sub-start=\"14\" data-sub-end=\"34\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[166]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1klvbikut50yp.svg\" src=\"img/EAB_DCT_analysis/wl_1klvbikut50yp.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* Fit every concentration spectrum to  Rs + [Cdl || (Rct + CPE)] *)\ncpeResults = <|\"File\" -> #File,\n   \"Fit\" -> CPEFit`FitCPE[#Spec[\"FreqHz\"], #Spec[\"ZData\"]]|> & /@ concGoodSpecs;\n\n(* electron-transfer rate proxy  k_et = 1/(Q Rct)  per spectrum, by electrode\n   (drop 0 uM so it can go on a log concentration axis) *)\ncpeConcUM[lbl_] := ToExpression @ First[StringCases[lbl, d : NumberString ~~ \" \\[Mu]M\" :> d], \"0\"];\nketByElectrode = Table[\n  Module[{subs},\n    subs = Select[cpeResults, StringStartsQ[#File, e] &];\n    Select[Transpose[{cpeConcUM /@ subs[[All, \"File\"]],\n                      1./(#Fit[\"Q\"] #Fit[\"Rct\"]) & /@ subs}], First[#] > 0 &]],\n  {e, concElectrodes}];\n\nModule[{eCols, allC, allK, cR, kR},\n  eCols = Directive[ColorData[97][#], AbsoluteThickness[1.8]] & /@ Range[Length[concElectrodes]];\n  allC  = Flatten[ketByElectrode[[All, All, 1]]];\n  allK  = Flatten[ketByElectrode[[All, All, 2]]];\n  cR = MinMax[allC]; kR = MinMax[allK];\n  ListLinePlot[ketByElectrode,\n    ScalingFunctions -> {\"Log10\", \"Log10\"}, Joined -> False,\n    PlotMarkers -> {Automatic, 10}, PlotStyle -> eCols,\n    Frame -> True, Axes -> False, Background -> GrayLevel[0.12],\n    FrameStyle -> Directive[White, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLogTicks[kR[[1]], kR[[2]], White], None},\n                   {DCTPlots`ThemeLogTicks[cR[[1]], cR[[2]], White], None}},\n    FrameTicksStyle -> Directive[White, 12],\n    LabelStyle -> Directive[White, 14, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, White],\n                   Style[\"k_et = 1/(Q R_ct)  (1/s)\", 14, White]},\n    ImageSize -> 540, AspectRatio -> 0.72, PlotRangePadding -> Scaled[0.06],\n    PlotLegends -> Placed[LineLegend[eCols, concElectrodes,\n      LabelStyle -> Directive[White, 12], Background -> GrayLevel[0.12],\n      LegendFunction -> (Framed[#, Background -> GrayLevel[0.12], FrameStyle -> Directive[White, AbsoluteThickness[1.1]]] &)], Right]]\n]",
       "mime": "text/plain"
      }
     ],
     "id": "b4706625-27b4-4ce0-84ab-aec4ee2f9869"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* CPE-model reconstruction residuals, all concentration spectra overlaid\n   (directly comparable to the DCT residuals in 4a.4) *)\nDCTPlots`PlotResiduals[cpeResults[[All, \"Fit\"]]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"118457\" data-output-id=\"26\" data-out-n=\"167\" data-sub-idx=\"1\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"82\" data-sub-start=\"2\" data-sub-end=\"2\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[167]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_omr9bqnnsoe0.svg\" src=\"img/EAB_DCT_analysis/wl_omr9bqnnsoe0.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* CPE-model reconstruction residuals, all concentration spectra overlaid\n   (directly comparable to the DCT residuals in 4a.4) *)\nDCTPlots`PlotResiduals[cpeResults[[All, \"Fit\"]]]",
       "mime": "text/plain"
      }
     ],
     "id": "15569499-2048-48b4-afc5-da42b621bfa8"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5c. DCT vs CPE comparison\n\nDCT (regularised g(k) inversion, resolving two k-peaks) vs the CPE circuit (unregularised, 5 free parameters, a single faradaic relaxation) on the **same** concentration spectra. Below: per-spectrum R_s, C_dl, and reconstruction error from each method. The DCT minimises *misfit + λ·roughness* — it trades fit quality for a smooth physical distribution — so a slightly lower CPE residual is expected and is not by itself evidence the CPE is the better model.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* DCT (regularised g(k) inversion) vs CPE (5-param circuit), same spectra *)\ndctRelResid[s_] := Sqrt[Mean[Abs[(s[\"ZFit\"] - s[\"ZData\"]) / s[\"ZData\"]]^2]];\ndctR = dctRelResid[#[\"Spec\"]] & /@ concGoodSpecs;\ncpeR = #[\"Fit\"][\"RelResid\"] & /@ cpeResults;\n\nPrint[Style[Row[{\"Median reconstruction error:   DCT = \",\n   NumberForm[100 Median[dctR], {4, 2}], \" %      CPE = \",\n   NumberForm[100 Median[cpeR], {4, 2}], \" %\"}], 14, Bold]];\nPrint[Row[{\"CPE lower-error on \",\n   Count[Transpose[{dctR, cpeR}], {a_, b_} /; b < a], \" of \", Length[dctR], \" spectra.\"}]];\n\nGrid[Prepend[\n  MapThread[\n    {#1[\"File\"], #1[\"Spec\"][\"Rs\"], #2[\"Fit\"][\"Rs\"],\n     #1[\"Spec\"][\"C0\"] 1.*^9, #2[\"Fit\"][\"Cdl\"] 1.*^9,\n     100. dctRelResid[#1[\"Spec\"]], 100. #2[\"Fit\"][\"RelResid\"]} &,\n    {concGoodSpecs, cpeResults}] /. x_?NumericQ :> NumberForm[N[x], 4],\n  Style[#, Bold] & /@ {\"Spectrum\", \"Rs DCT\", \"Rs CPE\", \"Cdl DCT (nF)\", \"Cdl CPE (nF)\", \"resid DCT %\", \"resid CPE %\"}],\n  Frame -> All, Alignment -> {{Left, Right, Right, Right, Right, Right, Right}},\n  Spacings -> {1.2, 0.35}, BaseStyle -> 10]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzpu1w8-mgwqcbe\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhiZntcdGV4dHtNZWRpYW4gcmVjb25zdHJ1Y3Rpb24gZXJyb3I6ICAgRENUID0gfVx0ZXh0ezIuMTB9XHRleHR7IFwlICAgICAgQ1BFID0gfVx0ZXh0ezEuMjJ9XHRleHR7IFwlfX0=\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8056em;vertical-align:-0.0556em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">Median reconstruction error: DCT = </span></span><span class=\"mord text\"><span class=\"mord\">2.10</span></span><span class=\"mord text\"><span class=\"mord\"> % CPE = </span></span><span class=\"mord text\"><span class=\"mord\">1.22</span></span><span class=\"mord text\"><span class=\"mord\"> %</span></span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "c65b6b7d-2fb3-4904-82a6-795800375134"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzpu1wd-trrccwc\" data-page-width-em=\"52\" data-latex-b64=\"XHRleHR7Q1BFIGxvd2VyLWVycm9yIG9uIH0zOVx0ZXh0eyBvZiB9MzlcdGV4dHsgc3BlY3RyYS59\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">CPE lower-error on </span></span><span class=\"mord\">39</span><span class=\"mord text\"><span class=\"mord\"> of </span></span><span class=\"mord\">39</span><span class=\"mord text\"><span class=\"mord\"> spectra.</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "ef6bc2ca-1bce-4efc-8eeb-20a34eb21a19"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"118457\" data-output-id=\"27\" data-out-n=\"173\" data-sub-idx=\"6\" data-output-format=\"SVGT\" data-output-is-graphics=\"0\" data-cell-idx=\"84\" data-sub-start=\"11\" data-sub-end=\"19\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[173]=</span></div><div class=\"wl-output-content\"><img class=\"vscode-wolfram-png-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_634mgygzbroo.png\" src=\"img/EAB_DCT_analysis/wl_634mgygzbroo.png\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "779655ac-4b8f-418c-8ddb-316ddf4ecc2c"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5d. Two-relaxation model discrimination\n\nDoes the impedance actually require **two** faradaic relaxations? Each spectrum is refit to **Rs + [C_DL || (Rct1+CPE1) || (Rct2+CPE2)]** (`CPEFit`FitCPE2`) and compared to the single branch by a nested-model **F-test** (5 vs 8 parameters). If the second branch is real, the residual drops far beyond chance and two stable, distinct rates k_et = 1/(Q·Rct) emerge — one slow, one fast — whose amplitudes Y0 = Q redistribute with [vancomycin]. Spectra where a branch runs past the measurement band (k_et outside 5–3000 /s) are dropped as unresolved.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Refit each concentration spectrum with TWO faradaic branches and compare to\n   the single branch by an F-test (nested models, 5 vs 8 parameters). *)\ncpe2Conc[lbl_] := ToExpression @ First[StringCases[lbl, d : NumberString ~~ \" \\[Mu]M\" :> d], \"0\"];\n\n(* runCPE2: the two-branch (8-parameter) refit over every spectrum is slow\n   (minutes). Off by default; set True to run the fits + F-test + 5d plots/exports. *)\nrunCPE2 = False;\nIf[runCPE2,\ncpe2Results = <|\"Elec\" -> StringTake[#File, 2], \"Conc\" -> cpe2Conc[#File],\n   \"Fit1\" -> CPEFit`FitCPE[#Spec[\"FreqHz\"], #Spec[\"ZData\"]],\n   \"Fit2\" -> CPEFit`FitCPE2[#Spec[\"FreqHz\"], #Spec[\"ZData\"]]|> & /@ concGoodSpecs;\n(* keep spectra where both rates are resolvable within the band (5..3000 /s) *)\ncpe2Good = Select[cpe2Results, 5. < #Fit2[\"ket1\"] < 3000. && 5. < #Fit2[\"ket2\"] < 3000. &];\n\nModule[{fOf, fVals, df2},\n  fOf[r_] := Module[{n}, n = 2 Length[r[\"Fit1\"][\"FreqHz\"]];\n    ((r[\"Fit1\"][\"ChiSq\"] - r[\"Fit2\"][\"ChiSq\"]) / 3) / (r[\"Fit2\"][\"ChiSq\"] / (n - 8))];\n  fVals = fOf /@ cpe2Good;\n  df2 = 2 Length[concGoodSpecs[[1, \"Spec\"]][\"FreqHz\"]] - 8;\n  Print[Style[Row[{\"Median residual:   single-branch = \",\n     NumberForm[100 Median[#Fit1[\"RelResid\"] & /@ cpe2Good], {3, 2}], \" %       two-branch = \",\n     NumberForm[100 Median[#Fit2[\"RelResid\"] & /@ cpe2Good], {3, 2}], \" %\"}], Bold, 13]];\n  Print[Row[{\"Median F(3, \", df2, \") = \", NumberForm[Median[fVals], {6, 1}],\n     \"   vs  F_crit(p=0.001) \\[TildeEqual] \", NumberForm[Quantile[FRatioDistribution[3, df2], 0.999], {4, 1}],\n     \"   \\[Rule]  second relaxation justified in \", Length[cpe2Good], \"/\", Length[cpe2Results], \" spectra\"}]]\n];\n  ,\n  Print[Style[\"runCPE2 = False \\[Dash] skipping slow two-branch CPE fits (set True to run).\", Italic, GrayLevel[0.6]]]\n];\n\n(* theme-aware diagnostic plots: dark on screen, white in the export block *)\ncpe2Cols = {RGBColor[0.30, 0.45, 0.95], RGBColor[0.95, 0.55, 0.15]};\ncpe2Sty[fg_, bg_] := Sequence[Frame -> True, Axes -> False, Background -> bg, PlotTheme -> \"Default\",\n   FrameStyle -> Directive[fg, AbsoluteThickness[1.1]], FrameTicksStyle -> Directive[fg, 12],\n   LabelStyle -> Directive[fg, 14, FontFamily -> \"Arial\"], ImageSize -> 520, AspectRatio -> 0.7,\n   PlotRangePadding -> Scaled[0.05]];\n\ncpe2KetPlot[] := Module[{pub, fg, bg, slow, fast},\n  pub = (DCTPlots`$DCTTheme === \"Publication\"); fg = If[pub, Black, White]; bg = If[pub, White, GrayLevel[0.12]];\n  slow = {#Conc, #Fit2[\"ket1\"]} & /@ cpe2Good;  fast = {#Conc, #Fit2[\"ket2\"]} & /@ cpe2Good;\n  ListPlot[{slow, fast}, ScalingFunctions -> {None, \"Log10\"},\n    PlotStyle -> (Directive[#, PointSize[0.02]] & /@ cpe2Cols), cpe2Sty[fg, bg],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"k_et = 1/(Q R_ct)  (1/s)\", 14, fg]},\n    PlotLegends -> Placed[PointLegend[cpe2Cols, {\"slow\", \"fast\"}, LabelStyle -> Directive[fg, 12]], {0.82, 0.5}]]];\n\ncpe2Y0Plot[] := Module[{pub, fg, bg, slow, fast},\n  pub = (DCTPlots`$DCTTheme === \"Publication\"); fg = If[pub, Black, White]; bg = If[pub, White, GrayLevel[0.12]];\n  slow = {#Conc, #Fit2[\"Q1\"]} & /@ cpe2Good;  fast = {#Conc, #Fit2[\"Q2\"]} & /@ cpe2Good;\n  ListPlot[{slow, fast}, ScalingFunctions -> {None, \"Log10\"},\n    PlotStyle -> (Directive[#, PointSize[0.02]] & /@ cpe2Cols), cpe2Sty[fg, bg],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Y0 = Q  (S s^n)\", 14, fg]},\n    PlotLegends -> Placed[PointLegend[cpe2Cols, {\"slow\", \"fast\"}, LabelStyle -> Directive[fg, 12]], {0.82, 0.5}]]];\n\ncpe2RatioPlot[] := Module[{pub, fg, bg, elecs, eCols, byE},\n  pub = (DCTPlots`$DCTTheme === \"Publication\"); fg = If[pub, Black, White]; bg = If[pub, White, GrayLevel[0.12]];\n  elecs = concElectrodes; eCols = ColorData[97] /@ Range[Length[elecs]];\n  byE = Table[SortBy[{#Conc, #Fit2[\"Q2\"]/(#Fit2[\"Q1\"] + #Fit2[\"Q2\"])} & /@ Select[cpe2Good, #Elec === e &], First], {e, elecs}];\n  ListLinePlot[byE, Joined -> False, PlotMarkers -> {Automatic, 12},\n    PlotStyle -> (Directive[#, AbsoluteThickness[1.5]] & /@ eCols), cpe2Sty[fg, bg],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 14, fg], Style[\"Y0_fast / (Y0_fast + Y0_slow)\", 14, fg]},\n    PlotRange -> {Automatic, {0, 1}},\n    PlotLegends -> Placed[PointLegend[eCols, elecs, LabelStyle -> Directive[fg, 12]], Right]]];\n\n\"5d two-branch fits + plot functions defined\"",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mqzpu2fa-cf51evo\" data-page-width-em=\"52\" data-latex-b64=\"XG1hdGhpdHtcdGV4dGNvbG9yeyM5OTk5OTl9e1x0ZXh0e3J1bkNQRTIgPSBGYWxzZSDigJMgc2tpcHBpbmcgc2xvdyB0d28tYnJhbmNoIENQRSBmaXRzIChzZXQgVHJ1ZSB0byBydW4pLn19fQ==\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord text\" style=\"color:#999999;\"><span class=\"mord\" style=\"color:#999999;\">runCPE2 = False – skipping slow two-branch CPE fits (set True to run).</span></span></span></span></span></span></div></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "0d38985e-8295-4350-af2c-96b292ca4a20"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"118457\" data-output-id=\"28\" data-out-n=\"182\" data-sub-idx=\"11\" data-output-format=\"SVGT\" data-output-is-graphics=\"0\" data-cell-idx=\"86\" data-sub-start=\"63\" data-sub-end=\"63\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[182]=</span></div><div class=\"wl-output-content\"><img class=\"vscode-wolfram-png-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_xibpggdm3cx9.png\" src=\"img/EAB_DCT_analysis/wl_xibpggdm3cx9.png\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "02c9b8c9-0f22-4538-a242-0123029846d1"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 5d.1  electron-transfer rates: two stable, distinct bands vs [vancomycin] *)\ncpe2KetPlot[]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
