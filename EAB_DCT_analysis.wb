    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"23243\" data-output-id=\"66\" data-out-n=\"615\" data-sub-idx=\"29\" data-output-format=\"SVG\" data-output-is-graphics=\"1\" data-cell-idx=\"115\" data-sub-start=\"114\" data-sub-end=\"114\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[615]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\\\Users\\\\Bob Lansdorp\\\\Documents\\\\DCT\\\\img\\\\EAB_DCT_analysis\\\\wl_s98tynmhkf29.svg\" width=\"1605\" height=\"3399\" src=\"img/EAB_DCT_analysis/wl_s98tynmhkf29.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(* output: graphics *)\n(* 7.6  Combined summary: every swept parameter in one table and one figure, rows sorted\n   by folded-fraction elasticity so the largest effects are at the top. The first four\n   parameters come from the rate sweeps of 7.4 (which kept their spectra), the rest from\n   7.5; all three observables are recomputed from the stored spectra, each spectrum\n   integrated over its own gap-centred windows (peakWindows, 4a.6). *)\n\n(* bring the 7.4 cases into the common record format *)\ntoRec[c_]  := mkCase[c[\"Param\"], c[\"X\"], c[\"Label\"], c[\"Recs\"]];\nallCases   = Join[Map[toRec, #] & /@ rateAll, sensAll2];\nbaseXAll   = Join[baseX, baseX2];\n\n(* elasticity of any observable, given the curve function *)\nelastic2[case_, x0_, curveF_] := Module[{dX, b, c, ks},\n  dX = (case[\"X\"] - x0)/x0; If[Abs[dX] < 0.01, Return[Missing[]]];\n  b  = Association[Rule @@@ curveF[baseRec]]; c = Association[Rule @@@ curveF[case]];\n  ks = Intersection[Keys[b], Keys[c]]; If[ks === {}, Return[Missing[]]];\n  Mean[(c[#] - b[#])/b[#] & /@ ks]/dX];\nfmtS[s_] := If[s === {}, \"n/a\", NumberForm[Mean[s], {4, 3}]];\nfmtA[s_] := If[s === {}, \"n/a\", NumberForm[Mean[Abs[s]], {4, 3}]];\n\n(* the two cases immediately adjacent to the baseline: nearest below and nearest above.\n   S is then a central-difference local sensitivity at the baseline, not an average over\n   the whole sweep range (the far cases are still shown in the figure). *)\nadjacentCases[cases_, x0_] := Module[{below = Select[cases, #[\"X\"] < x0 &], above = Select[cases, #[\"X\"] > x0 &]},\n  Join[If[below === {}, {}, {Last[SortBy[below, #[\"X\"] &]]}],\n       If[above === {}, {}, {First[SortBy[above, #[\"X\"] &]]}]]];\n\nelastRow[param_] := Module[{cases, x0 = baseXAll[param], sf, s1, s2},\n  (* degenerate cases (ff pinned near 1) are flagged below and never used *)\n  cases = adjacentCases[Select[allCases[param], Min[ffCurveOf[#][[All, 2]]] <= 0.99 &], x0];\n  sf = DeleteMissing[elastic2[#, x0, ffCurveOf] & /@ cases];\n  s1 = DeleteMissing[elastic2[#, x0, slowCurve] & /@ cases];\n  s2 = DeleteMissing[elastic2[#, x0, fastCurve] & /@ cases];\n  <|\"Param\" -> param, \"Base\" -> x0, \"ff\" -> sf, \"slow\" -> s1, \"fast\" -> s2,\n    \"key\" -> If[sf === {}, 0., Mean[Abs[sf]]]|>];\nelastAll   = SortBy[elastRow /@ Keys[allCases], -#[\"key\"] &];\nparamOrder = #[\"Param\"] & /@ elastAll;\n\n(* one panel: parameter x observable; legend once per row, outside the fast panel *)\nsensPanelAll[param_, which_] := Module[{fg, bg, cases, n, cols, curveF, curves, base, allY, yLo, yHi, cMax, pad, yLab, leg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  cases  = allCases[param]; n = Length[cases];\n  cols   = Table[ColorData[\"Rainbow\"][u], {u, 0.05, 0.95, 0.9/Max[n - 1, 1]}];\n  curveF = Switch[which, \"ff\", ffCurveOf, \"slow\", slowCurve, \"fast\", fastCurve];\n  curves = curveF /@ cases; base = curveF[baseRec];\n  allY   = Cases[Flatten[Join[curves, {base}], 1], {_, y_?NumericQ} :> y];\n  If[which === \"ff\", {yLo, yHi} = {0., 1.},\n    {yLo, yHi} = If[allY === {}, {1., 10.}, MinMax[allY]];\n    pad = 0.08 (yHi - yLo); yLo = Max[0., yLo - pad]; yHi = yHi + pad];\n  cMax = Max[base[[All, 1]]];\n  yLab = Switch[which, \"ff\", \"Fraction folded\",\n    \"slow\", Row[{\"slow \\[LeftAngleBracket]k\\[RightAngleBracket] (\", Superscript[\"s\", -1], \")\"}],\n    \"fast\", Row[{\"fast \\[LeftAngleBracket]k\\[RightAngleBracket] (\", Superscript[\"s\", -1], \")\"}]];\n  leg = If[which === \"fast\",\n    Placed[LineLegend[Join[cols, {Directive[fg, Dashed]}], Join[#[\"Label\"] & /@ cases, {\"baseline\"}],\n      LabelStyle -> Directive[fg, 10]], Right], None];\n  ListLinePlot[Join[If[# === {}, {{0., Missing[]}}, #] & /@ curves, {base}],\n    PlotStyle -> Join[Directive[#, AbsoluteThickness[1.8]] & /@ cols, {Directive[fg, Dashed, AbsoluteThickness[2.4]]}],\n    PlotMarkers -> Join[ConstantArray[{\"\\[FilledCircle]\", 6}, n], {None}],\n    PlotTheme -> \"Default\", Frame -> True, Axes -> False, Background -> bg,\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[yLo, yHi, fg], None}, {DCTPlots`ThemeLinTicks[0., cMax 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 10], LabelStyle -> Directive[fg, 11, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 11, fg], Style[yLab, 11, fg]},\n    PlotLabel -> Style[param <> Switch[which, \"ff\", \",  ff\", \"slow\", \",  slow\", \"fast\", \",  fast\"], 11, fg, Bold],\n    PlotRange -> {{0, cMax 1.05}, {yLo, yHi}}, PlotRangePadding -> Scaled[0.03],\n    PlotLegends -> leg, ImageSize -> 340, AspectRatio -> 0.75]];\n\nsensFigureAll = Grid[Table[{sensPanelAll[p, \"ff\"], sensPanelAll[p, \"slow\"], sensPanelAll[p, \"fast\"]}, {p, paramOrder}],\n  Spacings -> {1, 1}];\n\n(* signed elasticities only; rows sorted by |S| of ff *)\nrowsAll = {#[\"Param\"], NumberForm[#[\"Base\"], 4], fmtS[#[\"ff\"]], fmtS[#[\"slow\"]], fmtS[#[\"fast\"]]} & /@ elastAll;\nsensTableAll = Framed[Grid[Prepend[rowsAll,\n    Style[#, Bold] & /@ {\"Parameter\", \"Baseline\", \"ff\", \"slow \\[LeftAngleBracket]k\\[RightAngleBracket]\", \"fast \\[LeftAngleBracket]k\\[RightAngleBracket]\"}],\n  ItemSize -> Full, Alignment -> {{Left, Right, Right, Right, Right}}, Dividers -> {None, {2 -> True}},\n  Spacings -> {2.5, 0.6}, Background -> White,\n  BaseStyle -> {FontFamily -> \"Arial\", FontSize -> 13, FontColor -> Black}],\n  Background -> White, FrameStyle -> GrayLevel[0.75], FrameMargins -> 12, RoundingRadius -> 4];\n\nPrint[Style[\"S = (% change in observable) / (% change in parameter), averaged over all concentrations, using only the two sweep cases adjacent to the baseline (one below, one above); signed; rows sorted by |S| of ff.\", 11, Italic]];\ndegenerateAll = Select[Flatten[Values[allCases]], Min[ffCurveOf[#][[All, 2]]] > 0.99 &];\nIf[degenerateAll =!= {},\n  Print[Style[\"Degenerate, excluded from the averages: \" <> StringRiffle[(#[\"Param\"] <> \" \" <> #[\"Label\"]) & /@ degenerateAll, \"; \"] <>\n    \"  (ff pinned near 1 because the slow window lies outside the fitted band).\", 11, Italic, Orange]]];\n(* publication version of the table: readable parameter names and spelled-out headers, no\n   footnote (the caption lives in the manuscript); exported to data/figures as sensitivity_table *)\nsensParamName = <|\"KK threshold\" -> \"Kramers-Kronig residual threshold\",\n   \"weightPower\" -> Row[{\"Weighting exponent \", Style[\"p\", Italic]}],\n   \"fMaxHz\" -> Row[{\"Upper frequency cutoff \", Subscript[Style[\"f\", Italic], \"max\"], \" (Hz)\"}],\n   \"fMinHz\" -> Row[{\"Lower frequency cutoff \", Subscript[Style[\"f\", Italic], \"min\"], \" (Hz)\"}],\n   \"lambdaND\" -> Row[{\"Regularization \", Subscript[\"\\[Lambda]\", \"ND\"]}],\n   \"BinsPerDecade\" -> \"Points per decade in k\",\n   \"TauMinFactor\" -> \"k-grid padding, high-k end\",\n   \"TauMaxFactor\" -> \"k-grid padding, low-k end\"|>;\n(* baseline values as a reader would write them: 10^-3, 2 %, 15, 2.512 *)\nsensBaseFmt[param_, x_] := Which[\n  param === \"lambdaND\", Superscript[10, Round[Log10[x]]],\n  param === \"KK threshold\", ToString[Round[100 x]] <> \" %\",\n  x == Round[x], ToString[Round[x]],\n  True, NumberForm[N[x], 4]];\nsensTablePub[] := Grid[{\n    {Grid[Prepend[{Lookup[sensParamName, #[\"Param\"], #[\"Param\"]], sensBaseFmt[#[\"Param\"], #[\"Base\"]],\n        fmtS[#[\"ff\"]], fmtS[#[\"slow\"]], fmtS[#[\"fast\"]]} & /@ elastAll,\n      Style[#, Bold] & /@ {\"Parameter\", \"Baseline\", \"Fast-mode capacitive fraction\",\n        \"Slow-mode \\[LeftAngleBracket]k\\[RightAngleBracket]\", \"Fast-mode \\[LeftAngleBracket]k\\[RightAngleBracket]\"}],\n      Alignment -> {{Left, Right, Right, Right, Right}}, Dividers -> {None, {2 -> Directive[Black, AbsoluteThickness[1]]}},\n      ItemSize -> {{23, 7, 14, 11, 11}}, Spacings -> {1.5, 0.7}]}},\n  Alignment -> Left, Spacings -> {0, 1.2}, Background -> White,\n  BaseStyle -> {FontFamily -> \"Arial\", FontSize -> 13, FontColor -> Black}];\nIf[TrueQ[exportFigure] && Length[DownValues[exportFig]] > 0,\n  exportFig[Framed[sensTablePub[], Background -> White, FrameStyle -> None, FrameMargins -> 12], \"sensitivity_table\"]];\n\nColumn[{sensTableAll, Spacer[10], sensFigureAll}]",
       "mime": "text/plain"
      }
     ],
     "id": "337a0bb8-e337-49de-a060-00e1b15fc448"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 7.7 Representative spectrum vs fMaxHz\nOne spectrum, Electrode B1 at 562 µM (the measured point closest to 500 µM), refit at each upper-frequency cutoff of the 7.2 sweep with every other parameter at baseline. The dashed line is the slow/fast split of `kPeakRanges`. This is the picture behind the fMaxHz row of 7.6: it shows directly how the cutoff redistributes capacitance between the two windows and moves the fast peak.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 7.7  Representative spectrum vs fMaxHz: Electrode B1 at 562 uM refit at each cutoff of the 7.2\n   sweep, all other parameters at baseline. Dashed line = the gap centre of the baseline\n   fit (effective cutoff fMaxEff), i.e. that spectrum's own slow/fast boundary from peakWindows.\n   Own variable name (repFileFMax): repFile belongs to section 1 and feeds the lambda sweep. *)\nrepFileFMax = First @ Select[FileNames[\"*.txt\", concentrationDir], concElec[#] == \"1\" && concUM[#] == 562 &];\nrepFMax = Table[<|\"File\" -> ToString[NumberForm[fm, {5, 1}]] <> \" Hz\",\n    \"Spec\" -> DCT`DCTSpectrum[repFileFMax, \"LambdaND\" -> lambdaND, \"FMinUse\" -> fMinHz, \"FMaxUse\" -> fm,\n      \"WeightPower\" -> weightPower, \"BinsPerDecade\" -> binsPerDecade,\n      \"TauMinFactor\" -> tauMinFactor, \"TauMaxFactor\" -> tauMaxFactor]|>, {fm, fMaxVals}];\n\n(* the numbers behind the picture *)\nPrint[Grid[Prepend[\n  Table[{c[\"File\"], NumberForm[peakWindows[c[\"Spec\"]][[1, 2]], {4, 1}], NumberForm[sensFF[c[\"Spec\"]], {4, 3}],\n         NumberForm[windowGeoMean[c[\"Spec\"], Sequence @@ peakWindows[c[\"Spec\"]][[1]]], {4, 1}],\n         NumberForm[windowGeoMean[c[\"Spec\"], Sequence @@ peakWindows[c[\"Spec\"]][[2]]], {4, 1}]}, {c, repFMax}],\n  Style[#, Bold] & /@ {\"fMaxHz\", \"gap centre (1/s)\", \"ff\", \"slow <k> (1/s)\", \"fast <k> (1/s)\"}],\n  Frame -> All, Alignment -> {{Left, Right, Right, Right, Right}}, Spacings -> {2, 0.6}]];\n\nDCTPlots`PlotGK[repFMax, Automatic, \"GScale\" -> 1*^9, ImageSize -> 720,\n  GridLines -> {{{peakWindows[repFMax[[First @ FirstPosition[fMaxVals, fMaxEff]]][\"Spec\"]][[1, 2]], Directive[Gray, Dashed]}}, None},\n  PlotLabel -> Style[\"Electrode B1, 562 \\[Mu]M:  g(k) vs upper frequency cutoff fMaxHz\", 14, Bold]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"64\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:7.24em;vertical-align:-3.35em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.89em;\"><span style=\"top:-5.85em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:7.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.35em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.85em;\"><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">fMaxHz</span></span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">251.2 Hz</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">316.2 Hz</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">398.1 Hz</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">501.2 Hz</span></span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\">