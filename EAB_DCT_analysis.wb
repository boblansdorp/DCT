       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"289054\" data-output-id=\"267\" data-out-n=\"1378\" data-sub-idx=\"1\" data-output-format=\"Auto\" data-output-is-graphics=\"1\" data-cell-idx=\"11\" data-sub-start=\"2\" data-sub-end=\"2\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1378]=</span></div><div class=\"wl-output-content\"><span class=\"vscode-wolfram-gfx-marker\" style=\"display:none;\"></span><img class=\"vscode-wolfram-svg-output\" data-wl-img=\"c:\\Users\\Bob Lansdorp\\Documents\\DCT\\img\\EAB_DCT_analysis\\wl_1r0isg7isvunc.svg\" src=\"img/EAB_DCT_analysis/wl_1r0isg7isvunc.svg\"/></div></div>",
       "mime": "x-application/wolfram-language-html"
