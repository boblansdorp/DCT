t:5.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:12em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-5.75em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.25em;\"><span style=\"top:-8.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord amsrm\">□</span></span></span></span><span style=\"top:-7.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">k_mid (1/s)</span></span></span></span><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">135.4</span></span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">125.4</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">107.5</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">85.4</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">85.4</span></span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">85.4</span></span></span></span><span style=\"top:1.19em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">85.4</span></span></span></span><span style=\"top:2.39em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">85.4</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:12em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-5.75em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.25em;\"><span style=\"top:-8.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">p = -1</span></span></span></span><span style=\"top:-7.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">ff</span></span></span></span><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">0.080</span></span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">0.086</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">0.142</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">0.428</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">0.491</span></span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">0.543</span></span></span></span><span style=\"top:1.19em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">0.590</span></span></span></span><span style=\"top:2.39em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">0.585</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:12em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-5.75em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.25em;\"><span style=\"top:-8.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord amsrm\">□</span></span></span></span><span style=\"top:-7.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">k_mid (1/s)</span></span></span></span><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">135.4</span></span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">135.4</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">125.4</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">92.2</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">85.4</span></span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">85.4</span></span></span></span><span style=\"top:1.19em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">85.4</span></span></span></span><span style=\"top:2.39em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">85.4</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:12em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-5.75em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-12.1em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-13.3em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-14.5em;\"><span class=\"pstrut\" style=\"height:8.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.75em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "a98204d8-51f4-47e6-b6d8-8165c9b18bbc"
    },
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"65\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.06em;vertical-align:-0.31em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">At p = 0, </span></span><span class=\"mord mathit\">4</span><span class=\"mord text\"><span class=\"mord\"> of the 39 spectra come out at ff = 1 exactly (the unweighted fit has collapsed the slow population, so the slow window is empty) and </span></span><span class=\"mord mathit\">2</span><span class=\"mord text\"><span class=\"mord\"> at ff = 0 exactly (the detector put the split above the single surviving peak). Those are what push the pooled p = 0 curve to </span></span><span class=\"mord text\"><span class=\"mord\">0.981</span></span><span class=\"mord text\"><span class=\"mord\"> at 1000 </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">M while Electrode B1 alone is </span></span><span class=\"mord text\"><span class=\"mord\">0.943</span></span><span class=\"mord text\"><span class=\"mord\">. Neither the baseline nor p = -1 produces a degenerate spectrum. Note also that k_mid falls as the weighting is removed, so part of the slow peak’s fast flank is counted as fast.</span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "c1e6d1b5-daf1-4441-b977-83332f9eac93"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 7.5 Additional parameters\nThe remaining `DCTSpectrum` options: fMinHz directly (grid points 2 below to 2 above), BinsPerDecade, and the tau-grid padding TauMinFactor / TauMaxFactor. The slow/fast windows are not swept because they are not fit parameters: each spectrum is split at the centre of its own gap (`peakWindows`, 4a.6). Presented in 7.6.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 7.5  Additional parameters. Every case keeps its spectra, so ff and both rates come\n   from one refit. The k windows are not swept: they are data-adaptive (peakWindows, 4a.6),\n   not fit parameters. *)\n\n(* refit all concentration files with an explicit option set *)\nsensFitConcOpts[o_Association] := Flatten[Table[\n  If[!StringQ[d[[1]]] || !DirectoryQ[d[[1]]], {},\n    Module[{files = SortBy[FileNames[\"*.txt\", d[[1]]], {concElec[#], concUM[#]} &]},\n      Table[Module[{spec},\n        spec = Quiet @ Check[DCT`DCTSpectrum[f,\n            \"LambdaND\" -> o[\"lam\"], \"FMinUse\" -> o[\"fMin\"], \"FMaxUse\" -> o[\"fMax\"],\n            \"WeightPower\" -> o[\"wp\"], \"BinsPerDecade\" -> o[\"bpd\"],\n            \"TauMinFactor\" -> o[\"tMin\"], \"TauMaxFactor\" -> o[\"tMax\"]], $Failed];\n        If[AssociationQ[spec], <|\"Conc\" -> N[concUM[f]], \"Spec\" -> spec|>, Nothing]],\n        {f, files}]]],\n  {d, {{concentrationDir, seriesOfDir[concentrationDir]}, {concentrationDir2, seriesOfDir[concentrationDir2]}}}], 1];\n\nbaseOpts = <|\"fMin\" -> fMinHz, \"fMax\" -> fMaxHz, \"lam\" -> lambdaND, \"wp\" -> weightPower,\n             \"bpd\" -> binsPerDecade, \"tMin\" -> tauMinFactor, \"tMax\" -> tauMaxFactor|>;\n\n(* a case record: parameter, its value X, a label, and the spectra *)\nmkCase[param_, x_, label_, recs_] := <|\"Param\" -> param, \"X\" -> x, \"Label\" -> label, \"Recs\" -> recs|>;\nrefitCase[param_, x_, label_, overrides_] :=\n  mkCase[param, x, label, sensFitConcOpts[Join[baseOpts, overrides]]];\n\nbaseRec = mkCase[\"baseline\", None, \"baseline\", rateBase[\"Recs\"]];\n\n(* observables from a case record; every spectrum uses its own gap-centred windows *)\nffCurveOf[c_] := SortBy[KeyValueMap[{#1, Mean[#2]} &,\n  GroupBy[{#Conc, sensFF[#Spec]} & /@ c[\"Recs\"], First -> Last]], First];\nslowCurve[c_] := rateCurve[c[\"Recs\"], 1];\nfastCurve[c_] := rateCurve[c[\"Recs\"], 2];\n\n(* --- refit sweeps --- *)\n(* lower cutoff: the fit keeps f >= fMinHz, so the effective cutoff is the smallest grid\n   point at or above it (here fMinHz is itself a grid point); sweep centred on that *)\nfMinEff   = Min[Select[concGrid, # >= fMinHz &]];\niMin      = First @ FirstPosition[concGrid, fMinEff];\nfMinVals  = concGrid[[Clip[iMin - 2, {1, Length[concGrid]}] ;; Clip[iMin + 2, {1, Length[concGrid]}]]];\ncasesFMin = Table[refitCase[\"fMinHz\", fm, ToString[NumberForm[fm, {4, 2}]] <> \" Hz\", <|\"fMin\" -> fm|>], {fm, fMinVals}];\nbpdVals   = {10, 15, 20, 30};\ncasesBPD  = Table[refitCase[\"BinsPerDecade\", b, ToString[b] <> \" /decade\", <|\"bpd\" -> b|>], {b, bpdVals}];\ntMinVals  = {0.03, 0.1, 0.3};\ncasesTMin = Table[refitCase[\"TauMinFactor\", t, ToString[t], <|\"tMin\" -> t|>], {t, tMinVals}];\ntMaxVals  = {3., 10., 30.};\ncasesTMax = Table[refitCase[\"TauMaxFactor\", t, ToString[t], <|\"tMax\" -> t|>], {t, tMaxVals}];\n\nsensAll2 = <|\"fMinHz\" -> casesFMin, \"BinsPerDecade\" -> casesBPD,\n             \"TauMinFactor\" -> casesTMin, \"TauMaxFactor\" -> casesTMax|>;\nbaseX2 = <|\"fMinHz\" -> fMinEff, \"BinsPerDecade\" -> binsPerDecade,\n           \"TauMinFactor\" -> tauMinFactor, \"TauMaxFactor\" -> tauMaxFactor|>;\nPrint[Style[\"Additional sweeps done: \" <> ToString[Total[Length /@ Values[sensAll2]]] <> \" cases, \" <>\n  ToString[Length[casesFMin] + Length[casesBPD] + Length[casesTMin] + Length[casesTMax]] <> \" refits.\", Bold, Darker[Green]]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-print-output\"><div class=\"wl-print-line\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"65\" data-latex-b64=\"XG1hdGhiZntcdGV4dGNvbG9yeyMwMGZmMDB9e1x0ZXh0e0FkZGl0aW9uYWwgc3dlZXBzIGRvbmU6IDE1IGNhc2VzLCAxNSByZWZpdHMufX19\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\" style=\"color:#00ff00;\"><span class=\"mord\" style=\"color:#00ff00;\">Additional sweeps done: 15 cases, 15 refits.</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Print: [formula]",
       "mime": "text/plain"
      }
     ],
     "id": "791a9aed-be09-4903-b21e-7ab1211141b4"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 7.6 Combined summary\nAll eight swept parameters in one elasticity table and one figure (rows = parameters, columns = folded fraction, slow rate, fast rate), sorted by the folded-fraction elasticity so the largest effects sit at the top. Scroll down the figure to compare.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* 7.6  Combined summary: every swept parameter in one table and one figure, rows sorted\n   by folded-fraction elasticity so the largest effects are at the top. The first four\n   parameters come from the rate sweeps of 7.4 (which kept their spectra), the rest from\n   7.5; all three observables are recomputed from the stored spectra, each spectrum\n   integrated over its own gap-centred windows (peakWindows, 4a.6). *)\n\n(* bring the 7.4 cases into the common record format *)\ntoRec[c_]  := mkCase[c[\"Param\"], c[\"X\"], c[\"Label\"], c[\"Recs\"]];\nallCases   = Join[Map[toRec, #] & /@ rateAll, sensAll2];\nbaseXAll   = Join[baseX, baseX2];\n\n(* elasticity of any observable, given the curve function *)\nelastic2[case_, x0_, curveF_] := Module[{dX, b, c, ks},\n  dX = (case[\"X\"] - x0)/x0; If[Abs[dX] < 0.01, Return[Missing[]]];\n  b  = Association[Rule @@@ curveF[baseRec]]; c = Association[Rule @@@ curveF[case]];\n  ks = Intersection[Keys[b], Keys[c]]; If[ks === {}, Return[Missing[]]];\n  Mean[(c[#] - b[#])/b[#] & /@ ks]/dX];\nfmtS[s_] := If[s === {}, \"n/a\", NumberForm[Mean[s], {4, 3}]];\nfmtA[s_] := If[s === {}, \"n/a\", NumberForm[Mean[Abs[s]], {4, 3}]];\n\n(* the two cases immediately adjacent to the baseline: nearest below and nearest above.\n   S is then a central-difference local sensitivity at the baseline, not an average over\n   the whole sweep range (the far cases are still shown in the figure). *)\nadjacentCases[cases_, x0_] := Module[{below = Select[cases, #[\"X\"] < x0 &], above = Select[cases, #[\"X\"] > x0 &]},\n  Join[If[below === {}, {}, {Last[SortBy[below, #[\"X\"] &]]}],\n       If[above === {}, {}, {First[SortBy[above, #[\"X\"] &]]}]]];\n\nelastRow[param_] := Module[{cases, x0 = baseXAll[param], sf, s1, s2},\n  (* degenerate cases (ff pinned near 1) are flagged below and never used *)\n  cases = adjacentCases[Select[allCases[param], Min[ffCurveOf[#][[All, 2]]] <= 0.99 &], x0];\n  sf = DeleteMissing[elastic2[#, x0, ffCurveOf] & /@ cases];\n  s1 = DeleteMissing[elastic2[#, x0, slowCurve] & /@ cases];\n  s2 = DeleteMissing[elastic2[#, x0, fastCurve] & /@ cases];\n  <|\"Param\" -> param, \"Base\" -> x0, \"ff\" -> sf, \"slow\" -> s1, \"fast\" -> s2,\n    \"key\" -> If[sf === {}, 0., Mean[Abs[sf]]]|>];\nelastAll   = SortBy[elastRow /@ Keys[allCases], -#[\"key\"] &];\nparamOrder = #[\"Param\"] & /@ elastAll;\n\n(* one panel: parameter x observable; legend once per row, outside the fast panel *)\nsensPanelAll[param_, which_] := Module[{fg, bg, cases, n, cols, curveF, curves, base, allY, yLo, yHi, cMax, pad, yLab, leg},\n  fg = If[DCTPlots`$DCTTheme === \"Publication\", Black, White];\n  bg = If[DCTPlots`$DCTTheme === \"Publication\", White, GrayLevel[0.12]];\n  cases  = allCases[param]; n = Length[cases];\n  cols   = Table[ColorData[\"Rainbow\"][u], {u, 0.05, 0.95, 0.9/Max[n - 1, 1]}];\n  curveF = Switch[which, \"ff\", ffCurveOf, \"slow\", slowCurve, \"fast\", fastCurve];\n  curves = curveF /@ cases; base = curveF[baseRec];\n  allY   = Cases[Flatten[Join[curves, {base}], 1], {_, y_?NumericQ} :> y];\n  If[which === \"ff\", {yLo, yHi} = {0., 1.},\n    {yLo, yHi} = If[allY === {}, {1., 10.}, MinMax[allY]];\n    pad = 0.08 (yHi - yLo); yLo = Max[0., yLo - pad]; yHi = yHi + pad];\n  cMax = Max[base[[All, 1]]];\n  yLab = Switch[which, \"ff\", \"Fraction folded\",\n    \"slow\", Row[{\"slow \\[LeftAngleBracket]k\\[RightAngleBracket] (\", Superscript[\"s\", -1], \")\"}],\n    \"fast\", Row[{\"fast \\[LeftAngleBracket]k\\[RightAngleBracket] (\", Superscript[\"s\", -1], \")\"}]];\n  leg = If[which === \"fast\",\n    Placed[LineLegend[Join[cols, {Directive[fg, Dashed]}], Join[#[\"Label\"] & /@ cases, {\"baseline\"}],\n      LabelStyle -> Directive[fg, 10]], Right], None];\n  ListLinePlot[Join[If[# === {}, {{0., Missing[]}}, #] & /@ curves, {base}],\n    PlotStyle -> Join[Directive[#, AbsoluteThickness[1.8]] & /@ cols, {Directive[fg, Dashed, AbsoluteThickness[2.4]]}],\n    PlotMarkers -> Join[ConstantArray[{\"\\[FilledCircle]\", 6}, n], {None}],\n    PlotTheme -> \"Default\", Frame -> True, Axes -> False, Background -> bg,\n    FrameStyle -> Directive[fg, AbsoluteThickness[1.1]],\n    FrameTicks -> {{DCTPlots`ThemeLinTicks[yLo, yHi, fg], None}, {DCTPlots`ThemeLinTicks[0., cMax 1.05, fg], None}},\n    FrameTicksStyle -> Directive[fg, 10], LabelStyle -> Directive[fg, 11, FontFamily -> \"Arial\"],\n    FrameLabel -> {Style[\"[Vancomycin] (\\[Mu]M)\", 11, fg], Style[yLab, 11, fg]},\n    PlotLabel -> Style[param <> Switch[which, \"ff\", \",  ff\", \"slow\", \",  slow\", \"fast\", \",  fast\"], 11, fg, Bold],\n    PlotRange -> {{0, cMax 1.05}, {yLo, yHi}}, PlotRangePadding -> Scaled[0.03],\n    PlotLegends -> leg, ImageSize -> 340, AspectRatio -> 0.75]];\n\nsensFigureAll = Grid[Table[{sensPanelAll[p, \"ff\"], sensPanelAll[p, \"slow\"], sensPanelAll[p, \"fast\"]}, {p, paramOrder}],\n  Spacings -> {1, 1}];\n\n(* signed elasticities only; rows sorted by |S| of ff *)\nrowsAll = {#[\"Param\"], NumberForm[#[\"Base\"], 4], fmtS[#[\"ff\"]], fmtS[#[\"slow\"]], fmtS[#[\"fast\"]]} & /@ elastAll;\nsensTableAll = Framed[Grid[Prepend[rowsAll,\n    Style[#, Bold] & /@ {\"Parameter\", \"Baseline\", \"ff\", \"slow \\[LeftAngleBracket]k\\[RightAngleBracket]\", \"fast \\[LeftAngleBracket]k\\[RightAngleBracket]\"}],\n  ItemSize -> Full, Alignment -> {{Left, Right, Right, Right, Right}}, Dividers -> {None, {2 -> True}},\n  Spacings -> {2.5, 0.6}, Background -> White,\n  BaseStyle -> {FontFamily -> \"Arial\", FontSize -> 13, FontColor -> Black}],\n  Background -> White, FrameStyle -> GrayLevel[0.75], FrameMargins -> 12, RoundingRadius -> 4];\n\nPrint[Style[\"S = (% change in observable) / (% change in parameter), averaged over all concentrations, using only the two sweep cases adjacent to the baseline (one below, one above); signed; rows sorted by |S| of ff.\", 11, Italic]];\ndegenerateAll = Select[Flatten[Values[allCases]], Min[ffCurveOf[#][[All, 2]]] > 0.99 &];\nIf[degenerateAll =!= {},\n  Print[Style[\"Degenerate, excluded from the averages: \" <> StringRiffle[(#[\"Param\"] <> \" \" <> #[\"Label\"]) & /@ degenerateAll, \"; \"] <>\n    \"  (ff pinned near 1 because the slow window lies outside the fitted band).\", 11, Italic, Orange]]];\n(* publication version of the table: readable parameter names and spelled-out headers, no\n   footnote (the caption lives in the manuscript); exported to data/figures as sensitivity_table *)\nsensParamName = <|\"KK threshold\" -> \"Kramers-Kronig residual threshold\",\n   \"weightPower\" -> Row[{\"Weighting exponent \", Style[\"p\", Italic]}],\n   \"fMaxHz\" -> Row[{\"Upper frequency cutoff \", Subscript[Style[\"f\", Italic], \"max\"], \" (Hz)\"}],\n   \"fMinHz\" -> Row[{\"Lower frequency cutoff \", Subscript[Style[\"f\", Italic], \"min\"], \" (Hz)\"}],\n   \"lambdaND\" -> Row[{\"Regularization \", Subscript[\"\\[Lambda]\", \"ND\"]}],\n   \"BinsPerDecade\" -> \"Points per decade in k\",\n   \"TauMinFactor\" -> \"k-grid padding, high-k end\",\n   \"TauMaxFactor\" -> \"k-grid padding, low-k end\"|>;\n(* baseline values as a reader would write them: 10^-3, 2 %, 15, 2.512 *)\nsensBaseFmt[param_, x_] := Which[\n  param === \"lambdaND\", Superscript[10, Round[Log10[x]]],\n  param === \"KK threshold\", ToString[Round[100 x]] <> \" %\",\n  x == Round[x], ToString[Round[x]],\n  True, NumberForm[N[x], 4]];\nsensTablePub[] := Grid[{\n    {Grid[Prepend[{Lookup[sensParamName, #[\"Param\"], #[\"Param\"]], sensBaseFmt[#[\"Param\"], #[\"Base\"]],\n        fmtS[#[\"ff\"]], fmtS[#[\"slow\"]], fmtS[#[\"fast\"]]} & /@ elastAll,\n      Style[#, Bold] & /@ {\"Parameter\", \"Baseline\", \"Fast-mode capacitive fraction\",\n        \"Slow-mode \\[LeftAngleBracket]k\\[RightAngleBracket]\", \"Fast-mode \\[LeftAngleBracket]k\\[RightAngleBracket]\"}],\n      Alignment -> {{Left, Right, Right, Right, Right}}, Dividers -> {None, {2 -> Directive[Black, AbsoluteThickness[1]]}},\n      ItemSize -> {{23, 7, 14, 11, 11}}, Spacings -> {1.5, 0.7}]}},\n  Alignment -> Left, Spacings -> {0, 1.2}, Background -> White,\n  BaseStyle -> {FontFamily -> \"Arial\", FontSize -> 13, FontColor -> Black}];\nIf[TrueQ[exportFigure] && Length[DownValues[exportFig]] > 0,\n  exportFig[Framed[sensTablePub[], Background -> White, FrameStyle -> None, FrameMargins -> 12], \"sensitivity_table\"]];\n\nColumn[{sensTableAll, Spacer[10], sensFigureAll}]",
   "languageId": "wolfram",
   "outputs": [
